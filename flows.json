        "order": 1,
        "width": 6,
        "height": 6,
        "format": "\n<style>\n  .scada-log-box {\n    padding: 10px;\n    background: #111827;\n    border-radius: 12px;\n    border: 1px solid #1f2937;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.4);\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  }\n  .log-table-container {\n    height: 195px;\n    overflow-y: auto;\n    background: #090d16;\n    border-radius: 8px;\n    border: 1px solid #1f2937;\n    margin: 8px 0;\n    padding: 4px 6px;\n  }\n  /* Custom sleek scrollbar */\n  .log-table-container::-webkit-scrollbar {\n    width: 6px;\n  }\n  .log-table-container::-webkit-scrollbar-track {\n    background: #0b0f19;\n  }\n  .log-table-container::-webkit-scrollbar-thumb {\n    background: #374151;\n    border-radius: 3px;\n  }\n  .log-entry {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    padding: 5px 6px;\n    border-bottom: 1px solid #1a2234;\n    font-size: 12px;\n    animation: fadeIn 0.3s ease;\n  }\n  @keyframes fadeIn {\n    from { opacity: 0; transform: translateY(-4px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n  .log-time {\n    color: #94a3b8;\n    font-family: monospace;\n    font-size: 11px;\n    min-width: 55px;\n  }\n  .log-tag {\n    padding: 2px 6px;\n    border-radius: 4px;\n    font-size: 10px;\n    font-weight: 700;\n    text-transform: uppercase;\n    min-width: 50px;\n    text-align: center;\n  }\n  .tag-success { background: #065f46; color: #a7f3d0; }\n  .tag-danger  { background: #881337; color: #fecdd3; }\n  .tag-warning { background: #78350f; color: #fde68a; }\n  .tag-primary { background: #1e3a8a; color: #bfdbfe; }\n  .tag-info    { background: #155e75; color: #a5f3fc; }\n  .log-text {\n    color: #e2e8f0;\n    flex: 1;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .log-actions {\n    display: flex;\n    gap: 8px;\n    margin-top: 6px;\n  }\n  .btn-csv {\n    flex: 1;\n    background: linear-gradient(135deg, #0284c7, #0369a1);\n    color: white;\n    border: none;\n    padding: 7px 12px;\n    border-radius: 6px;\n    font-weight: 600;\n    font-size: 12px;\n    cursor: pointer;\n    transition: all 0.2s;\n  }\n  .btn-csv:hover {\n    background: linear-gradient(135deg, #0369a1, #075985);\n    box-shadow: 0 0 10px rgba(2,132,199,0.5);\n  }\n  .btn-clear {\n    background: #374151;\n    color: #d1d5db;\n    border: none;\n    padding: 7px 12px;\n    border-radius: 6px;\n    font-size: 12px;\n    cursor: pointer;\n  }\n  .btn-clear:hover {\n    background: #4b5563;\n  }\n  .empty-log {\n    text-align: center;\n    color: #64748b;\n    padding: 30px 10px;\n    font-size: 12px;\n  }\n</style>\n\n<div class=\"scada-log-box\">\n  <div style=\"display: flex; justify-content: space-between; align-items: center; font-size: 13px; font-weight: 600; color: #38bdf8;\">\n    <span>📋 Nhật ký sự kiện thời gian thực</span>\n    <span style=\"font-size: 11px; color: #64748b;\">{{(msg.payload.events || []).length}} mục</span>\n  </div>\n\n  <div class=\"log-table-container\">\n    <div ng-if=\"!msg.payload.events || msg.payload.events.length === 0\" class=\"empty-log\">\n      Chưa có sự kiện nào. Hãy vận hành băng chuyền để ghi nhật ký!\n    </div>\n    <div class=\"log-entry\" ng-repeat=\"item in (msg.payload.events || []) track by $index\">\n      <span class=\"log-time\">{{item.time}}</span>\n      <span class=\"log-tag tag-{{item.tagType || 'info'}}\">{{item.tag}}</span>\n      <span class=\"log-text\" title=\"{{item.text}}\">{{item.text}}</span>\n    </div>\n  </div>\n\n  <div class=\"log-actions\">\n    <button class=\"btn-csv\" ng-click=\"downloadCSV()\">\n      📥 Xuất báo cáo (CSV / Excel)\n    </button>\n    <button class=\"btn-clear\" ng-click=\"clearLog()\" title=\"Xóa toàn bộ lịch sử\">\n      🗑️ Xóa log\n    </button>\n  </div>\n</div>\n\n<script>\n(function(scope) {\n  scope.downloadCSV = function() {\n    var events = (scope.msg && scope.msg.payload && scope.msg.payload.events) || [];\n    if (events.length === 0) {\n      alert('Chưa có dữ liệu nhật ký để xuất!');\n      return;\n    }\n    // Add UTF-8 BOM so Vietnamese displays correctly in Excel\n    var csvContent = '\\uFEFFThời gian,Phân loại,Nội dung chi tiết,SP Kim loại,Tổng sản phẩm\\r\\n';\n    for (var i = 0; i < events.length; i++) {\n      var e = events[i];\n      csvContent += '\"' + (e.time || '') + '\",\"' + \n                    (e.tag || '') + '\",\"' + \n                    (e.text || '').replace(/\"/g, '\"\"') + '\",\"' + \n                    (e.metal || 0) + '\",\"' + \n                    (e.total || 0) + '\"\\r\\n';\n    }\n    var blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });\n    var url = URL.createObjectURL(blob);\n    var a = document.createElement('a');\n    a.href = url;\n    var nowStr = new Date().toISOString().slice(0, 10);\n    a.download = 'BTLMMT_NhatKy_SanXuat_' + nowStr + '.csv';\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n    URL.revokeObjectURL(url);\n  };\n\n  scope.clearLog = function() {\n    scope.send({ topic: 'clear_log' });\n  };\n})(scope);\n</script>\n",
