    {
        "id": "a1b2c3d4e5f60004",
        "type": "ui_template",
        "z": "8db70ae311f732e1",
        "group": "a1b2c3d4e5f60001",
        "name": "Đèn tháp Andon & Âm thanh",
        "order": 1,
        "width": 6,
        "height": 6,
        "format": "\n<style>\n  /* Global SCADA Dark Improvements */\n  .scada-andon-box {\n    padding: 10px;\n    background: #111827;\n    border-radius: 12px;\n    border: 1px solid #1f2937;\n    box-shadow: 0 4px 15px rgba(0,0,0,0.4);\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;\n  }\n  .tower-container {\n    display: flex;\n    justify-content: center;\n    align-items: center;\n    gap: 16px;\n    margin: 15px 0;\n  }\n  .tower-stack {\n    display: flex;\n    flex-direction: column;\n    background: #030712;\n    padding: 8px 12px;\n    border-radius: 24px;\n    border: 2px solid #374151;\n    box-shadow: inset 0 2px 10px rgba(0,0,0,0.8);\n    gap: 8px;\n    align-items: center;\n  }\n  .light-lamp {\n    width: 38px;\n    height: 38px;\n    border-radius: 50%;\n    transition: all 0.25s ease;\n    border: 2px solid rgba(255,255,255,0.1);\n  }\n  /* RED LAMP */\n  .lamp-red {\n    background: #450a0a;\n    opacity: 0.3;\n  }\n  .lamp-red.active {\n    background: #ef4444;\n    opacity: 1;\n    box-shadow: 0 0 22px #ef4444, inset 0 0 8px #ffffff;\n  }\n  /* YELLOW LAMP */\n  .lamp-yellow {\n    background: #422006;\n    opacity: 0.3;\n  }\n  .lamp-yellow.active {\n    background: #eab308;\n    opacity: 1;\n    box-shadow: 0 0 28px #eab308, inset 0 0 8px #ffffff;\n    animation: lampBlink 0.5s infinite alternate;\n  }\n  /* GREEN LAMP */\n  .lamp-green {\n    background: #052e16;\n    opacity: 0.3;\n  }\n  .lamp-green.active {\n    background: #22c55e;\n    opacity: 1;\n    box-shadow: 0 0 22px #22c55e, inset 0 0 8px #ffffff;\n  }\n  @keyframes lampBlink {\n    from { opacity: 0.6; filter: brightness(0.8); }\n    to { opacity: 1; filter: brightness(1.4); }\n  }\n  .status-badge {\n    text-align: center;\n    padding: 8px 14px;\n    border-radius: 8px;\n    font-weight: 700;\n    font-size: 14px;\n    letter-spacing: 0.5px;\n    margin-bottom: 8px;\n    transition: all 0.3s ease;\n  }\n  .status-stopped {\n    background: rgba(239, 68, 68, 0.15);\n    color: #fca5a5;\n    border: 1px solid #ef4444;\n  }\n  .status-running {\n    background: rgba(34, 197, 94, 0.15);\n    color: #86efac;\n    border: 1px solid #22c55e;\n  }\n  .status-sorting {\n    background: rgba(234, 179, 8, 0.2);\n    color: #fef08a;\n    border: 1px solid #eab308;\n    animation: statusPulse 0.8s infinite alternate;\n  }\n  @keyframes statusPulse {\n    from { box-shadow: 0 0 5px rgba(234,179,8,0.3); }\n    to { box-shadow: 0 0 15px rgba(234,179,8,0.7); }\n  }\n  .sound-bar {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    background: #1f2937;\n    padding: 6px 12px;\n    border-radius: 6px;\n    font-size: 12px;\n    color: #9ca3af;\n  }\n  .sound-btn {\n    background: #374151;\n    color: #e5e7eb;\n    border: none;\n    padding: 3px 8px;\n    border-radius: 4px;\n    cursor: pointer;\n    font-size: 11px;\n  }\n  .sound-btn:hover {\n    background: #4b5563;\n  }\n</style>\n\n<div class=\"scada-andon-box\">\n  <div class=\"status-badge\" ng-class=\"{\n    'status-stopped': (!msg.payload || msg.payload.state === 'STOPPED'),\n    'status-running': (msg.payload && msg.payload.state === 'RUNNING'),\n    'status-sorting': (msg.payload && msg.payload.state === 'SORTING')\n  }\">\n    <span ng-if=\"!msg.payload || msg.payload.state === 'STOPPED'\">🔴 HỆ THỐNG: ĐANG DỪNG</span>\n    <span ng-if=\"msg.payload && msg.payload.state === 'RUNNING'\">🟢 HỆ THỐNG: ĐANG HOẠT ĐỘNG</span>\n    <span ng-if=\"msg.payload && msg.payload.state === 'SORTING'\">⚡ ĐANG PHÂN LOẠI KIM LOẠI</span>\n  </div>\n\n  <div class=\"tower-container\">\n    <div class=\"tower-stack\">\n      <div class=\"light-lamp lamp-red\" ng-class=\"{'active': (!msg.payload || msg.payload.state === 'STOPPED')}\" title=\"Đèn Đỏ: Dừng\"></div>\n      <div class=\"light-lamp lamp-yellow\" ng-class=\"{'active': (msg.payload && msg.payload.state === 'SORTING')}\" title=\"Đèn Vàng: Phân loại / Solenoid\"></div>\n      <div class=\"light-lamp lamp-green\" ng-class=\"{'active': (msg.payload && msg.payload.state === 'RUNNING')}\" title=\"Đèn Xanh: Hoạt động bình thường\"></div>\n    </div>\n    <div style=\"font-size: 12px; color: #9ca3af; line-height: 1.6;\">\n      <div><b style=\"color: #ef4444;\">Đỏ:</b> Băng chuyền dừng</div>\n      <div><b style=\"color: #eab308;\">Vàng:</b> Đang gạt Solenoid</div>\n      <div><b style=\"color: #22c55e;\">Xanh:</b> Vận hành bình thường</div>\n    </div>\n  </div>\n\n  <div class=\"sound-bar\">\n    <span>🔊 Âm thanh cảnh báo: <b ng-style=\"{'color': soundOn ? '#4ade80' : '#f87171'}\">{{soundOn ? 'BẬT' : 'TẮT'}}</b></span>\n    <div>\n      <button class=\"sound-btn\" ng-click=\"toggleSound()\">{{soundOn ? 'Tắt âm' : 'Bật âm'}}</button>\n      <button class=\"sound-btn\" ng-click=\"testChime()\" style=\"margin-left: 4px;\">Thử chuông</button>\n    </div>\n  </div>\n</div>\n\n<script>\n(function(scope) {\n  scope.soundOn = true;\n  var audioCtx = null;\n\n  function getAudioContext() {\n    if (!audioCtx) {\n      audioCtx = new (window.AudioContext || window.webkitAudioContext)();\n    }\n    if (audioCtx.state === 'suspended') {\n      audioCtx.resume();\n    }\n    return audioCtx;\n  }\n\n  function playTone(freq, type, duration, delay) {\n    if (!scope.soundOn) return;\n    try {\n      var ctx = getAudioContext();\n      var osc = ctx.createOscillator();\n      var gain = ctx.createGain();\n      var start = ctx.currentTime + (delay || 0);\n      osc.type = type || 'sine';\n      osc.frequency.setValueAtTime(freq, start);\n      gain.gain.setValueAtTime(0.12, start);\n      gain.gain.exponentialRampToValueAtTime(0.001, start + duration);\n      osc.connect(gain);\n      gain.connect(ctx.destination);\n      osc.start(start);\n      osc.stop(start + duration);\n    } catch(e) {}\n  }\n\n  scope.toggleSound = function() {\n    scope.soundOn = !scope.soundOn;\n  };\n\n  scope.testChime = function() {\n    playTone(880, 'sine', 0.12, 0);\n    playTone(1320, 'triangle', 0.22, 0.1);\n  };\n\n  scope.$watch('msg', function(val) {\n    if (val && val.payload && val.payload.soundTrigger) {\n      if (val.payload.soundTrigger === 'chime') {\n        playTone(880, 'sine', 0.12, 0);\n        playTone(1320, 'triangle', 0.22, 0.1);\n      } else if (val.payload.soundTrigger === 'beep') {\n        playTone(550, 'sine', 0.08, 0);\n      }\n    }\n  });\n})(scope);\n</script>\n",
