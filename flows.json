    {
        "id": "c8314e6b21da4320",
        "type": "function",
        "z": "8db70ae311f732e1",
        "name": "Bộ đếm & Lọc sườn lên",
        "func": "// Khởi tạo các biến nếu chưa có\nlet metalCount = flow.get('metalCount') || 0;\nlet totalCount = flow.get('totalCount') || 0;\nlet lastState = context.get('lastState') || false;\n\n// 1. Xử lý nút Reset\nif (msg.topic === \"reset\" || msg.payload === \"reset\") {\n    metalCount = 0;\n    totalCount = 0;\n    flow.set('metalCount', 0);\n    flow.set('totalCount', 0);\n    context.set('lastState', false);\n    return [\n        { payload: 0, topic: \"metal\" },     // Out 1: SP Kim loại\n        { payload: 0, topic: \"total\" },     // Out 2: Tổng sản phẩm\n        null                                // Out 3: Kích hoạt Solenoid\n    ];\n}\n\n// 2. Xử lý nút Giả lập SP Phi kim (Demo)\nif (msg.topic === \"non_metal\" || msg.payload === \"non_metal\") {\n    totalCount += 1;\n    flow.set('totalCount', totalCount);\n    return [\n        null,\n        { payload: totalCount, topic: \"total\" },\n        null\n    ];\n}\n\n// 3. Xử lý tín hiệu cảm biến IN1 hoặc nút test kim loại\nlet isMetal = false;\nif (Array.isArray(msg.payload)) {\n    isMetal = Boolean(msg.payload[0]);\n} else if (typeof msg.payload === \"boolean\") {\n    isMetal = msg.payload;\n}\n\n// Phát hiện sườn lên (Rising Edge: false -> true)\nif (isMetal && !lastState) {\n    context.set('lastState', true);\n    metalCount += 1;\n    totalCount += 1;\n    flow.set('metalCount', metalCount);\n    flow.set('totalCount', totalCount);\n    \n    return [\n        { payload: metalCount, topic: \"metal\" },   // Out 1: SP Kim loại\n        { payload: totalCount, topic: \"total\" },   // Out 2: Tổng sản phẩm\n        { payload: [true], topic: \"trigger\" }      // Out 3: Kích hoạt Solenoid\n    ];\n} else if (!isMetal) {\n    context.set('lastState', false);\n}\n\nreturn null;",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
