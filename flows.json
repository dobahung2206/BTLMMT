        "z": "8db70ae311f732e1",
        "name": "Quản lý Trạng thái & Nhật ký SCADA",
        "func": "// Quản lý Trạng thái & Nhật ký SCADA\nlet state = flow.get('scada_state') || 'STOPPED';\nlet statusText = flow.get('scada_statusText') || 'Hệ thống đang dừng';\nlet conveyorRunning = flow.get('conveyorRunning') || false;\nlet metalCount = flow.get('metalCount') || 0;\nlet totalCount = flow.get('totalCount') || 0;\nlet eventLog = flow.get('eventLog') || [];\n\nlet now = new Date();\nlet timeStr = now.toTimeString().split(' ')[0];\nlet soundTrigger = null;\n\nfunction addEvent(tag, tagType, text) {\n    eventLog.unshift({\n        time: timeStr,\n        tag: tag,\n        tagType: tagType,\n        text: text,\n        metal: flow.get('metalCount') || metalCount,\n        total: flow.get('totalCount') || totalCount\n    });\n    if (eventLog.length > 50) eventLog.pop();\n    flow.set('eventLog', eventLog);\n}\n\n// 1. Điều khiển Băng chuyền\nif (msg.topic === 'conveyor_cmd') {\n    let run = false;\n    if (Array.isArray(msg.payload)) run = Boolean(msg.payload[0]);\n    else run = Boolean(msg.payload);\n\n    if (run) {\n        conveyorRunning = true;\n        state = 'RUNNING';\n        statusText = 'Băng chuyền đang hoạt động';\n        soundTrigger = 'beep';\n        addEvent('START', 'success', 'Khởi động băng chuyền vận hành');\n    } else {\n        conveyorRunning = false;\n        state = 'STOPPED';\n        statusText = 'Băng chuyền đã dừng';\n        soundTrigger = 'beep';\n        addEvent('STOP', 'danger', 'Dừng băng chuyền an toàn');\n    }\n}\n\n// 2. Solenoid kích hoạt (Bật Solenoid qua node 440cbdde9bf30775)\nelse if (msg.topic === 'solenoid_on' || (msg.payload && msg.payload[0] === true && msg.adr === 1)) {\n    state = 'SORTING';\n    statusText = 'Đang kích hoạt van Solenoid gạt kim loại';\n    soundTrigger = 'chime';\n    addEvent('GẠT SP', 'warning', 'Kích hoạt Solenoid phân loại sản phẩm kim loại');\n}\n\n// 3. Solenoid thu hồi (node 9104baf60cd4e3aa đặt payload = false)\nelse if (msg.topic === 'solenoid_off' || msg.payload === false) {\n    state = conveyorRunning ? 'RUNNING' : 'STOPPED';\n    statusText = conveyorRunning ? 'Băng chuyền đang hoạt động' : 'Băng chuyền đã dừng';\n    addEvent('THU HỒI', 'info', 'Thu hồi xi-lanh Solenoid về vị trí chờ');\n}\n\n// 4. Sự kiện đếm Kim loại\nelse if (msg.topic === 'metal') {\n    metalCount = msg.payload;\n    if (metalCount > 0) {\n        state = 'SORTING';\n        statusText = 'Phát hiện sản phẩm kim loại #' + metalCount;\n        soundTrigger = 'chime';\n        addEvent('KIM LOẠI', 'warning', 'Cảm biến IN1 phát hiện SP kim loại #' + metalCount);\n    }\n}\n\n// 5. Sự kiện bấm Thêm SP Phi kim\nelse if (msg.topic === 'non_metal') {\n    totalCount = flow.get('totalCount') || 0;\n    soundTrigger = 'beep';\n    addEvent('PHI KIM', 'primary', 'Ghi nhận SP phi kim qua băng chuyền');\n}\n\n// 6. Sự kiện Reset\nelse if (msg.topic === 'reset') {\n    metalCount = 0;\n    totalCount = 0;\n    soundTrigger = 'beep';\n    addEvent('RESET', 'danger', 'Đã đặt lại toàn bộ bộ đếm sản phẩm về 0');\n}\n\n// 7. Lệnh xóa nhật ký từ UI\nelse if (msg.topic === 'clear_log') {\n    eventLog = [];\n    flow.set('eventLog', eventLog);\n    addEvent('DỌN DẸP', 'info', 'Đã xóa toàn bộ nhật ký vận hành');\n}\n\n// Lưu trạng thái\nflow.set('scada_state', state);\nflow.set('scada_statusText', statusText);\nflow.set('conveyorRunning', conveyorRunning);\n\nmsg.payload = {\n    state: state,\n    statusText: statusText,\n    conveyorRunning: conveyorRunning,\n    metalCount: flow.get('metalCount') || 0,\n    totalCount: flow.get('totalCount') || 0,\n    events: eventLog,\n    soundTrigger: soundTrigger,\n    time: timeStr\n};\n\nreturn msg;",
