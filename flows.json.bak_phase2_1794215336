nerText = \"🛑\";\n        solenoidText.innerText = \"NGẮT SOLENOID (LÒ XO VỀ)\";\n        btnToggle.className = \"px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 active:scale-95 text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-sky-500/20 transition flex items-center gap-2\";\n      } else {\n        targetAngle = -0.35;\n        solenoidIcon.innerText = \"⚡\";\n        solenoidText.innerText = \"BẬT SOLENOID (ĐẨY RA 40°)\";\n        btnToggle.className = \"px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-amber-500/20 transition flex items-center gap-2\";\n      }\n    });\n\n    let cycleTimers = [];\n    function runFourStrokeSolenoidSequence() {\n      // Clear any pending cycle timers\n      cycleTimers.forEach(clearTimeout);\n      cycleTimers = [];\n\n      // t = 2.0s: Bắt đầu duỗi lần 1 (giữ 2.0s)\n      cycleTimers.push(setTimeout(() => {\n        isSolenoidEnergized = true;\n        targetAngle = MAX_TILT;\n        solenoidIcon.innerText = \"🛑\";\n        solenoidText.innerText = \"NHỊP 1: DUỖI 2.0s\";\n        btnToggle.className = \"px-4 py-2.5 rounded-xl bg-sky-500 hover:bg-sky-400 active:scale-95 text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-sky-500/20 transition flex items-center gap-2\";\n      }, 2000));\n\n      // t = 4.0s (sau 2.0s): Dừng duỗi lần 1, nghỉ 1.7s\n      cycleTimers.push(setTimeout(() => {\n        isSolenoidEnergized = false;\n        targetAngle = -0.35;\n        solenoidIcon.innerText = \"⏸️\";\n        solenoidText.innerText = \"NGHỈ 1.7s (LẦN 1)\";\n        btnToggle.className = \"px-4 py-2.5 rounded-xl bg-slate-700 text-slate-300 font-bold text-xs tracking-wide transition flex items-center gap-2\";\n      }, 4000));\n\n      // t = 5.7s (sau 1.7s nghỉ): Duỗi lần 2 (0.5s)\n      cycleTimers.push(setTimeout(() => {\n        isSolenoidEnergized = true;\n        targetAngle = MAX_TILT;\n        solenoidIcon.inner