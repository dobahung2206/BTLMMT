r-color: var(--color-danger);\n    color: var(--color-danger);\n  }\n  .btn-cmd.danger:hover {\n    background: var(--color-danger);\n    color: #ffffff;\n  }\n  .btn-cmd.disabled {\n    opacity: 0.35 !important;\n    cursor: not-allowed !important;\n    background: var(--panel-elevated) !important;\n    border-color: var(--border-neutral) !important;\n    color: var(--text-muted) !important;\n    box-shadow: none !important;\n  }\n\n  /* Data Table */\n  .scada-table-wrap {\n    width: 100%;\n    overflow-x: auto;\n    border: 1px solid var(--border-neutral);\n    border-radius: 8px;\n    background: var(--panel-main);\n  }\n  .scada-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 10.5px;\n    font-family: var(--font-sans);\n    text-align: left;\n  }\n  .scada-table th {\n    background: var(--panel-secondary);\n    padding: 9px 12px;\n    color: var(--cyan-primary);\n    font-weight: 700;\n    font-family: var(--font-mono);\n    border-bottom: 1px solid var(--border-neutral);\n    white-space: nowrap;\n  }\n  .scada-table td {\n    padding: 8px 12px;\n    border-bottom: 1px solid rgba(30, 45, 68, 0.6);\n    color: var(--text-primary);\n  }\n  .scada-table tr:hover {\n    background: rgba(40, 184, 232, 0.06);\n  }\n\n  /* Toast Notification */\n  .toast-container {\n    position: fixed;\n    bottom: 20px;\n    right: 20px;\n    z-index: 999;\n    pointer-events: none;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .toast-item {\n    background: var(--panel-elevated);\n    border: 1px solid var(--cyan-primary);\n    color: var(--text-primary);\n    padding: 10px 16px;\n    border-radius: 8px;\n    box-shadow: var(--shadow-elevated);\n    font-size: 11px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    animation: toastPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n  @keyframes toastPop {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: 