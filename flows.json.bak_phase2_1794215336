ll=\"#475569\" stroke=\"#94a3b8\" stroke-width=\"2\"/>\n                  <text x=\"0\" y=\"3.5\" fill=\"#f8fafc\" font-size=\"6.5\" font-weight=\"800\" text-anchor=\"middle\" font-family=\"'Consolas', monospace\">Non-Fe</text>\n                </g>\n              </g>\n            </svg>\n\n            <div style=\"font-size: 8.5px; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-neutral); padding-top: 6px;\">\n              <span>💡 Nhấp vào <b>Cảm biến LJ12A3</b> hoặc <b>Cầu gạt Solenoid</b> để chuyển nhanh sang trang điều khiển chi tiết</span>\n              <div style=\"display: flex; gap: 6px;\">\n                <button class=\"btn-cmd primary\" style=\"padding: 3px 8px; font-size: 8px;\" ng-click=\"injectSimulationWorkpiece('Fe')\">⚡ Bơm phôi Fe</button>\n                <button class=\"btn-cmd warning\" style=\"padding: 3px 8px; font-size: 8px;\" ng-click=\"injectSimulationWorkpiece('Non-Fe')\">📦 Bơm phôi Non-Fe</button>\n              </div>\n            </div>\n          </div>\n\n          <!-- Cột phải: Panel Trạng thái thiết bị & Điều khiển nhanh -->\n          <div style=\"display: flex; flex-direction: column; gap: 12px;\">\n            <!-- Panel Trạng thái thiết bị -->\n            <div class=\"card-panel\" style=\"display: flex; flex-direction: column; justify-content: space-between;\">\n              <div>\n                <div class=\"section-header-row\" style=\"margin-bottom: 8px;\">\n                  <div class=\"section-title\" style=\"display: flex; justify-content: space-between; align-items: center; width: 100%;\">\n                    <div style=\"display: flex; align-items: center; gap: 7px;\">\n                      <span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\"/><line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\"/><line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\"/><line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\"/><line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\"/><line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\"/><line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\"/></svg></span>\n                      <span style=\"font-size: 13px; font-weight: 700;\">TRẠNG THÁI THIẾT BỊ</span>\n                    </div>\n                    <div style=\"font-size: 9.5px; font-weight: 600; color: var(--text-secondary); font-family: var(--font-mono);\">\n                      COM4 9600-8N1 • {{lastUpdateTime || '10:15:32'}}\n                    </div>\n                  </div>\n                </div>\n\n                <!-- Danh sách 3 thiết bị chính: Motor, Cảm biến, Solenoid -->\n                <div style=\"display: flex; flex-direction: column; gap: 8px;\">\n                  <!-- 1. Động cơ 24VDC -->\n                  <div style=\"background: var(--panel-secondary); border: 1px solid var(--border-neutral); border-radius: 8px; padding: 8px 10px;\">\n                    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                      <div>\n                        <div style=\"font-weight: 700; font-size: 11px; color: var(--text-primary); display: flex; align-items: center; gap: 6px;\">\n                          <span>Động cơ băng tải (24VDC)</span>\n                          <span class=\"status-dot-pulse\" ng-style=\"{'background-color': conveyorRunning ? 'var(--color-success)' : 'var(--text-muted)'}\" style=\"width: 6px; height: 6px;\"></span>\n                        </div>\n                        <div style=\"font-size: 9.5px; color: var(--text-secondary); font-family: var(--font-mono); margin-top: 2px;\">Coil 0x0000 • Relay Ch.1</div>\n                      </div>\n                      <div style=\"display: flex; gap: 5px; align-items: center;\">\n                        <span class=\"cmd-badge\" ng-class=\"conveyorRunning ? 'cmd-run' : 'cmd-stop'\" style=\"font-size: 9.5px; padding: 2px 7px; font-weight: 700;\">CMD: {{conveyorRunning ? 'RUN' : 'STOP'}}</span>\n                        <span class=\"status-pill\" ng-class=\"!modbusOnline ? 'offline' : (conveyorRunning ? 'online' : 'offline')\" style=\"font-size: 12px; padding: 3px 8px; font-weight: 800;\">\n                          {{!modbusOnline ? 'MẤT KẾT NỐI (STALE)' : (conveyorRunning ? 'ACT: RUN' : 'ACT: OFF')}}\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <!-- 2. Cảm biến LJ12A3 -->\n                  <div style=\"background: var(--panel-secondary); border: 1px solid var(--border-neutral); border-radius: 8px; padding: 8px 10px;\">\n                    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                      <div>\n                        <div style=\"font-weight: 700; font-size: 11px; color: var(--text-primary); display: flex; align-items: center; gap: 6px;\">\n                          <span>Cảm biến kim loại LJ12A3</span>\n                          <span class=\"status-dot-pulse\" ng-style=\"{'background-color': sensorActive ? 'var(--cyan-primary)' : 'var(--text-muted)'}\" style=\"width: 6px; height: 6px;\"></span>\n                        </div>\n                        <div style=\"font-size: 9.5px; color: var(--text-secondary); font-family: var(--font-mono); margin-top: 2px;\">DI 0x0001 (IN1) • NPN NO 24V</div>\n                      </div>\n                      <div style=\"display: flex; gap: 5px; align-items: center;\">\n                        <span class=\"status-pill\" ng-class=\"sensorActive ? 'online' : 'offline'\" style=\"font-size: 12px; padding: 3px 8px; font-weight: 800;\" ng-style=\"{'border-color': sensorActive ? 'var(--cyan-primary)' : 'var(--border-neutral)', 'color': sensorActive ? 'var(--cyan-primary)' : 'var(--text-muted)'}\">\n                          {{sensorActive ? 'PHÁT HIỆN [Fe]' : 'CHỜ PHÔI (IDLE)'}}\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <!-- 3. Solenoid Fe JF-0826B -->\n                  <div style=\"background: var(--panel-secondary); border: 1px solid var(--border-neutral); border-radius: 8px; padding: 8px 10px;\">\n                    <div style=\"display: flex; justify-content: space-between; align-items: center;\">\n                      <div>\n                        <div style=\"font-weight: 700; font-size: 11px; color: var(--text-primary); display: flex; align-items: center; gap: 6px;\">\n                          <span>Cơ cấu gạt Solenoid Fe</span>\n                          <span class=\"status-dot-pulse\" ng-style=\"{'background-color': solenoidActive ? 'var(--color-warning)' : 'var(--text-muted)'}\" style=\"width: 6px; height: 6px;\"></span>\n                        </div>\n                        <div style=\"font-size: 9.5px; color: var(--text-secondary); font-family: var(--font-mono); margin-top: 2px;\">Coil 0x0001 • JF-0826B • {{solenoidTemp.toFixed(1)}}°C</div>\n                      </div>\n                      <div style=\"display: flex; gap: 5px; align-items: center;\">\n                        <span class=\"cmd-badge\" ng-class=\"solenoidActive ? 'cmd-act' : 'cmd-stop'\" style=\"font-size: 9.5px; padding: 2px 7px; font-weight: 700;\">{{solenoidActive ? 'CMD: GẠT' : 'CMD: NGHỈ'}}</span>\n                        <span class=\"status-pill\" style=\"font-size: 12px; padding: 3px 8px; font-weight: 800;\" ng-style=\"{'background': solenoidActive ? 'rgba(242,184,75,0.15)' : 'transparent', 'color': solenoidActive ? 'var(--color-warning)' : 'var(--text-muted)', 'border': '1px solid ' + (solenoidActive ? 'var(--color-warning)' : 'var(--border-neutral)')}\">\n                          {{!modbusOnline ? 'MẤT KẾT NỐI (STALE)' : (solenoidActive ? 'ACT: 42°' : 'ACT: 0°')}}\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n\n                <!-- Cảnh báo dữ liệu cũ (Stale Data Banner khi mất kết nối) -->\n                <div ng-if=\"!modbusOnline\" style=\"margin-top: 8px; padding: 7px 10px; background: rgba(242, 184, 75, 0.12); border: 1px solid var(--color-warning); border-radius: 6px; font-size: 9.5px; color: var(--color-warning); display: flex; align-items: center; gap: 8px;\">\n                  <span style=\"flex-shrink: 0; display: flex; align-items: center;\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg></span>\n                  <span><b>CẢNH BÁO DỮ LIỆU CŨ (STALE DATA):</b> Mất tín hiệu Modbus RTU COM4 lúc <b>{{lastTelemetryTime || '---'}}</b>. Dữ liệu hiển thị từ bộ nhớ đệm (Cache), không phản ánh trạng thái thực tế.</span>\n                </div>\n              </div>\n\n              <!-- 3 Đồng hồ đếm thời gian công nghiệp (Motor Run, Machine Stop, Disconnect) -->\n              <div style=\"margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--border-neutral); display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; font-family: var(--font-mono); text-align: center;\">\n                <div style=\"background: var(--panel-secondary); padding: 5px 4px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                  <div style=\"font-size: 9.5px; color: var(--text-secondary); font-family: var(--font-sans); font-weight: 700; letter-spacing: 0.3px;\">CHẠY MOTOR</div>\n                  <div style=\"font-size: 12.5px; font-weight: 800; color: var(--color-success); margin-top: 2px;\">{{formatHMS(motorRunSeconds)}}</div>\n                </div>\n                <div style=\"background: var(--panel-secondary); padding: 5px 4px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                  <div style=\"font-size: 9.5px; color: var(--text-secondary); font-family: var(--font-sans); font-weight: 700; letter-spacing: 0.3px;\">DỪNG MÁY</div>\n                  <div style=\"font-size: 12.5px; font-weight: 800; color: var(--text-secondary); margin-top: 2px;\">{{formatHMS(machineStopSeconds)}}</div>\n                </div>\n                <div style=\"background: var(--panel-secondary); padding: 5px 4px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                  <div style=\"font-size: 9.5px; color: var(--text-secondary); font-family: var(--font-sans); font-weight: 700; letter-spacing: 0.3px;\">MẤT KẾT NỐI</div>\n                  <div style=\"font-size: 12.5px; font-weight: 800; margin-top: 2px;\" ng-style=\"{'color': modbusOnline ? 'var(--text-muted)' : 'var(--color-danger)'}\">\n                    {{modbusOnline ? '00:00:00' : formatHMS(disconnectSeconds)}}\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- Panel Điều khiển nhanh -->\n            <div class=\"card-panel\">\n              <div class=\"section-header-row\">\n                <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span><span>ĐIỀU KHIỂN NHANH</span></div>\n              </div>\n              <div style=\"display: flex; flex-direction: column; gap: 8px;\">\n                <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 6px;\">\n                  <button class=\"btn-cmd\" ng-class=\"conveyorRunning ? 'danger' : 'success'\" ng-click=\"toggleMotor()\" style=\"justify-content: center;\">\n                    <span ng-if=\"!conveyorRunning\" style=\"display: inline-flex; align-items: center; gap: 6px;\">\n                      <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><polygon points=\"5 3 19 12 5 21 5 3\"/></svg>\n                      <span>BẬT MOTOR</span>\n                    </span>\n                    <span ng-if=\"conveyorRunning\" style=\"display: inline-flex; align-items: center; gap: 6px;\">\n                      <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/></svg>\n                      <span>DỪNG MOTOR</span>\n                    </span>\n                  </button>\n                  <button class=\"btn-cmd warning\" ng-click=\"toggleMode()\" style=\"justify-content: center;\">\n                    <span ng-if=\"systemMode === 'AUTO'\" style=\"display: inline-flex; align-items: center; gap: 6px;\">\n                      <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 20V10M12 20V4M6 20v-6\"/></svg>\n                      <span>CHUYỂN THỦ CÔNG</span>\n                    </span>\n                    <span ng-if=\"systemMode !== 'AUTO'\" style=\"display: inline-flex; align-items: center; gap: 6px;\">\n                      <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg>\n                      <span>SANG TỰ ĐỘNG</span>\n                    </span>\n                  </button>\n                </div>\n                <button class=\"btn-cmd primary\" style=\"width: 100%; justify-content: center; gap: 6px;\" ng-click=\"switchTab('control')\">\n                  <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"6\" y1=\"3\" x2=\"6\" y2=\"15\"/><circle cx=\"18\" cy=\"6\" r=\"3\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><path d=\"M18 9a9 9 0 0 1-9 9\"/></svg>\n                  <span>MỞ TRUNG TÂM ĐIỀU KHIỂN CHI TIẾT</span>\n                  <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"7\" y1=\"17\" x2=\"17\" y2=\"7\"/><polyline points=\"7 7 17 7 17 17\"/></svg>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Hàng dưới: 3 Panel thông tin rút gọn -->\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px;\">\n          <!-- Biểu đồ nhỏ sản lượng gần đây -->\n          <div class=\"card-panel\" style=\"padding: 10px 14px;\">\n            <div class=\"section-header-row\" style=\"margin-bottom: 6px;\">\n              <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/></svg></span><span>HIỆU SUẤT 10 CHU KỲ</span></div>\n              <span style=\"font-size: 8px; color: var(--cyan-primary); cursor: pointer;\" ng-click=\"switchTab('monitoring', 'analytics')\">Chi tiết ↗</span>\n            </div>\n            <div style=\"height: 60px; display: flex; align-items: flex-end; gap: 4px; padding-top: 6px;\">\n              <div ng-repeat=\"bar in displayCycles track by $index\" style=\"flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center;\">\n                <div style=\"width: 100%; border-radius: 2px 2px 0 0; transition: height 0.3s ease, opacity 0.3s ease;\" ng-style=\"{'height': (bar.isReal ? bar.h : 0) + '%', 'opacity': bar.isReal ? 1 : 0, 'background': 'linear-gradient(180deg, var(--cyan-primary), #0284c7)'}\"></div>\n                <div ng-if=\"!bar.isReal\" style=\"width: 100%; height: 2px; background: rgba(255,255,255,0.08); margin-bottom: 1px;\"></div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Cảnh báo mới nhất (Đồng bộ nhiệt độ thực tế, KHÔNG phát sinh ALM-THRM-001 khi nhiệt < 45°C) -->\n          <div class=\"card-panel\" style=\"padding: 10px 14px;\">\n            <div class=\"section-header-row\" style=\"margin-bottom: 6px;\">\n              <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg></span><span>LỊCH SỬ 5 SỰ KIỆN GẦN NHẤT</span></div>\n              <a href=\"\" ng-click=\"switchTab('monitoring', 'alarms')\" style=\"font-size: 8px; color: var(--cyan-primary); text-decoration: none;\">Xem Alarms ({{unackAlarmsCount}}) ↗</a>\n            </div>\n            <!-- 5 Sự kiện gần nhất -->\n            <div style=\"display: flex; flex-direction: column; gap: 4px; font-size: 8.5px;\">\n              <div ng-repeat=\"evt in recentEvents | limitTo:5\" style=\"display: flex; justify-content: space-between; align-items: center; padding: 3px 6px; background: var(--panel-secondary); border-radius: 4px; border-left: 3px solid;\" ng-style=\"{'border-left-color': evt.type === 'danger' ? 'var(--color-danger)' : (evt.type === 'warn' ? 'var(--color-warning)' : 'var(--cyan-primary)')}\">\n                <div style=\"display: flex; align-items: center; gap: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\">\n                  <span style=\"font-family: var(--font-mono); color: var(--text-muted); font-size: 7.5px;\">{{evt.time}}</span>\n                  <span class=\"status-pill\" ng-class=\"evt.type === 'danger' ? 'danger' : (evt.type === 'warn' ? 'warning' : 'online')\" style=\"font-size: 7px; padding: 1px 4px;\">{{evt.cat}}</span>\n                  <span style=\"color: var(--text-primary); font-size: 8px;\">{{evt.text}}</span>\n                </div>\n                <span style=\"font-size: 7px; color: var(--text-muted); font-family: var(--font-mono);\">OK</span>\n              </div>\n            </div>\n          </div>\n\n                    <!-- Card 3: CẢNH BÁO ĐANG HOẠT ĐỘNG (ACTIVE ALARMS) -->\n          <div class=\"card-panel\" style=\"padding: 10px 14px;\">\n            <div class=\"section-header-row\" style=\"margin-bottom: 6px;\">\n              <div class=\"section-title\" style=\"display: flex; align-items: center; gap: 6px;\">\n                <span class=\"scada-icon\" style=\"color: var(--color-danger);\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/></svg></span>\n                <span>CẢNH BÁO ĐANG HOẠT ĐỘNG (ACTIVE ALARMS)</span>\n                <span class=\"nav-badge-pill badge-danger\" ng-if=\"unackAlarmsCount > 0\" style=\"margin-left: 4px; font-size: 7.5px;\">{{unackAlarmsCount}} CẦN XỬ LÝ</span>\n              </div>\n              <a href=\"javascript:void(0)\" ng-click=\"switchTab('monitoring', 'alarms')\" style=\"font-size: 8px; color: var(--cyan-primary); text-decoration: none; font-weight: 700;\">Xem tất cả ↗</a>\n            </div>\n\n            <!-- Khi không có cảnh báo nghiêm trọng -->\n            <div ng-if=\"unackAlarmsCount === 0\" style=\"display: flex; flex-direction: column; align-items: center; justify-content: center; height: 78px; gap: 4px; background: rgba(49, 214, 160, 0.03); border: 1px dashed rgba(49, 214, 160, 0.25); border-radius: 6px;\">\n              <div style=\"display: flex; align-items: center; gap: 6px; color: var(--color-success); font-weight: 800; font-size: 10px;\">\n                <svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n                <span>HỆ THỐNG HOẠT ĐỘNG BÌNH THƯỜNG</span>\n              </div>\n              <div style=\"font-size: 8px; color: var(--text-muted); font-family: var(--font-mono);\">\n                Tất cả thiết bị sẵn sàng • 0 cảnh báo tồn đọng\n              </div>\n            </div>\n\n            <!-- Khi có cảnh báo active -->\n            <div ng-if=\"unackAlarmsCount > 0\" style=\"display: flex; flex-direction: column; gap: 4px; max-height: 85px; overflow-y: auto;\">\n              <div ng-repeat=\"alm in alarmsList | filter:{active: true} | limitTo:3\" style=\"background: rgba(255, 91, 104, 0.08); border-left: 3px solid var(--color-danger); border-radius: 4px; padding: 4px 6px; display: flex; justify-content: space-between; align-items: center;\">\n                <div>\n                  <div style=\"display: flex; align-items: center; gap: 5px;\">\n                    <span class=\"cmd-badge cmd-stop\" style=\"font-size: 7px; padding: 1px 4px;\">{{alm.code}}</span>\n                    <span style=\"font-weight: 700; color: #fff; font-size: 8.5px;\">{{alm.desc}}</span>\n                  </div>\n                  <div style=\"font-size: 7.5px; color: var(--text-muted); margin-top: 1px;\">Khắc phục: {{alm.remedy}}</div>\n                </div>\n                <button class=\"btn-cmd warning\" style=\"padding: 2px 6px; font-size: 7.5px;\" ng-click=\"ackAlarm(alm)\">Xác nhận</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- ============================================================== -->\n      <!-- TAB 2: DEVICE CONTROL (TRUNG TÂM ĐIỀU KHIỂN THIẾT BỊ)          -->\n      <!-- ============================================================== -->\n      <div ng-show=\"activeTab === 'control'\">\n<div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;\">\n\n          <!-- Card 1: Điều khiển Motor 24VDC (Bố cục 2 cột: Nút START/STOP thống nhất + 4 trạng thái trực quan) -->\n          <div class=\"card-panel\">\n            <div class=\"section-header-row\">\n              <div class=\"section-title\">\n                <span class=\"section-title-icon\">\n                  <svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                    <circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M10 15l5-3-5-3v6z\"/>\n                  </svg>\n                </span>\n                <span>ĐIỀU KHIỂN ĐỘNG CƠ BĂNG TẢI (MOTOR 24V)</span>\n              </div>\n              <span class=\"status-pill\" ng-class=\"conveyorRunning ? 'online' : 'offline'\" style=\"font-size: 9px; padding: 2px 10px; font-weight: 700;\">\n                {{conveyorRunning ? 'RUNNING' : 'STOPPED'}}\n              </span>\n            </div>\n            <div style=\"font-size: 9.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">\n              Động cơ giảm tốc 24VDC kéo băng tải qua rulo chủ động • Khóa liên động tự ngắt an toàn khi E-STOP.\n            </div>\n\n            <div ng-if=\"isEstopTripped\" style=\"padding: 6px 12px; background: rgba(239,68,68,0.15); border: 1.5px solid var(--color-danger); border-radius: 6px; font-size: 9px; color: var(--color-danger); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;\">\n              <span style=\"font-size: 14px;\">⚠️</span>\n              <span><b>KHÓA LIÊN ĐỘNG AN TOÀN:</b> Đang kích hoạt E-STOP. Vui lòng mở khóa E-STOP trên thanh Topbar trước khi bật động cơ.</span>\n            </div>\n\n            <!-- BỐ CỤC 2 CỘT: BÊN TRÁI NÚT ĐIỀU KHIỂN NGANG DUY NHẤT - BÊN PHẢI 4 HÀNG TRẠNG THÁI LUCIDE -->\n            <div class=\"control-card-body\" style=\"display: grid; grid-template-columns: 1fr 1.25fr; gap: 14px; align-items: center;\">\n              <!-- Cột trái: Nút START / STOP dạng ngang, cân đối, icon bên trái, chữ giữa, mô tả dưới -->\n              <div style=\"display: flex; flex-direction: column; justify-content: center;\">\n                <button class=\"btn-cmd unified-motor-btn\"\n                        ng-click=\"toggleMotor()\"\n                        ng-disabled=\"isEstopTripped\"\n                        style=\"width: 100%; height: 68px; display: flex; align-items: center; justify-content: flex-start; padding: 0 18px; gap: 14px; border-radius: 8px; font-family: var(--font-sans); cursor: pointer; transition: all 0.25s ease-in-out; border: 2px solid; position: relative;\"\n                        ng-style=\"!conveyorRunning ? {\n                          'background': isEstopTripped ? 'rgba(39,197,139,0.06)' : 'linear-gradient(135deg, rgba(6,78,59,0.95), rgba(4,120,87,0.85))',\n                          'border-color': isEstopTripped ? '#164e63' : '#10b981',\n                          'color': isEstopTripped ? 'var(--text-muted)' : '#ffffff',\n                          'box-shadow': isEstopTripped ? 'none' : '0 4px 16px rgba(16,185,129,0.3)',\n                          'cursor': isEstopTripped ? 'not-allowed' : 'pointer'\n                        } : {\n                          'background': 'linear-gradient(135deg, rgba(127,29,29,0.95), rgba(153,27,27,0.85))',\n                          'border-color': '#ef4444',\n                          'color': '#ffffff',\n                          'box-shadow': '0 4px 16px rgba(239,68,68,0.35)',\n                          'cursor': 'pointer'\n                        }\">\n                  <!-- Icon bên trái (Play / Square Lucide style) -->\n                  <div style=\"flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 6px; background: rgba(0,0,0,0.28);\">\n                    <svg ng-if=\"!conveyorRunning\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                      <polygon points=\"6 4 20 12 6 20 6 4\"/>\n                    </svg>\n                    <svg ng-if=\"conveyorRunning\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n                      <rect x=\"5\" y=\"5\" width=\"14\" height=\"14\" rx=\"2\" ry=\"2\"/>\n                    </svg>\n                  </div>\n\n                  <!-- Chữ START / STOP ở giữa theo chiều ngang và dòng mô tả bên dưới -->\n                  <div style=\"flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;\">\n                    <span style=\"font-size: 18px; font-weight: 900; letter-spacing: 1.5px; line-height: 1.15;\">\n                      {{conveyorRunning ? 'STOP' : 'START'}}\n                    </span>\n                    <span style=\"font-size: 9.5px; font-weight: 700; opacity: 0.88; letter-spacing: 0.5px; margin-top: 3px;\">\n                      {{conveyorRunning ? 'DỪNG BĂNG TẢI' : (isEstopTripped ? 'KHÓA DO E-STOP' : 'KHỞI ĐỘNG BĂNG TẢI')}}\n                    </span>\n                  </div>\n\n                  <!-- Chấm LED trạng thái ở góc phải -->\n                  <div style=\"flex-shrink: 0; width: 10px; height: 10px; border-radius: 50%;\"\n                       ng-style=\"{'background-color': conveyorRunning ? '#ef4444' : '#10b981', 'box-shadow': conveyorRunning ? '0 0 8px #ef4444' : '0 0 8px #10b981'}\">\n                  </div>\n                </button>\n              </div>\n\n              <!-- Cột phải: 4 hàng trạng thái Lucide (Icon trái | Tên giữa | Giá trị lớn bên phải) -->\n              <div class=\"status-tiers-col\" style=\"display: flex; flex-direction: column; gap: 6px; background: var(--panel-secondary); padding: 8px 10px; border-radius: 8px; border: 1px solid var(--border-neutral); justify-content: space-between;\">\n                <!-- 1. COMMAND (Lucide radio-tower) -->\n                <div style=\"display: flex; align-items: center; justify-content: space-between; padding: 6px 10px; background: rgba(0,0,0,0.22); border-radius: 6px;\">\n                  <div style=\"display: flex; align-items: center; width: 22px; color: var(--cyan-primary); flex-shrink: 0;\">\n                    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                      <path d=\"M4.9 16.1C1 12.2 1 5.8 4.9 1.9\"/>\n                      <path d=\"M7.8 13.3c-2.4-2.4-2.4-6.2 0-8.6\"/>\n                      <circle cx=\"12\" cy=\"9\" r=\"2\"/>\n                      <path d=\"M16.2 4.7c2.4 2.4 2.4 6.2 0 8.6\"/>\n                      <path d=\"M19.1 1.9C23 5.8 23 12.2 19.1 16.1\"/>\n                      <path d=\"M12 11v11\"/>\n                      <path d=\"M8 22h8\"/>\n                    </svg>\n                  </div>\n                  <div style=\"font-size: 11px; font-weight: 700; color: var(--text-secondary); width: 105px; padding-left: 6px; flex-shrink: 0; letter-spacing: 0.5px;\">\n                    COMMAND\n                  </div>\n                  <div style=\"font-family: var(--font-mono); font-size: 13px; font-weight: 800; text-align: right; flex: 1; white-space: nowrap;\"\n                       ng-style=\"{'color': conveyorRunning ? 'var(--color-success)' : 'var(--text-muted)'}\">\n                    {{conveyorRunning ? 'COIL 0x0000 = 1 (START)' : 'COIL 0x0000 = 0 (STOP)'}}\n                  </div>\n                </div>\n\n                <!-- 2. FEEDBACK (Lucide activity) -->\n                <div style=\"display: flex; align-items: center; justify-content: space-between; padding: 6px 10px; background: rgba(0,0,0,0.22); border-radius: 6px;\">\n                  <div style=\"display: flex; align-items: center; width: 22px; color: var(--color-success); flex-shrink: 0;\">\n                    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                      <polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/>\n                    </svg>\n                  </div>\n                  <div style=\"font-size: 11px; font-weight: 700; color: var(--text-secondary); width: 105px; padding-left: 6px; flex-shrink: 0; letter-spacing: 0.5px;\">\n                    FEEDBACK\n                  </div>\n                  <div style=\"font-family: var(--font-mono); font-size: 13px; font-weight: 800; text-align: right; flex: 1; white-space: nowrap;\"\n                       ng-style=\"{'color': !modbusOnline ? 'var(--color-warning)' : (conveyorRunning ? 'var(--color-success)' : 'var(--text-muted)')}\">\n                    <span ng-if=\"!modbusOnline\" style=\"color: var(--color-warning); display: inline-flex; align-items: center; gap: 4px;\">\n                      <svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z\"/><line x1=\"12\" y1=\"9\" x2=\"12\" y2=\"13\"/><line x1=\"12\" y1=\"17\" x2=\"12.01\" y2=\"17\"/></svg>\n                      MẤT TÍN HIỆU (STALE)\n                    </span>\n                    <span ng-if=\"modbusOnline && conveyorRunning\">RUNNING (180 RPM)</span>\n                    <span ng-if=\"modbusOnline && !conveyorRunning\">STOPPED (ĐÃ NGẮT)</span>\n                  </div>\n                </div>\n\n                <!-- 3. ACTUAL STATE (Lucide settings) -->\n                <div style=\"display: flex; align-items: center; justify-content: space-between; padding: 6px 10px; background: rgba(0,0,0,0.22); border-radius: 6px;\">\n                  <div style=\"display: flex; align-items: center; width: 22px; color: var(--cyan-primary); flex-shrink: 0;\">\n                    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                      <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n                      <path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/>\n                    </svg>\n                  </div>\n                  <div style=\"font-size: 11px; font-weight: 700; color: var(--text-secondary); width: 105px; padding-left: 6px; flex-shrink: 0; letter-spacing: 0.5px;\">\n                    ACTUAL STATE\n                  </div>\n                  <div style=\"font-family: var(--font-mono); font-size: 13px; font-weight: 800; text-align: right; flex: 1; white-space: nowrap;\"\n                       ng-style=\"{'color': conveyorRunning ? 'var(--color-success)' : 'var(--text-muted)'}\">\n                    {{conveyorRunning ? 'Relay Ch.1 ĐÓNG (ENERGIZED)' : 'Relay Ch.1 MỞ (DE-ENERGIZED)'}}\n                  </div>\n                </div>\n\n                <!-- 4. INTERLOCK (Lucide shield-check) -->\n                <div style=\"display: flex; align-items: center; justify-content: space-between; padding: 6px 10px; background: rgba(0,0,0,0.22); border-radius: 6px;\">\n                  <div style=\"display: flex; align-items: center; width: 22px; flex-shrink: 0;\"\n                       ng-style=\"{'color': !isEstopTripped ? 'var(--color-success)' : 'var(--color-danger)'}\">\n                    <svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n                      <path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/>\n                      <polyline points=\"9 12 11 14 15 10\"/>\n                    </svg>\n                  </div>\n                  <div style=\"font-size: 11px; font-weight: 700; color: var(--text-secondary); width: 105px; padding-left: 6px; flex-shrink: 0; letter-spacing: 0.5px;\">\n                    INTERLOCK\n                  </div>\n                  <div style=\"font-family: var(--font-mono); font-size: 13px; font-weight: 800; text-align: right; flex: 1; white-space: nowrap;\"\n                       ng-style=\"{'color': !isEstopTripped ? 'var(--color-success)' : 'var(--color-danger)'}\">\n                    <span ng-if=\"!isEstopTripped\">✓ E-STOP PERMISSIVE</span>\n                    <span ng-if=\"isEstopTripped\">▲ BLOCKED: E-STOP TRIPPED</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Card 2: Chế độ vận hành (Operation Mode) -->\n          <div class=\"card-panel\">\n            <div class=\"section-header-row\">\n              <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 14.5L12 19l8-4.5\"/><path d=\"M4 9.5L12 14l8-4.5\"/><path d=\"M12 2L4 6.5l8 4.5 8-4.5L12 2z\"/></svg></span><span>CHẾ ĐỘ VẬN HÀNH (OPERATION MODE)</span></div>\n              <span class=\"mode-badge\" ng-class=\"systemMode === 'AUTO' ? 'auto' : 'manual'\">{{systemMode}}</span>\n            </div>\n            <div style=\"font-size: 9.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">\n              - <b>TỰ ĐỘNG (AUTO):</b> Cảm biến LJ12A3 tự động phát hiện phôi và kích hoạt chu kỳ gạt.<br>\n              - <b>THỦ CÔNG (MANUAL):</b> Cho phép kỹ sư kiểm tra thiết bị qua nút nhấn giữ Solenoid.\n            </div>\n\n            <div style=\"display: flex; gap: 10px; margin-bottom: 12px;\">\n              <button class=\"btn-cmd primary\" style=\"flex: 1; justify-content: center; padding: 12px;\" ng-click=\"setMode('AUTO')\" ng-class=\"{'disabled': systemMode === 'AUTO'}\">\n                <span>⚙ CHẾ ĐỘ TỰ ĐỘNG</span>\n              </button>\n              <button class=\"btn-cmd warning\" style=\"flex: 1; justify-content: center; padding: 12px;\" ng-click=\"setMode('MANUAL')\" ng-class=\"{'disabled': systemMode === 'MANUAL'}\">\n                <span>🖐 CHẾ ĐỘ THỦ CÔNG</span>\n              </button>\n            </div>\n\n            <div style=\"background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px; font-size: 8.5px; color: var(--color-warning);\">\n              <span>⚠ Chú ý: Ở chế độ TỰ ĐỘNG, các nút kích thử nghiệm Solenoid sẽ bị khóa để bảo đảm an toàn.</span>\n            </div>\n          </div>\n\n          <!-- Card 3: Điều khiển Solenoid (Bố cục 2 cột: Nút Dead-man lớn + 4 trạng thái trực quan, đã loại bỏ nút 0.8s) -->\n          <div class=\"card-panel\">\n            <div class=\"section-header-row\">\n              <div class=\"section-title\">\n                <span class=\"section-title-icon\">⚡</span>\n                <span>ĐIỀU KHIỂN CƠ CẤU GẠT SOLENOID (DEAD-MAN SWITCH)</span>\n              </div>\n              <span class=\"status-pill\" ng-class=\"solenoidActive ? 'online' : 'offline'\" style=\"font-size: 9px; padding: 2px 10px; font-weight: 700;\">\n                {{solenoidActive ? 'ACTIVE (42°)' : 'STANDBY (0°)'}}\n              </span>\n            </div>\n            <div style=\"font-size: 9.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">\n              Cơ cấu gạt Solenoid JF-0826B 12VDC • Nút Dead-man tự ngắt an toàn chống cháy cuộn dây sau 2.0s.\n            </div>\n\n            <!-- BỐ CỤC 2 CỘT: BÊN TRÁI NÚT DEAD-MAN SWITCH - BÊN PHẢI 4 HÀNG TRẠNG THÁI -->\n            <div class=\"control-card-body\" style=\"display: grid; grid-template-columns: 1fr 1.25fr; gap: 14px; align-items: stretch;\">\n              <!-- Cột trái: Nút Dead-man Switch lớn, icon tia sét, chữ NHẤN GIỮ ĐỂ GẠT / SOLENOID ACTIVE -->\n              <div style=\"display: flex; flex-direction: column; justify-content: center;\">\n                <button class=\"btn-cmd unified-solenoid-btn\"\n                        id=\"btn-control-deadman\"\n                        ng-disabled=\"systemMode !== 'MANUAL' || isEstopTripped || solenoidTemp >= 60\"\n                        ng-mousedown=\"onSolenoidPressDown($event)\"\n                        ng-mouseup=\"onSolenoidPressUp($event)\"\n                        ng-mouseleave=\"onSolenoidPressUp($event)\"\n                        style=\"width: 100%; height: 100%; min-height: 135px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; border-radius: 8px; font-family: var(--font-sans); transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); border: 2px solid; user-select: none;\"\n                        ng-style=\"systemMode !== 'MANUAL' || isEstopTripped || solenoidTemp >= 60 ? {\n                          'background': 'rgba(255,255,255,0.03)',\n                          'border-color': 'var(--border-neutral)',\n                          'color': 'var(--text-muted)',\n                          'cursor': 'not-allowed',\n                          'box-shadow': 'none'\n                        } : (solenoidHeld ? {\n                          'background': 'linear-gradient(135deg, rgba(239,68,68