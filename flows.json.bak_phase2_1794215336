(--text-muted); font-size: 7.5px; margin-top: 2px;\">Chu kỳ: 15 ngày</div>\n                <div style=\"color: var(--color-warning); font-weight: 800; margin-top: 4px;\">Còn 3 ngày (Sắp đến hạn)</div>\n              </div>\n              <div style=\"background: var(--panel-secondary); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                <div style=\"font-weight: 700; color: #fff;\">3. TRA DẦU KHỚP XOAY GẠT</div>\n                <div style=\"color: var(--text-muted); font-size: 7.5px; margin-top: 2px;\">Chu kỳ: 60 ngày</div>\n                <div style=\"color: var(--color-success); font-weight: 800; margin-top: 4px;\">Còn 28 ngày (Bình thường)</div>\n              </div>\n              <div style=\"background: var(--panel-secondary); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                <div style=\"font-weight: 700; color: #fff;\">4. XIẾT BULONG KHUNG NHÔM</div>\n                <div style=\"color: var(--text-muted); font-size: 7.5px; margin-top: 2px;\">Chu kỳ: 90 ngày</div>\n                <div style=\"color: var(--color-success); font-weight: 800; margin-top: 4px;\">Còn 54 ngày (Bình thường)</div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Bảng Audit Trail Log -->\n          <div class=\"scada-table-wrap\">\n            <table class=\"scada-table\">\n              <thead>\n                <tr>\n                  <th>THỜI GIAN</th>\n                  <th>NGƯỜI THAO TÁC</th>\n                  <th>LOẠI SỰ KIỆN</th>\n                  <th>NỘI DUNG THAO TÁC</th>\n                  <th>KẾT QUẢ</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr ng-repeat=\"log in auditLogs track by $index\">\n                  <td style=\"font-family: var(--font-mono);\">{{log.time}}</td>\n                  <td><b>{{log.actor}}</b></td>\n                  <td><span class=\"status-pill online\" style=\"font-size: 8px; padding: 1px 6px;\">{{log.category}}</span></td>\n                  <td>{{log.desc}}</td>\n                  <td style=\"color: var(--color-success); font-weight: 700;\">{{log.result}}</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n        </div>\n\n        <!-- KHU VỰC C: AUDIT TRAIL LOG -->\n        <div ng-show=\"systemSubTab === 'audit'\">\n<div class=\"card-panel\">\n            <div class=\"section-header-row\">\n              <div class=\"section-title\">\n                <span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/><polyline points=\"10 9 9 9 8 9\"/></svg></span>\n                <span>NHẬT KÝ TRUY VẾT THAO TÁC HỆ THỐNG (AUDIT TRAIL LOG)</span>\n              </div>\n              <button class=\"btn-cmd success\" style=\"padding: 4px 10px; font-size: 9px;\" ng-click=\"exportAuditCSV()\">\n                📥 XUẤT AUDIT LOG (CSV)\n              </button>\n            </div>\n            <div style=\"font-size: 9.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">\n              Ghi nhận toàn bộ thao tác điều khiển, can thiệp tham số, xóa số liệu và chuyển chế độ vận hành để phục vụ đánh giá an toàn công nghiệp và truy vết trách nhiệm.\n            </div>\n            <div style=\"max-height: 380px; overflow-y: auto;\">\n              <table class=\"scada-table\" style=\"width: 100%; font-size: 9.5px;\">\n                <thead>\n                  <tr>\n                    <th style=\"width: 110px;\">THỜI GIAN</th>\n                    <th style=\"width: 130px;\">NGƯỜI THỰC HIỆN</th>\n                    <th style=\"width: 120px;\">PHÂN LOẠI</th>\n                    <th>NỘI DUNG THAO TÁC</th>\n                    <th style=\"width: 120px; text-align: right;\">KẾT QUẢ</th>\n                  </tr>\n                </thead>\n                <tbody>\n                  <tr ng-repeat=\"log in auditLogs\">\n                    <td style=\"font-family: var(--font-mono); color: var(--cyan-primary);\">{{log.time}}</td>\n                    <td>\n                      <span class=\"status-pill\" ng-class=\"{'online': log.actor === 'Administrator', 'offline': log.actor === 'System'}\" style=\"font-size: 8px; padding: 1px 6px;\">\n                        {{log.actor}}\n                      </span>\n                    </td>\n                    <td>\n                      <span class=\"cmd-badge\" ng-class=\"{'cmd-run': log.category === 'MOTOR' || log.category === 'MODE', 'cmd-stop': log.category === 'SAFETY' || log.category === 'FACTORY_CLEAR'}\" style=\"font-size: 8px;\">\n                        {{log.category}}\n                      </span>\n                    </td>\n                    <td style=\"color: #fff; font-weight: 500;\">{{log.desc}}</td>\n                    <td style=\"text-align: right; font-weight: 700;\" ng-style=\"{'color': log.result === 'Thành công' || log.result === 'Hoàn tất' || log.result === 'Đã đồng bộ' ? 'var(--color-success)' : 'var(--color-warning)'}\">\n                      {{log.result}}\n                    </td>\n                  </tr>\n                </tbody>\n              </table>\n            </div>\n          </div>\n        </div>\n      </div>\n</main>\n  </div>\n\n  \n  <!-- ============================================================== -->\n  <!-- MODAL: MODBUS FRAME INSPECTOR                                  -->\n  <!-- ============================================================== -->\n  <div class=\"scada-dialog-backdrop\" ng-if=\"selectedPacket\" ng-click=\"closePacketModal()\">\n    <div class=\"scada-dialog-box\" style=\"width: 580px; max-width: 95vw;\" ng-click=\"$event.stopPropagation()\">\n      <div class=\"dialog-top\" style=\"background: linear-gradient(90deg, #0d1a38, #070d18); border-bottom: 1px solid var(--border-neutral);\">\n        <div style=\"display: flex; align-items: center; gap: 8px;\">\n          <span style=\"color: var(--cyan-primary); font-size: 13px;\">📡</span>\n          <span style=\"font-weight: 800; color: #ffffff; letter-spacing: 0.5px;\">CHI TIẾT GÓI TIN MODBUS RTU (FRAME INSPECTOR)</span>\n        </div>\n        <button style=\"background: rgba(255,91,104,0.2); border: 1px solid var(--color-danger); color: #fff; width: 24px; height: 24px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-weight: 900;\" ng-click=\"closePacketModal()\">✕</button>\n      </div>\n\n      <div class=\"dialog-body\" style=\"padding: 16px; background: #081022; display: flex; flex-direction: column; gap: 12px; font-size: 10px;\">\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;\">\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">THỜI GIAN (TIMESTAMP)</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 700; color: #ffffff; margin-top: 2px;\">{{selectedPacket.time}}</div>\n          </div>\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">HƯỚNG TRUYỀN (DIR)</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 800; margin-top: 2px;\" ng-style=\"{'color': selectedPacket.dir === 'TX' ? 'var(--cyan-primary)' : 'var(--color-success)'}\">\n              [{{selectedPacket.dir}}] {{selectedPacket.dir === 'TX' ? 'Master -> Slave' : 'Slave -> Master'}}\n            </div>\n          </div>\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">KẾT QUẢ GIAO DỊCH</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 800; color: var(--color-success); margin-top: 2px;\">{{selectedPacket.status || 'OK [CRC Valid]'}}</div>\n          </div>\n        </div>\n\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px;\">\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">SLAVE ID (TRẠM THIẾT BỊ)</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 700; color: #ffffff; margin-top: 2px;\">0x{{selectedPacket.slaveId || 'FF'}} (ESP8266 COM4)</div>\n          </div>\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">FUNCTION CODE (FC)</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 700; color: var(--cyan-primary); margin-top: 2px;\">{{selectedPacket.fc}}</div>\n          </div>\n        </div>\n\n        <div style=\"background: var(--panel-secondary); padding: 10px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n          <div style=\"color: var(--text-muted); font-size: 8px; margin-bottom: 4px;\">FRAME HEX / PAYLOAD GIẢI MÃ</div>\n          <div style=\"font-family: var(--font-mono); font-weight: 700; color: #38bdf8; word-break: break-all; background: #040812; padding: 8px; border-radius: 4px; border: 1px solid rgba(56,189,248,0.2);\">\n            {{selectedPacket.data || selectedPacket.hex}}\n          </div>\n        </div>\n\n        <div style=\"display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-neutral); padding-top: 10px;\">\n          <span style=\"font-size: 8.5px; color: var(--text-muted); font-family: var(--font-mono);\">Cấu hình: COM4 • Baud 9600-8N1 • CRC16-Modbus</span>\n          <button class=\"btn-cmd primary\" ng-click=\"closePacketModal()\" style=\"padding: 5px 16px; font-size: 9.5px;\">Đóng</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ============================================================== -->\n  <!-- MODAL: ALARM DETAIL INSPECTOR                                  -->\n  <!-- ============================================================== -->\n  <div class=\"scada-dialog-backdrop\" ng-if=\"selectedAlarm\" ng-click=\"closeAlarmModal()\">\n    <div class=\"scada-dialog-box\" style=\"width: 580px; max-width: 95vw;\" ng-click=\"$event.stopPropagation()\">\n      <div class=\"dialog-top\" style=\"background: linear-gradient(90deg, #240a12, #070d18); border-bottom: 1px solid var(--border-neutral);\">\n        <div style=\"display: flex; align-items: center; gap: 8px;\">\n          <span style=\"color: var(--color-danger); font-size: 13px;\">🚨</span>\n          <span style=\"font-weight: 800; color: #ffffff; letter-spacing: 0.5px;\">CHI TIẾT CẢNH BÁO: {{selectedAlarm.code}}</span>\n        </div>\n        <button style=\"background: rgba(255,91,104,0.2); border: 1px solid var(--color-danger); color: #fff; width: 24px; height: 24px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-weight: 900;\" ng-click=\"closeAlarmModal()\">✕</button>\n      </div>\n\n      <div class=\"dialog-body\" style=\"padding: 16px; background: #081022; display: flex; flex-direction: column; gap: 12px; font-size: 10px;\">\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;\">\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">MÃ SỰ KIỆN</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 800; color: var(--cyan-primary); margin-top: 2px;\">{{selectedAlarm.code}}</div>\n          </div>\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">MỨC ĐỘ NGUY HIỂM</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 800; margin-top: 2px;\" ng-style=\"{'color': selectedAlarm.level === 'CRITICAL' ? 'var(--color-danger)' : 'var(--color-warning)'}\">\n              {{selectedAlarm.level}}\n            </div>\n          </div>\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">THỜI ĐIỂM XẢY RA</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 700; color: #ffffff; margin-top: 2px;\">{{selectedAlarm.time}}</div>\n          </div>\n        </div>\n\n        <div style=\"background: var(--panel-secondary); padding: 10px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n          <div style=\"color: var(--text-muted); font-size: 8px; margin-bottom: 4px;\">NỘI DUNG MÔ TẢ</div>\n          <div style=\"font-weight: 700; color: #ffffff; line-height: 1.4;\">{{selectedAlarm.desc}}</div>\n        </div>\n\n        <div style=\"background: rgba(246,185,75,0.08); padding: 10px; border-radius: 6px; border: 1px solid rgba(246,185,75,0.3);\">\n          <div style=\"color: var(--color-warning); font-size: 8px; font-weight: 800; margin-bottom: 4px;\">HƯỚNG DẪN XỬ LÝ SỰ CỐ (REMEDY ACTION)</div>\n          <div style=\"color: #e2e8f0; line-height: 1.4;\">{{selectedAlarm.remedy}}</div>\n        </div>\n\n        <div style=\"display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-neutral); padding-top: 10px;\">\n          <div>\n            <span style=\"font-size: 8.5px; color: var(--text-muted);\">Trạng thái: </span>\n            <b ng-style=\"{'color': selectedAlarm.active ? 'var(--color-danger)' : 'var(--color-success)'}\">{{selectedAlarm.active ? 'ACTIVE (Đang diễn ra)' : 'CLEARED (Đã an toàn)'}}</b>\n          </div>\n          <div style=\"display: flex; gap: 8px;\">\n            <button class=\"btn-cmd warning\" ng-if=\"!selectedAlarm.ack\" ng-click=\"ackAlarm(selectedAlarm); closeAlarmModal()\" style=\"padding: 5px 12px; font-size: 9.5px;\">XÁC NHẬN (ACK)</button>\n            <button class=\"btn-cmd primary\" ng-click=\"closeAlarmModal()\" style=\"padding: 5px 16px; font-size: 9.5px;\">Đóng</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- TOAST NOTIFICATION -->\n  <div class=\"toast-container\" ng-if=\"toastMsg\">\n    <div class=\"toast-item\">\n      <span><svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg></span>\n      <span>{{toastMsg}}</span>\n    </div>\n  </div>\n\n  <!-- MODAL: FACTORY CLEAR BẢO MẬT 2-BƯỚC VỚI MÃ PIN & CHECKLIST -->\n  <div class=\"scada-dialog-backdrop\" ng-if=\"showConfirmDialog\" ng-click=\"closeFactoryClearModal()\">\n    <div class=\"scada-dialog-box\" style=\"width: 500px;\" ng-click=\"$event.stopPropagation()\">\n      <div class=\"dialog-top\" style=\"background: linear-gradient(90deg, #380a10, #070d18); border-bottom: 1px solid var(--color-danger);\">\n        <div style=\"display: flex; align-items: center; gap: 8px;\">\n          <span style=\"color: var(--color-danger); font-size: 14px;\">⚠️</span>\n          <span style=\"font-weight: 800; color: #fff; letter-spacing: 0.5px;\">XÁC THỰC FACTORY CLEAR (KHÔI PHỤC CÀI ĐẶT GỐC)</span>\n        </div>\n        <button style=\"background: none; border: none; color: #fff; cursor: pointer; font-size: 13px;\" ng-click=\"closeFactoryClearModal()\">✕</button>\n      </div>\n\n      <!-- BƯỚC 1: NHẬP MÃ PIN QUẢN TRỊ / KỸ THUẬT -->\n      <div class=\"dialog-body\" ng-if=\"factoryClearStep === 1\" style=\"padding: 18px; display: flex; flex-direction: column; gap: 12px; font-size: 10px;\">\n        <div style=\"color: var(--text-secondary); line-height: 1.4;\">\n          Thao tác Factory Clear yêu cầu phân quyền Kỹ sư vận hành hoặc Quản trị viên. Vui lòng nhập mã PIN bảo mật để tiếp tục:\n        </div>\n        <div>\n          <label style=\"font-size: 9px; color: var(--cyan-primary); font-weight: 700;\">MÃ PIN BẢO MẬT (Mặc định: 9999 hoặc 1234):</label>\n          <input type=\"password\" ng-model=\"factoryClearPinInput\" placeholder=\"Nhập mã PIN...\" style=\"width: 100%; background: #040812; border: 1px solid var(--border-neutral); color: #fff; padding: 8px; border-radius: 4px; font-size: 14px; font-family: var(--font-mono); letter-spacing: 4px; margin-top: 4px;\">\n        </div>\n        <div ng-if=\"factoryClearError\" style=\"color: var(--color-danger); font-weight: 700; font-size: 9px;\">\n          ▲ {{factoryClearError}}\n        </div>\n        <div class=\"dialog-actions\" style=\"margin-top: 10px;\">\n          <button class=\"btn-cmd\" style=\"background: var(--panel-elevated); color: #fff; border: 1px solid var(--border-neutral);\" ng-click=\"closeFactoryClearModal()\">Hủy Bỏ</button>\n          <button class=\"btn-cmd primary\" ng-click=\"verifyFactoryClearPin()\">Tiếp Tục (Bước 2/2) ↗</button>\n        </div>\n      </div>\n\n      <!-- BƯỚC 2: CẢNH BÁO RỦI RO & CHECKLIST XÁC NHẬN CUỐI -->\n      <div class=\"dialog-body\" ng-if=\"factoryClearStep === 2\" style=\"padding: 18px; display: flex; flex-direction: column; gap: 12px; font-size: 10px;\">\n        <div style=\"background: rgba(255,91,104,0.15); border: 1px solid var(--color-danger); padding: 10px; border-radius: 6px; color: #fff; font-weight: 700; line-height: 1.4;\">\n          ▲ CẢNH BÁO RỦI RO CAO: Thao tác này sẽ xóa vĩnh viễn dữ liệu phiên sản xuất hiện tại. Các mục sau đây sẽ được đưa về giá trị 0 mặc định:\n        </div>\n        <ul style=\"color: var(--text-secondary); margin: 0; padding-left: 20px; font-size: 9px; line-height: 1.6;\">\n          <li>Bộ đếm sản lượng phôi Fe: Đưa về <b>0 phôi</b></li>\n          <li>Toàn bộ nhật ký gói tin Modbus RTU Sniffer: <b>Xóa sạch</b></li>\n          <li>Lịch sử chu kỳ và biểu đồ hiệu suất: <b>Làm mới về 3.8s chuẩn</b></li>\n          <li>Cảnh báo nhiệt độ và trạng thái E-Stop: <b>Khôi phục định mức 30.0°C</b></li>\n          <li>Ghi nhật ký Audit Trail: <b>Ghi lại danh tính Administrator & thời gian</b></li>\n        </ul>\n        <div class=\"dialog-actions\" style=\"margin-top: 10px;\">\n          <button class=\"btn-cmd\" style=\"background: var(--panel-elevated); color: #fff; border: 1px solid var(--border-neutral);\" ng-click=\"factoryClearStep = 1\">← Quay Lại</button>\n          <button class=\"btn-cmd danger\" ng-click=\"confirmFactoryClearFinal()\">TÔI XÁC NHẬN RESET TOÀN BỘ (FACTORY CLEAR)</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL: NHẬP PIN MỞ KHÓA SETTINGS -->\n  <div class=\"scada-dialog-backdrop\" ng-if=\"showPinModal\" ng-click=\"showPinModal = false\">\n    <div class=\"scada-dialog-box\" style=\"width: 400px;\" ng-click=\"$event.stopPropagation()\">\n      <div class=\"dialog-top\">\n        <div style=\"font-weight: 800; color: #fff;\">XÁC THỰC KỸ THUẬT VIÊN</div>\n        <button style=\"background: none; border: none; color: #fff; cursor: pointer;\" ng-click=\"showPinModal = false\">✕</button>\n      </div>\n      <div class=\"dialog-body\" style=\"padding: 16px; display: flex; flex-direction: column; gap: 10px; font-size: 10px;\">\n        <div>Nhập mã PIN kỹ thuật viên để mở quyền chỉnh sửa tham số hệ thống (Mặc định: 9999):</div>\n        <input type=\"password\" ng-model=\"settingsPinInput\" placeholder=\"Mã PIN...\" style=\"background: #040812; border: 1px solid var(--border-neutral); color: #fff; padding: 8px; border-radius: 4px; font-size: 14px; font-family: var(--font-mono); letter-spacing: 4px;\">\n        <div ng-if=\"settingsPinError\" style=\"color: var(--color-danger); font-size: 9px; font-weight: 700;\">▲ {{settingsPinError}}</div>\n      </div>\n      <div class=\"dialog-actions\">\n        <button class=\"btn-cmd\" style=\"background: var(--panel-elevated); color: #fff; border: 1px solid var(--border-neutral);\" ng-click=\"showPinModal = false\">Hủy</button>\n        <button class=\"btn-cmd primary\" ng-click=\"confirmSettingsPin()\">Mở Khóa Cấu Hình</button>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function(scope) {\n  scope = scope || window.scope;\n  if (!scope && typeof angular !== 'undefined') {\n    const el = document.querySelector('.scada-command-center');\n    if (el) scope = angular.element(el).scope();\n  }\n  if (!scope) scope = {};\n  window.__scada_scope = scope;\n  console.log(\"=== SCADA V2 SCRIPT EXECUTING! ===\", scope);\n  window.__scada_scope = scope;\n  // ==============================================================\n  // 1. STATE INITIALIZATION (SCADA V2 SINGLE SOURCE OF TRUTH)\n  // ==============================================================\n  scope.activeTab = 'overview';\n  scope.showTwinDetails = false;\n  scope.monitoringSubTab = 'analytics';\n  scope.systemSubTab = 'settings';\n  scope.sidebarCollapsed = false;\n  scope.modbusOnline = true;\n  scope.isSimulating = false;\n  scope.systemMode = 'AUTO'; // 'AUTO' | 'MANUAL'\n  scope.conveyorRunning = false;\n  scope.isEstopTripped = false;\n  scope.sensorActive = false;\n  scope.solenoidActive = false;\n  scope.solenoidHeld = false;\n  scope.solenoidTemp = 30.0;\n  scope.feCount = 3; // Khởi tạo đồng bộ với sản lượng Fe = 3 phôi thực tế\n  scope.lastSensorTime = '11:20:00';\n  scope.lastUpdateTime = '11:20:00.120';\n  scope.toastMsg = '';\n  scope.isModbusPaused = false;\n  scope.txCount = 1420;\n  scope.rxCount = 1420;\n  scope.reconnectCount = 1;\n  scope.commFailureCount = 0;\n\n  // Timers\n  scope.motorRunSeconds = 142 * 3600 + 30 * 60; // 142.5 hours baseline\n  scope.machineStopSeconds = 480;\n  scope.disconnectSeconds = 0;\n\n  // Process & Workpiece Lifecycle\n  scope.currentProcessState = 'WAITING'; // 'WAITING', 'DETECTING', 'CLASSIFYING', 'DIVERTING', 'COMPLETED'\n  scope.currentWorkpieceType = 'Fe'; // 'Fe' | 'Non-Fe'\n  scope.cycleElapsedSec = 0.0;\n  scope.boxVisible = false;\n  scope.boxX = 0;\n  scope.boxY = 115;\n  let animFrameId = null;\n  let deadmanWatchdogTimer = null;\n\n  // Filters\n  scope.modbusFilterDir = 'ALL';\n  scope.modbusFilterFC = 'ALL';\n  scope.modbusSearchText = '';\n  scope.alarmFilterGroup = 'ALL';\n  scope.analyticsShiftFilter = 'ALL';\n  scope.analyticsDateFilter = 'TODAY';\n\n  // Security & Factory Clear\n  scope.showConfirmDialog = false;\n  scope.factoryClearStep = 1;\n  scope.factoryClearPinInput = '';\n  scope.factoryClearError = '';\n  scope.showPinModal = false;\n  scope.settingsUnlocked = false;\n  scope.settingsPinInput = '';\n  scope.settingsPinError = '';\n  scope.isSettingsDirty = false;\n\n  // Inspector modals\n  scope.selectedPacket = null;\n  scope.selectedAlarm = null;\n\n  // Recent 5 events feed\n  scope.recentEvents = [\n    { time: '11:25:40', cat: 'MODBUS', type: 'info', text: 'Đồng bộ thanh ghi COM4 9600-8N1 thành công' },\n    { time: '11:24:12', cat: 'SENSOR', type: 'success', text: 'Cảm biến LJ12A3 phát hiện phôi kim loại Fe #24' },\n    { time: '11:24:14', cat: 'SOLENOID', type: 'info', text: 'Cơ cấu Solenoid kích hoạt chu kỳ gạt 3 nhịp' },\n    { time: '11:22:05', cat: 'MOTOR', type: 'success', text: 'Động cơ 24VDC phản hồi RUNNING định mức' },\n    { time: '11:20:00', cat: 'SYSTEM', type: 'info', text: 'Khởi động trạm Industrial Command Center V2' }\n  ];\n\n  function addRecentEvent(cat, type, text) {\n    scope.recentEvents.unshift({\n      time: getTimestamp().split('.')[0],\n      cat: cat,\n      type: type,\n      text: text\n    });\n    if (scope.recentEvents.length > 5) scope.recentEvents.pop();\n  }\n\n  // ==============================================================\n  // PRODUCTION ANALYTICS, SHIFT MANAGEMENT & PERSISTENT STORAGE\n  // TIMEZONE: Asia/Ho_Chi_Minh (UTC+7)\n  // ==============================================================\n  scope.analyticsShiftFilter = 'ALL';   // 'ALL' | 'SHIFT1' | 'SHIFT2' | 'SHIFT3'\n  scope.analyticsDateFilter = 'TODAY';  // 'TODAY' | '24H' | '7D'\n  scope.filteredProductionCount = 2;\n  scope.hourlyProductionBars = [];\n  scope.displayCycles = [];\n  scope.avgCycleTime = 3.95;\n  scope.stdDevCycle = 0.15;\n  scope.minCycleTime = 3.80;\n  scope.maxCycleTime = 4.10;\n  scope.cycleCountReal = 2;\n\n  // Hàm phân loại ca sản xuất & ngày làm việc logic theo múi giờ Việt Nam\n  function getVnShiftMeta(dInput) {\n    let d = dInput ? new Date(dInput) : new Date();\n    let timeStr = d.toLocaleTimeString('en-GB', { timeZone: 'Asia/Ho_Chi_Minh', hour12: false });\n    let dateStr = d.toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' });\n    let parts = timeStr.split(':').map(Number);\n    let h = parts[0];\n    let m = parts[1];\n    let s = parts[2] || 0;\n\n    let shift = 'SHIFT1';\n    let prodDate = dateStr;\n    if (h >= 6 && h < 14) {\n      shift = 'SHIFT1';\n    } else if (h >= 14 && h < 22) {\n      shift = 'SHIFT2';\n    } else {\n      shift = 'SHIFT3';\n      // Xử lý CA 3 chạy qua ngày: 00:00 - 05:59 thuộc ngày sản xuất bắt đầu lúc 22:00 hôm trước\n      if (h < 6) {\n        let prevDay = new Date(d.getTime() - 24 * 3600 * 1000);\n        prodDate = prevDay.toLocaleDateString('en-CA', { timeZone: 'Asia/Ho_Chi_Minh' });\n      }\n    }\n    return {\n      timestamp: d.getTime(),\n      timeStr: timeStr,\n      dateStr: dateStr,\n      prodDate: prodDate,\n      hour: h,\n      minute: m,\n      shift: shift\n    };\n  }\n\n  // ==============================================================\n  // DỮ LIỆU SẢN XUẤT & PHÁT HIỆN PHÔI TỪ CẢM BIẾN TIỆM CẬN LJ12A3\n  // ==============================================================\n  const STORAGE_KEY = 'SCADA_PROD_RECORDS_V4';\n  scope.productionRecords = [];\n  try {\n    let saved = localStorage.getItem(STORAGE_KEY);\n    if (saved) {\n      scope.productionRecords = JSON.parse(saved);\n    }\n  } catch(e) {\n    console.warn('LocalStorage error:', e);\n  }\n\n  // Khởi tạo phôi ban đầu phù hợp với cảm biến tiệm cận LJ12A3\n  if (!scope.productionRecords || scope.productionRecords.length === 0) {\n    let now = Date.now();\n    let meta1 = getVnShiftMeta(new Date(now - 16000));\n    let meta2 = getVnShiftMeta(new Date(now - 8500));\n    let meta3 = getVnShiftMeta(new Date(now));\n    scope.productionRecords = [\n      {\n        id: 1,\n        workpieceNum: 1,\n        timestamp: meta1.timestamp,\n        timeStr: meta1.timeStr,\n        dateStr: meta1.dateStr,\n        prodDate: meta1.prodDate,\n        hour: meta1.hour,\n        shift: meta1.shift,\n        intervalSec: 0.0,\n        status: 'KHỞI ĐẦU'\n      },\n      {\n        id: 2,\n        workpieceNum: 2,\n        timestamp: meta2.timestamp,\n        timeStr: meta2.timeStr,\n        dateStr: meta2.dateStr,\n        prodDate: meta2.prodDate,\n        hour: meta2.hour,\n        shift: meta2.shift,\n        intervalSec: 7.5,\n        status: 'HỢP LỆ'\n      },\n      {\n        id: 3,\n        workpieceNum: 3,\n        timestamp: meta3.timestamp,\n        timeStr: meta3.timeStr,\n        dateStr: meta3.dateStr,\n        prodDate: meta3.prodDate,\n        hour: meta3.hour,\n        shift: meta3.shift,\n        intervalSec: 8.5,\n        status: 'HỢP LỆ'\n      }\n    ];\n    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(scope.productionRecords))