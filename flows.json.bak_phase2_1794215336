een; align-items: center;\">\n                <span style=\"font-size: 9px; font-weight: 700; color: var(--text-secondary);\">DÂY ĐAI BĂNG TẢI</span>\n                <span style=\"font-size: 11px; font-weight: 900; color: var(--color-success); font-family: var(--font-mono);\">95%</span>\n              </div>\n              <div class=\"health-bar-bg\"><div class=\"health-bar-fill\" style=\"width: 95%;\"></div></div>\n              <div style=\"font-size: 7.5px; color: var(--text-muted); font-family: var(--font-mono);\">Độ căng: Chuẩn • Không trượt</div>\n            </div>\n          </div></div>\n\n          <!-- LỊCH TRÌNH BẢO DƯỠNG DỰ PHÒNG ĐỊNH KỲ (PREVENTIVE MAINTENANCE) -->\n          <div style=\"margin-bottom: 14px;\">\n            <div style=\"font-size: 9px; font-weight: 700; color: var(--text-secondary); margin-bottom: 8px;\">\n              LỊCH TRÌNH BẢO DƯỠNG DỰ PHÒNG ĐỊNH KỲ (PREVENTIVE MAINTENANCE SCHEDULE)\n            </div>\n            <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; font-size: 8.5px;\">\n              <div style=\"background: var(--panel-secondary); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                <div style=\"font-weight: 700; color: #fff;\">1. CĂNG DÂY ĐAI & TRỤC RULO</div>\n                <div style=\"color: var(--text-muted); font-size: 7.5px; margin-top: 2px;\">Chu kỳ: 30 ngày</div>\n                <div style=\"color: var(--color-success); font-weight: 800; margin-top: 4px;\">Còn 12 ngày (Bình thường)</div>\n              </div>\n              <div style=\"background: var(--panel-secondary); padding: 8px 10px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                <div style=\"font-weight: 700; color: #fff;\">2. VỆ SINH ĐẦU TỪ LJ12A3</div>\n                <div style=\"color: var(--text-muted); font-size: 7.5px; margin-top: 2px;\">Chu kỳ: 15 ngày</div>\n                <div style=\"color: var(--color-warning); font-we