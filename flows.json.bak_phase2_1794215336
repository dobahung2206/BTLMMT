    {
        "id": "667bdb838ac3ae9d",
        "type": "function",
        "z": "8db70ae311f732e1",
        "g": "group_solenoid",
        "name": "Chu kỳ Solenoid 3 nhịp (t=1.75s, nhịp 2&3 duỗi 0.75s)",
        "outputs": 2,
        "x": 750,
        "y": 140,
        "wires": [
            [
                "440cbdde9bf30775",
                "link_out_sol_telemetry",
                "bd13efc4aaaa4c58"
            ],
            [
                "52be7f48da40b346",
                "link_out_sol_telemetry",
                "1f4563de86f8c850"
            ]
        ],
        "func": "// ==============================================================================\n// CHU KỲ KÍCH HOẠT SOLENOID 3 NHỊP (NHỊP 1 DUỖI 2.0S, NHỊP 2&3 DUỖI 0.75S)\n// ------------------------------------------------------------------------------\n// t = 0.00s: Cảm biến LJ12A3 phát hiện phôi kim loại khi băng chuyền đang chạy\n// t = 1.75s: Bắt đầu duỗi lần 1 (gạt sớm 0.25s, giữ duỗi 2.0s)\n// t = 3.75s: Dừng duỗi lần 1 (nghỉ rút vào 1.95s)\n// t = 5.70s: Bắt đầu duỗi lần 2 (giảm 0.25s -> duỗi 0.75s)\n// t = 6.45s: Dừng duỗi lần 2 (nghỉ xả nhiệt 1.70s)\n// t = 8.15s: Bắt đầu duỗi lần 3 (giảm 0.25s -> duỗi 0.75s)\n// t = 8.90s: Dừng duỗi lần 3 (hoàn tất chu kỳ 3 nhịp)\n// ==============================================================================\n\nlet cycleTimers = context.get('cycleTimers') || [];\n\nfunction clearAllCycleTimers() {\n    cycleTimers.forEach(t => clearTimeout(t));\n    cycleTimers = [];\n    context.set('cycleTimers', []);\n}\n\n// 1. Xử lý lệnh HỦY CHU KỲ (khi dừng băng chuyền hoặc reset)\nif (msg.topic === \"cancel_cycle\" || msg.payload === false) {\n    clearAllCycleTimers();\n    node.send([\n        null,\n        { payload: false, topic: \"solenoid_off\", adr: 1, text: \"Dừng băng tải - Thu hồi Solenoid an toàn\" }\n    ]);\n    return null;\n}\n\n// 2. CHỈ KÍCH HOẠT KHI ĐÚNG TOPIC \"trigger\" VÀ BĂNG CHUYỀN ĐANG CHẠY\nlet conveyorRunning = flow.get('conveyorRunning') || false;\nif (msg.topic === \"trigger\" && conveyorRunning) {\n    clearAllCycleTimers();\n\n    // 1. Tại t = 1.75s: Bắt đầu duỗi lần 1 (gạt sớm 0.25s, giữ duỗi 2.0s)\n    let t1 = setTimeout(() => {\n        if (!flow.get('conveyorRunning')) return;\n        node.send([\n            { payload: true, topic: \"solenoid_on\", adr: 1, text: \"Kích hoạt Solenoid nhịp 1 (gạt sớm 1.75s, duỗi 2.0s)\" },\n            null\n        ]);\n    }, 1750);\n    cycleTimers.push(t1);\n\n    // 2. Tại t = 3.75s: Dừng duỗi lần 1 (nghỉ rút vào 1.95s từ 3.75s đến 5.70s)\n    let t2 = setTimeout(() => {\n        node.send([\n            null,\n            { payload: false, topic: \"solenoid_off\", adr: 1, text: \"Thu hồi Solenoid nhịp 1 (nghỉ rút vào 1.95s)\" }\n        ]);\n    }, 3750);\n    cycleTimers.push(t2);\n\n    // 3. Tại t = 5.70s: Bắt đầu duỗi lần 2 (giảm thời gian giữ đi 0.25s -> duỗi 0.75s)\n    let t3 = setTimeout(() => {\n        if (!flow.get('conveyorRunning')) return;\n        node.send([\n            { payload: true, topic: \"solenoid_on\", adr: 1, text: \"Kích hoạt Solenoid nhịp 2 (duỗi 0.75s)\" },\n            null\n        ]);\n    }, 5700);\n    cycleTimers.push(t3);\n\n    // 4. Tại t = 6.45s: Dừng duỗi lần 2, nghỉ 1.70s xả nhiệt\n    let t4 = setTimeout(() => {\n        node.send([\n            null,\n            { payload: false, topic: \"solenoid_off\", adr: 1, text: \"Thu hồi Solenoid nhịp 2 (nghỉ xả nhiệt 1.70s)\" }\n        ]);\n    }, 6450);\n    cycleTimers.push(t4);\n\n    // 5. Tại t = 8.15s: Bắt đầu duỗi lần 3 (giảm thời gian giữ đi 0.25s -> duỗi 0.75s)\n    let t5 = setTimeout(() => {\n        if (!flow.get('conveyorRunning')) return;\n        node.send([\n            { payload: true, topic: \"solenoid_on\", adr: 1, text: \"Kích hoạt Solenoid nhịp 3 (duỗi 0.75s)\" },\n            null\n        ]);\n    }, 8150);\n    cycleTimers.push(t5);\n\n    // 6. Tại t = 8.90s: Dừng duỗi lần 3 (hoàn tất chu kỳ 3 nhịp)\n    let t6 = setTimeout(() => {\n        node.send([\n            null,\n            { payload: false, topic: \"solenoid_off\", adr: 1, text: \"Thu hồi Solenoid hoàn tất chu kỳ phân loại 3 nhịp\" }\n        ]);\n        clearAllCycleTimers();\n    }, 8900);\n    cycleTimers.push(t6);\n\n    context.set('cycleTimers', cycleTimers);\n}\n\nreturn null;\n"
    },
