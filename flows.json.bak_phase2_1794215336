n    ]);\n    const springLine = new THREE.Line(springGeo, springMaterial);\n    conveyorGroup.add(springLine);\n\n    const BIN_WIDTH = 8.0;\n    const BIN_LEN = 9.0;\n    const BIN_DEPTH = 5.0;\n\n    const binNonFeGeo = new THREE.BoxGeometry(BIN_LEN, BIN_DEPTH, BIN_WIDTH);\n    const binNonFe = new THREE.Mesh(binNonFeGeo, matBinNonFe);\n    binNonFe.position.set(DISCHARGE_X + 6.8, -0.6, (CONVEYOR_WIDTH / 2 + BIN_WIDTH / 2 - 1.5));\n    conveyorGroup.add(binNonFe);\n\n    const wireNonFe = new THREE.LineSegments(new THREE.EdgesGeometry(binNonFeGeo), new THREE.LineBasicMaterial({ color: 0x38bdf8 }));\n    binNonFe.add(wireNonFe);\n\n    const binFeGeo = new THREE.BoxGeometry(BIN_LEN, BIN_DEPTH, BIN_WIDTH);\n    const binFe = new THREE.Mesh(binFeGeo, matBinFe);\n    binFe.position.set(DISCHARGE_X + 6.8, -0.6, -(CONVEYOR_WIDTH / 2 + BIN_WIDTH / 2 - 1.5));\n    conveyorGroup.add(binFe);\n\n    const wireFe = new THREE.LineSegments(new THREE.EdgesGeometry(binFeGeo), new THREE.LineBasicMaterial({ color: 0xf59e0b }));\n    binFe.add(wireFe);\n\n    const labelNonFe = makeTextSprite('Khay Phi Kim (Trên)', '#38bdf8');\n    labelNonFe.position.set(DISCHARGE_X + 6.8, 3.8, (CONVEYOR_WIDTH / 2 + BIN_WIDTH / 2 - 1.5));\n    conveyorGroup.add(labelNonFe);\n\n    const labelFe = makeTextSprite('Khay Kim Loại (Dưới)', '#f59e0b');\n    labelFe.position.set(DISCHARGE_X + 6.8, 3.8, -(CONVEYOR_WIDTH / 2 + BIN_WIDTH / 2 - 1.5));\n    conveyorGroup.add(labelFe);\n\n    const labelMech = makeTextSprite('Trục Bản Lề O (M3)', '#34d399');\n    labelMech.position.set(PIVOT_X, 6.4, PIVOT_Z);\n    conveyorGroup.add(labelMech);\n\n    let workpieces = [];\n\n    function spawnWorkpiece(isMetal) {\n      const cylGeo = new THREE.CylinderGeometry(0.9, 0.9, 1.0, 20);\n      const mat = new THREE.MeshStandardMaterial({\n        color: isMetal ? 0xf59e0b : 0xe2e8f0,\n        metalness: isMetal ? 0.85 : 0.05,\n        roughness: isMetal ? 0.25 : 0.6\n      });\n      const mesh = new THREE.Mesh(cylGeo, mat);\n      mesh.castShadow = true;\n      // Spawn with slight realistic random lateral drift\n      const randomOffsetZ = (Math.random() - 0.5) * 4.4; // from -2.2 to +2.2\n      mesh.position.set(-CONVEYOR_LEN / 2 + 2, BED_HEIGHT + 0.55, randomOffsetZ);\n      scene.add(mesh);\n\n      workpieces.push({ mesh: mesh, isMetal: isMetal, state: 'on_belt', vy: 0 });\n    }\n\n    let isSolenoidEnergized = false;\n    let targetAngle = -0.35;\n    let currentAngle = -0.35;\n    const MAX_TILT = 0.35;\n\n    const btnToggle = document.getElementById('btnToggleSolenoid');\n    const solenoidIcon = document.getElementById('solenoidIcon');\n    const solenoidText = document.getElementById('solenoidText');\n    const badgeAngle = document.getElementById('badgeAngle');\n    const btnSpawnMetal = document.getElementById('btnSpawnMetal');\n    const btnSpawnPlastic = document.getElementById('btnSpawnPlastic');\n    const btnToggleXRay = document.getElementById('btnToggleXRay');\n\n    let isXRay = false;\n    btnToggleXRay.addEventListener('click', () => {\n      isXRay = !isXRay;\n      matBridge.opacity = isXRay ? 0.35 : 0.95;\n      matBridge.needsUpdate = true;\n      btnToggleXRay.innerText = isXRay ? \"👁️ Tắt X-Ray (Đục)\" : \"👁️ Nhìn Xuyên Thấu (X-Ray)\";\n    });\n\n    const btnToggleLabels = document.getElementById('btnToggleLabels');\n    const btnToggleUI = document.getElementById('btnToggleUI');\n    const topHeaderPanel = document.getElementById('topHeaderPanel');\n    const mechDetailsPanel = document.getElementById('mechDetailsPanel');\n\n    let areLabelsVisible = true;\n    function toggleLabels() {\n      areLabelsVisible = !areLabelsVisible;\n      allTextSprites.forEach(sprite => {\n        sprite.visible = areLabelsVisible;\n      });\n      if (btnToggleLabels) {\n        if (areLabelsVisible) {\n          btnToggleLabels.innerHTML = '🏷️ Ẩn Chữ 3D';\n          btnToggleLabels.className = 'px-2.5 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 