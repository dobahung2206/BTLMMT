"14\" r=\"2.5\" ng-attr-fill=\"{{solenoidTemp >= 60 ? '#FF5B68' : (solenoidTemp >= 45 ? '#f59e0b' : '#31D6A0')}}\"/>\n              </svg>\n            </div>\n            <div class=\"kpi-card-bottom\">\n              <div class=\"kpi-stat-val\">\n                <span class=\"kpi-num\" ng-style=\"{'color': solenoidTemp >= 60 ? 'var(--color-danger)' : (solenoidTemp >= 45 ? 'var(--color-warning)' : 'var(--color-success)')}\">{{solenoidTemp | number:1}}</span>\n                <span class=\"kpi-stat-unit\" ng-style=\"{'color': solenoidTemp >= 60 ? 'var(--color-danger)' : (solenoidTemp >= 45 ? 'var(--color-warning)' : 'var(--color-success)')}\">°C</span>\n              </div>\n              <div class=\"kpi-stat-sub\">Bình thường (&lt; 45°C)</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Bố cục 3 vùng: Băng chuyền trung tâm (68%) + Panel trạng thái & Điều khiển nhanh (32%) -->\n        <div class=\"overview-main-grid\" style=\"display: grid; grid-template-columns: 3fr 2fr; gap: 14px; margin-bottom: 14px; align-items: stretch;\">\n          <!-- Khung Băng chuyền Hero 2D Digital Twin -->\n          <div class=\"card-panel\" style=\"padding: 12px; display: flex; flex-direction: column; justify-content: space-between; min-height: 380px;\">\n            <div class=\"section-header-row\" style=\"margin-bottom: 8px;\">\n              <div class=\"section-title\" style=\"display: flex; align-items: center; gap: 8px;\">\n                <span class=\"scada-icon\" style=\"color: var(--cyan-primary);\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 14.5L12 19l8-4.5\"/><path d=\"M4 9.5L12 14l8-4.5\"/><path d=\"M12 2L4 6.5l8 4.5 8-4.5L12 2z\"/></svg></span>\n                <span>MÔ HÌNH CHUYỂN ĐỘNG BĂNG CHUYỀN (2D CAD DIGITAL TWIN)</span>\n                <!-- Trạng thái vận hành phân biệt rõ 5 pha: Standby, Running, Detecting, Diverting, Fault -->\n                <span class=\"state-banner-pill\" ng-class=\"{\n                  'state-fault': isEstopTripped || solenoidTemp >= 60,\n                  'state-diverting': solenoidActive,\n                  'state-detecting': sensorActive && !solenoidActive,\n                  'state-running': conveyorRunning && !sensorActive && !solenoidActive && !isEstopTripped && solenoidTemp < 60,\n                  'state-standby': !conveyorRunning && !isEstopTripped && solenoidTemp < 60\n                }\">\n                  ● {{isEstopTripped ? 'FAULT (E-STOP)' : (solenoidTemp >= 60 ? 'FAULT (TRIP >60°C)' : (solenoidActive ? 'DIVERTING (GẠT PHÔI)' : (sensorActive ? 'DETECTING (KIM LOẠI)' : (conveyorRunning ? 'RUNNING (CHẠY)' : 'STANDBY (CHỜ)'))))}}\n                </span>\n              </div>\n              <div style=\"display: flex; align-items: center; gap: 8px;\">\n                <span class=\"status-pill\" style=\"background: var(--panel-secondary); color: var(--text-primary); border: 1px solid var(--border-neutral); font-family: var(--font-mono); font-size: 8.5px;\">\n                  TỌA ĐỘ: {{boxVisible ? (boxX + 'mm') : '---'}}\n                </span>\n                <button class=\"btn-subtle\" ng-click=\"showTwinDetails = !showTwinDetails\" style=\"padding: 4px 10px; font-size: 9px; font-weight: 700; border-radius: 6px; background: var(--panel-secondary); border: 1px solid var(--border-neutral); color: var(--cyan-primary); cursor: pointer; display: inline-flex; align-items: center; gap: 5px; transition: all 0.18s ease;\">\n                  <svg class=\"scada-icon\" width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></svg>\n                  <span>{{showTwinDetails ? 'ẨN CHI TIẾT CAD' : 'CHI TIẾT KỸ THUẬT'}}</span>\n                </button>\n              </div>