        "func": "// ==============================================================================\n// QUẢN LÝ TRẠNG THÁI SCADA & NHẬT KÝ & GÓI TIN MODBUS RTU (POLL INSPECTOR)\n// ==============================================================================\n\nlet state = flow.get('scada_state') || 'STOPPED';\nlet statusText = flow.get('scada_statusText') || 'Hệ thống đang dừng';\nlet conveyorRunning = flow.get('conveyorRunning') || false;\nlet metalCount = flow.get('metalCount') || 0;\nlet totalCount = flow.get('totalCount') || 0;\nlet opEvents = flow.get('opEvents') || [];\nlet secEvents = flow.get('secEvents') || [];\nlet intervals = flow.get('intervals') || [];\nlet lastMetalTime = flow.get('lastMetalTime') || null;\nlet modbusPackets = flow.get('modbus_packets') || [];\n\n// TRẠNG THÁI MODBUS RTU TẢ THỰC: Mặc định false (Offline) cho tới khi có tín hiệu thực tế\nlet modbusOnline = flow.get('modbusOnline');\nif (modbusOnline === undefined) {\n    modbusOnline = false;\n    flow.set('modbusOnline', false);\n}\n\nlet now = new Date();\nlet timeStr = now.toTimeString().split(' ')[0];\nlet timeMsStr = timeStr + '.' + ('00' + now.getMilliseconds()).slice(-3);\nlet soundTrigger = null;\n\nfunction addOpEvent(tag, tagType, text) {\n    opEvents.unshift({ time: timeStr, tag: tag, tagType: tagType, text: text });\n    if (opEvents.length > 50) opEvents.pop();\n    flow.set('opEvents', opEvents);\n}\n\nfunction addSecEvent(tag, tagType, text) {\n    secEvents.unshift({ time: timeStr, tag: tag, tagType: tagType, text: text });\n    if (secEvents.length > 50) secEvents.pop();\n    flow.set('secEvents', secEvents);\n}\n\nfunction addModbusPacket(dir, fc, hex, desc, crc) {\n    modbusPackets.unshift({\n        time: timeMsStr,\n        dir: dir,\n        fc: fc,\n        hex: hex,\n        desc: desc,\n        crc: crc || 'OK'\n    });\n    if (modbusPackets.length > 80) modbusPackets.pop();\n    flow.set('modbus_packets', modbusPackets);\n}\n\n// Khởi tạo các gói tin Modbus mẫu nếu mảng đang rỗng\nif (modbusPackets.length === 0) {\n    addModbusPacket('RX', 'FC02', 'FF 02 01 00 90 60', 'Phản hồi IN1-8 = 0 [Trạng thái cảm biến sẵn sàng]');\n    addModbusPacket('TX', 'FC02', 'FF 02 00 00 00 08 6C 12', 'Khởi tạo truyền thông Modbus RTU (Quét 8 ngõ vào số)');\n    addModbusPacket('TX', 'FC05', 'FF 05 00 00 00 00 D8 14', 'Ghi Coil 0 = 0 [Khóa an toàn động cơ băng tải]');\n    addModbusPacket('TX', 'FC05', 'FF 05 00 01 00 00 89 D4', 'Ghi Coil 1 = 0 [Thu hồi an toàn Solenoid]');\n}\n\n// =========================================================\n// MẢNG 1: TRẠNG THÁI KẾT NỐI MODBUS & WATCHDOG HEARTBEAT\n// =========================================================\nif (msg.topic === 'heartbeat_status') {\n    modbusOnline = Boolean(msg.payload);\n    flow.set('modbusOnline', modbusOnline);\n    if (modbusOnline) {\n        addSecEvent('KẾT NỐI', 'success', 'Truyền thông Modbus ESP8266 ổn định (150ms)');\n        addModbusPacket('TX', 'FC02', 'FF 02 00 00 00 08 6C 12', 'Truy vấn thăm dò Heartbeat Modbus [COM4 Polling 150ms]');\n        addModbusPacket('RX', 'FC02', 'FF 02 01 00 90 60', 'Phản hồi Heartbeat Slave 255 [Bình thường]');\n    } else {\n        addSecEvent('TIMEOUT', 'danger', 'Mất kết nối Modbus RTU ESP8266 (COM4 Timeout)');\n        addOpEvent('CẢNH BÁO', 'danger', 'Mất tín hiệu Modbus RTU COM4 - Kiểm tra cáp nối vật lý');\n    }\n} else if (msg.topic === 'simulate_disconnect') {\n    modbusOnline = !Boolean(msg.payload);\n    flow.set('modbusOnline', modbusOnline);\n    if (!modbusOnline) {\n        addSecEvent('TIMEOUT', 'danger', 'Giả lập rút cáp: Mất kết nối Modbus RTU COM4');\n        addOpEvent('CẢNH BÁO', 'danger', 'Đã ngắt tín hiệu Modbus RTU COM4 (Simulate Disconnect)');\n    } else {\n        addSecEvent('KẾT NỐI', 'success', 'Giả lập cắm cáp: Đã khôi phục kết nối Modbus RTU COM4');\n        addOpEvent('KẾT NỐI', 'success', 'Đã khôi phục tín hiệu Modbus RTU COM4 (Simulate Connect)');\n    }\n} else if (msg.topic === 'user_login') {\n    soundTrigger = 'chime';\n    addSecEvent('ĐĂNG NHẬP', 'primary', 'Kỹ sư ' + msg.payload + ' đăng nhập vào hệ thống');\n} else if (msg.topic === 'user_logout') {\n    soundTrigger = 'beep';\n    addSecEvent('ĐĂNG XUẤT', 'info', 'Kỹ sư ' + msg.payload + ' đã đăng xuất khỏi hệ thống');\n}\n\n// =========================================================\n// MẢNG 2: VẬN HÀNH, THIẾT BỊ & BẮT GÓI MODBUS RTU\n// =========================================================\nelse if (msg.topic === 'conveyor_cmd') {\n    let run = Array.isArray(msg.payload) ? Boolean(msg.payload[0]) : Boolean(msg.payload);\n    if (run) {\n        conveyorRunning = true;\n        state = 'RUNNING';\n        statusText = 'Băng chuyền đang hoạt động';\n        soundTrigger = 'beep';\n        addOpEvent('BĂNG TẢI', 'success', 'Khởi động động cơ băng chuyền vận hành');\n        addModbusPacket('TX', 'FC05', 'FF 05 00 00 FF 00 99 E4', 'Ghi Coil 0 = 1 [Chạy động cơ băng tải]');\n        addModbusPacket('RX', 'FC05', 'FF 05 00 00 FF 00 99 E4', 'Phản hồi xác nhận Coil 0 = 1 (Động cơ ON)');\n    } else {\n        conveyorRunning = false;\n        flow.set('solenoidActive', false);\n        state = 'STOPPED';\n        statusText = 'Băng chuyền đã dừng';\n        soundTrigger = 'beep';\n        addOpEvent('BĂNG TẢI', 'danger', 'Dừng động cơ băng chuyền an toàn');\n        addModbusPacket('TX', 'FC05', 'FF 05 00 00 00 00 D8 14', 'Ghi Coil 0 = 0 [Dừng động cơ băng tải]');\n        addModbusPacket('RX', 'FC05', 'FF 05 00 00 00 00 D8 14', 'Phản hồi xác nhận Coil 0 = 0 (Động cơ OFF)');\n    }\n} else if (msg.topic === 'metal') {\n    metalCount = msg.payload;\n    totalCount = metalCount;\n    state = 'SORTING';\n    statusText = 'Phát hiện phôi kim loại #' + metalCount;\n    soundTrigger = 'chime';\n    addOpEvent('KIM LOẠI', 'warning', 'Cảm biến IN1 (LJ12A3) phát hiện phôi Fe #' + metalCount);\n    addModbusPacket('RX', 'FC02', 'FF 02 01 01 51 A0', 'Phản hồi IN1 = 1 [Cảm biến tiệm cận bắt phôi Fe #' + metalCount + ']');\n\n    let curTime = Date.now();\n    if (lastMetalTime) {\n        let diffSec = Math.round(((curTime - lastMetalTime) / 1000) * 10) / 10;\n        if (diffSec > 0.5 && diffSec < 60) {\n            intervals.push(diffSec);\n            if (intervals.length > 25) intervals.shift();\n            flow.set('intervals', intervals);\n        }\n    }\n    lastMetalTime = curTime;\n    flow.set('lastMetalTime', lastMetalTime);\n} else if (msg.topic === 'solenoid_on' || ((msg.payload === true || (Array.isArray(msg.payload) && msg.payload[0] === true)) && msg.adr === 1)) {\n    state = 'SORTING';\n    flow.set('solenoidActive', true);\n    statusText = msg.text || 'Solenoid kích hoạt đòn bẩy gạt phôi';\n    soundTrigger = 'chime';\n    addOpEvent('SOLENOID', 'warning', msg.text || 'Kích hoạt đòn bẩy Solenoid gạt phôi kim loại');\n    addModbusPacket('TX', 'FC05', 'FF 05 00 01 FF 00 C8 24', 'Ghi Coil 1 = 1 [' + (msg.text || 'Bật Solenoid') + ']');\n    addModbusPacket('RX', 'FC05', 'FF 05 00 01 FF 00 C8 24', 'Phản hồi xác nhận Coil 1 = 1');\n} else if (msg.topic === 'solenoid_off' || msg.payload === false) {\n    flow.set('solenoidActive', false);\n    state = conveyorRunning ? 'RUNNING' : 'STOPPED';\n    statusText = conveyorRunning ? 'Băng chuyền đang hoạt động' : 'Băng chuyền đã dừng';\n    addOpEvent('SOLENOID', 'info', msg.text || 'Thu hồi đòn bẩy Solenoid về vị trí chờ');\n    addModbusPacket('TX', 'FC05', 'FF 05 00 01 00 00 89 D4', 'Ghi Coil 1 = 0 [' + (msg.text || 'Thu hồi Solenoid') + ']');\n    addModbusPacket('RX', 'FC05', 'FF 05 00 01 00 00 89 D4', 'Phản hồi xác nhận Coil 1 = 0');\n}\n\n// =========================================================\n// MẢNG 3: CÁC LỆNH RESET CHỌN LỌC\n// =========================================================\nelse if (msg.topic === 'reset_metal' || msg.topic === 'reset_counter') {\n    metalCount = 0;\n    totalCount = 0;\n    flow.set('metalCount', 0);\n    flow.set('totalCount', 0);\n    soundTrigger = 'beep';\n    addOpEvent('RESET', 'warning', 'Đã đặt lại bộ đếm phôi kim loại về 0');\n} else if (msg.topic === 'reset_stats') {\n    intervals = [];\n    lastMetalTime = null;\n    flow.set('intervals', []);\n    flow.set('lastMetalTime', null);\n    soundTrigger = 'beep';\n    addOpEvent('RESET', 'info', 'Đã xóa dữ liệu chu kỳ & làm mới biểu đồ thống kê');\n} else if (msg.topic === 'clear_modbus_log') {\n    modbusPackets = [];\n    flow.set('modbus_packets', []);\n    addOpEvent('DỌN DẸP', 'info', 'Đã xóa nhật ký gói tin Modbus RTU');\n} else if (msg.topic === 'reset' || msg.topic === 'reset_all' || msg.topic === 'clear_all_data') {\n    metalCount = 0;\n    totalCount = 0;\n    intervals = [];\n    lastMetalTime = null;\n    modbusPackets = [];\n    flow.set('metalCount', 0);\n    flow.set('totalCount', 0);\n    flow.set('intervals', []);\n    flow.set('lastMetalTime', null);\n    flow.set('modbus_packets', []);\n    flow.set('solenoidActive', false);\n    soundTrigger = 'beep';\n    addOpEvent('RESET', 'danger', 'Đặt lại toàn bộ số liệu, biểu đồ và gói tin hệ thống');\n}\n\nflow.set('scada_state', state);\nflow.set('scada_statusText', statusText);\nflow.set('conveyorRunning', conveyorRunning);\n\nmsg.payload = {\n    state: state,\n    statusText: statusText,\n    conveyorRunning: conveyorRunning,\n    solenoidActive: flow.get('solenoidActive') || false,\n    metalCount: flow.get('metalCount') || 0,\n    totalCount: flow.get('metalCount') || 0,\n    modbusOnline: modbusOnline,\n    opEvents: opEvents,\n    secEvents: secEvents,\n    intervals: intervals,\n    modbusPackets: modbusPackets,\n    soundTrigger: soundTrigger,\n    time: timeStr\n};\n\nreturn msg;\n"
    },
