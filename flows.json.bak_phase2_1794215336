    {
        "id": "c8314e6b21da4320",
        "type": "function",
        "z": "8db70ae311f732e1",
        "g": "group_sensors",
        "name": "Bộ đếm & Lọc sườn lên",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
        "y": 150,
        "wires": [
            [
                "link_out_fe"
            ],
            [
                "link_out_fe"
            ],
            [
                "667bdb838ac3ae9d"
            ]
        ],
        "func": "// ==============================================================================\n// BỘ ĐẾM & BỘ LỌC SƯỜN LÊN ĐƠN CẢM BIẾN (LJ12A3 - KHÓA LIÊN ĐỘNG & CHỐNG NHIỄU)\n// ==============================================================================\n\nlet metalCount = flow.get('metalCount') || 0;\nlet conveyorRunning = flow.get('conveyorRunning') || false;\nlet lastMetalState = context.get('lastMetalState') || false;\nlet isInitialized = context.get('isInitialized') || false;\nlet motorStartTime = context.get('motorStartTime') || 0;\n\n// 1. Xử lý lệnh điều khiển Băng tải\nif (msg.topic === \"conveyor_cmd\") {\n    let run = Array.isArray(msg.payload) ? Boolean(msg.payload[0]) : Boolean(msg.payload);\n    flow.set('conveyorRunning', run);\n    if (run) {\n        context.set('motorStartTime', Date.now());\n    } else {\n        context.set('lastMetalState', false);\n        return [\n            null,\n            null,\n            { payload: false, topic: \"cancel_cycle\", text: \"Dừng băng tải - Hủy chu kỳ Solenoid\" }\n        ];\n    }\n    return null;\n}\n\nif (msg.topic === \"simulate_disconnect\" || msg.topic === \"clear_log\") {\n    return null;\n}\n\n// 2. Xử lý các lệnh Reset chọn lọc\nif (msg.topic === \"reset\" || msg.payload === \"reset\" || msg.topic === \"reset_all\" || msg.topic === \"reset_counter\" || msg.topic === \"clear_all_data\") {\n    metalCount = 0;\n    flow.set('metalCount', 0);\n    flow.set('totalCount', 0);\n    context.set('lastMetalState', false);\n    return [\n        { payload: 0, topic: \"metal\" },     // Out 1: SP Kim loại\n        { payload: 0, topic: \"total\" },     // Out 2: Tổng sản phẩm\n        { payload: false, topic: \"cancel_cycle\" } // Out 3: Hủy Solenoid\n    ];\n} else if (msg.topic === \"reset_metal\") {\n    metalCount = 0;\n    flow.set('metalCount', 0);\n    flow.set('totalCount', 0);\n    context.set('lastMetalState', false);\n    return [\n        { payload: 0, topic: \"metal\" },\n        { payload: 0, topic: \"total\" },\n        null\n    ];\n} else if (msg.topic === \"reset_stats\") {\n    return null;\n}\n\n// 3. Xử lý tín hiệu cảm biến IN1 (LJ12A3 kim loại)\nlet isMetal = false;\n\nif (msg.topic === \"simulate_metal\") {\n    isMetal = true;\n} else if (msg.topic === \"\" || msg.topic === \"sensor\" || msg.topic === \"polling\" || !msg.topic) {\n    if (Array.isArray(msg.payload)) {\n        isMetal = Boolean(msg.payload[0]); // Chỉ dùng IN1 (Cảm biến từ LJ12A3)\n    } else if (typeof msg.payload === \"boolean\") {\n        isMetal = msg.payload;\n    }\n}\n\n// 4. CHỐNG BẪY SƯỜN LÊN KHI KHỞI ĐỘNG HỆ THỐNG / MỞ WEB\nif (!isInitialized) {\n    context.set('isInitialized', true);\n    context.set('lastMetalState', isMetal);\n    return null;\n}\n\n// 5. KHÓA LIÊN ĐỘNG: BĂNG TẢI PHẢI ĐANG CHẠY MỚI NHẬN DIỆN & PHÂN LOẠI\nconveyorRunning = flow.get('conveyorRunning') || false;\nif (!conveyorRunning) {\n    context.set('lastMetalState', isMetal);\n    return null;\n}\n\n// 6. VÙNG BLANKING CHỐNG NHIỄU DÒNG MỞ MÁY ĐỘNG CƠ (1000ms)\nif (motorStartTime > 0 && (Date.now() - motorStartTime < 1000)) {\n    context.set('lastMetalState', isMetal);\n    return null;\n}\n\n// 7. SƯỜN LÊN KIM LOẠI: Cảm biến phát hiện phôi kim loại khi băng tải đang chạy\nif (isMetal && !lastMetalState) {\n    context.set('lastMetalState', true);\n    metalCount += 1;\n    flow.set('metalCount', metalCount);\n    flow.set('totalCount', metalCount); // Đơn cảm biến: tổng = kim loại\n    \n    return [\n        { payload: metalCount, topic: \"metal\" },   // Out 1: SP Kim loại\n        { payload: metalCount, topic: \"total\" },   // Out 2: Tổng sản phẩm\n        { payload: true, topic: \"trigger\" }        // Out 3: Kích hoạt Solenoid\n    ];\n}\n\nif (!isMetal) context.set('lastMetalState', false);\n\nreturn null;\n"
    },
