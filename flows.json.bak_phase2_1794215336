ant;\n    }\n    .overview-main-grid {\n      grid-template-columns: 1fr !important;\n      gap: 12px !important;\n    }\n    .overview-bottom-grid {\n      grid-template-columns: 1fr !important;\n      gap: 10px !important;\n    }\n  }\n\n  @media (max-width: 768px) {\n    .top-bar {\n      height: 46px !important;\n      padding: 0 10px !important;\n    }\n    .breadcrumb-sep, .breadcrumb-page {\n      display: none !important;\n    }\n    .system-title-text {\n      font-size: 11px !important;\n    }\n    .btn-estop-header {\n      padding: 5px 10px !important;\n      font-size: 9.5px !important;\n    }\n    .scada-body-layout {\n      flex-direction: column-reverse !important;\n      height: calc(100vh - 46px) !important;\n      max-height: calc(100vh - 46px) !important;\n    }\n    .scada-sidebar {\n      width: 100% !important;\n      min-width: 100% !important;\n      height: 52px !important;\n      min-height: 52px !important;\n      flex-direction: row !important;\n      border-right: none !important;\n      border-top: 1px solid var(--border-neutral) !important;\n      padding: 0 !important;\n      background: var(--sidebar-bg) !important;\n    }\n    .sidebar-nav-list {\n      flex-direction: row !important;\n      width: 100% !important;\n      justify-content: space-around !important;\n      padding: 4px 6px !important;\n    }\n    .nav-item-btn {\n      flex-direction: column !important;\n      padding: 4px 8px !important;\n      gap: 2px !important;\n      border-left: none !important;\n      border-bottom: 2px solid transparent !important;\n    }\n    .nav-item-btn.is-active {\n      border-left: none !important;\n      border-bottom: 2px solid var(--cyan-primary) !important;\n      background: rgba(40, 184, 232, 0.1) !important;\n    }\n    .nav-item-icon {\n      font-size: 15px !important;\n    }\n    .nav-item-label {\n      display: none !important;\n    }\n    .sidebar-bottom-controls {\n      display: none !important;\n    }\n    .scada-viewport {\n      padding: 10px !important;\n      height: calc(100% - 52px) !important;\n    }\n    .kpi-row-grid {\n      grid-template-columns: repeat(2, 1fr) !important;\n      gap: 8px !important;\n    }\n    .overview-main-grid {\n      grid-template-columns: 1fr !important;\n    }\n    .overview-bottom-grid {\n      grid-template-columns: 1fr !important;\n    }\n  }\n\n  @media (max-width: 430px) {\n    .kpi-row-grid {\n      grid-template-columns: 1fr !important;\n      gap: 8px !important;\n    }\n  }\n\n  @media (max-width: 600px) {\n    .control-card-body {\n      grid-template-columns: 1fr !important;\n    }\n  }\n</style>\n<div class=\"scada-command-center\" ng-init=\"activeTab = activeTab || 'overview'; monitoringSubTab = monitoringSubTab || 'analytics'; systemSubTab = systemSubTab || 'settings';\">\n\n  <!-- ============================================================== -->\n  <!-- 1. TOP BAR                                                     -->\n  <!-- ============================================================== -->\n  <header class=\"top-bar\">\n    <div class=\"top-bar-left\">\n      <div class=\"system-logo-badge\">SC</div>\n      <div class=\"system-title-text\">METAL SORTING SCADA</div>\n      <span class=\"breadcrumb-sep\">/</span>\n      <span class=\"breadcrumb-page\">{{getPageTitle(activeTab)}}</span>\n\n      <!-- Trạng thái kết nối Modbus RTU Đèn LED -->\n      <div class=\"status-pill\" ng-class=\"modbusOnline ? 'online' : 'offline'\" style=\"font-size: 8.5px; padding: 3px 8px; font-weight: 700;\">\n        <span class=\"status-dot-pulse\" ng-style=\"{'background-color': modbusOnline ? 'var(--color-success)' : 'var(--color-danger)'}\"></span>\n        <span>{{modbusOnline ? 'MODBUS RTU ONLINE' : 'MODBUS RTU OFFLINE'}}</span>\n      </div>\n    </div>\n\n    <div class=\"top-bar-right\">\n      <!-- Badge chế độ Auto / Manual -->\n      <div class=\"mode-badge\" ng-class=\"systemMode === 'AUTO' ? 'auto' : 'manual'\">\n        <span ng-if=\"systemMode === 'AUTO'\" style=\"display: inline-flex; align-items: center; gap: 5px;\">\n          <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/><!-- LỚP CHI TIẾT KỸ THUẬT NÂNG CAO (TOGGLE BỞI NÚT CHI TIẾT KỸ THUẬT) -->\n              <g id=\"cad-advanced-annotations\" ng-if=\"showTwinDetails\">\n                <!-- Thanh định tâm phôi 0-120mm -->\n                <rect x=\"70\" y=\"66\" width=\"120\" height=\"14\" fill=\"rgba(40, 184, 232, 0.08)\" stroke=\"rgba(40, 184, 232, 0.3)\" stroke-dasharray=\"2,2\" rx=\"2\"/>\n                <text x=\"130\" y=\"76\" fill=\"#8E9CAE\" font-size=\"6.5\" font-weight=\"700\" text-anchor=\"middle\">THANH ĐỊNH TÂM PHÔI (0-120mm)</text>\n\n                <!-- Cầu gá gạt nhôm định hình 370mm -->\n                <rect x=\"350\" y=\"62\" width=\"90\" height=\"16\" fill=\"rgba(39, 197, 139, 0.08)\" stroke=\"rgba(39, 197, 139, 0.3)\" stroke-dasharray=\"2,2\" rx=\"2\"/>\n                <text x=\"395\" y=\"73\" fill=\"var(--color-success)\" font-size=\"6.5\" font-weight=\"700\" text-anchor=\"middle\">CẦU GÁ GẠT NHÔM ĐỊNH HÌNH</text>\n\n                <!-- Model Solenoid & Góc gạt -->\n                <text x=\"388\" y=\"32\" fill=\"var(--cyan-primary)\" font-size=\"6\" font-weight=\"700\" font-family=\"'Consolas', monospace\">JF-0826B (Coil 0x0001) • 42°</text>\n\n                <!-- Thông số cảm biến LJ12A3 -->\n                <text x=\"165\" y=\"24\" fill=\"var(--cyan-primary)\" font-size=\"6\" font-weight=\"700\" font-family=\"'Consolas', monospace\" text-anchor=\"middle\">DI 0x0001 (IN1) NPN NO 24V</text>\n              </g>\n            </svg>\n          <span>CHẾ ĐỘ TỰ ĐỘNG</span>\n        </span>\n        <span ng-if=\"systemMode !== 'AUTO'\" style=\"display: inline-flex; align-items: center; gap: 5px;\">\n          <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 20V10M12 20V4M6 20v-6\"/></svg>\n          <span>CHẾ ĐỘ THỦ CÔNG</span>\n        </span>\n      </div>\n\n      <!-- Nút Dừng Khẩn Cấp E-STOP -->\n      <button class=\"btn-estop-header\" ng-class=\"{'tripped': isEstopTripped}\" ng-click=\"toggleEstop()\">\n        <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><rect x=\"7\" y=\"7\" width=\"10\" height=\"10\" rx=\"1.5\" fill=\"#fff\"/></svg>\n        <span ng-if=\"!isEstopTripped\">E-STOP</span>\n        <span ng-if=\"isEstopTripped\">E-STOP ĐANG KHÓA</span>\n      </button>\n    </div>\n  </header>\n\n  <!-- ============================================================== -->\n  <!-- 2. MAIN BODY: SIDEBAR + VIEWPORT                               -->\n  <!-- ============================================================== -->\n    <!-- ============================================================== -->\n    <!-- FIXED LEFT SIDEBAR (RESTRUCTURED 4 MAIN TABS)                  -->\n    <!-- ============================================================== -->\n    <div class=\"scada-body-layout\">\n    <nav class=\"scada-sidebar\" ng-class=\"{'is-collapsed': sidebarCollapsed}\">\n      <div class=\"sidebar-nav-list\">\n        <!-- 1. TỔNG QUAN (OVERVIEW & DIGITAL TWIN) -->\n        <button class=\"nav-item-btn\" ng-class=\"{'is-active': activeTab === 'overview'}\" ng-click=\"switchTab('overview')\">\n          <span class=\"nav-item-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1\"/></svg></span>\n          <span class=\"nav-item-label\" ng-if=\"!sidebarCollapsed\">Tổng quan</span>\n        </button>\n\n        <!-- 2. ĐIỀU KHIỂN THIẾT BỊ (DEVICE CONTROL) -->\n        <button class=\"nav-item-btn\" ng-class=\"{'is-active': activeTab === 'control'}\" ng-click=\"switchTab('control')\">\n          <span class=\"nav-item-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg></span>\n          <span class=\"nav-item-label\" ng-if=\"!sidebarCollapsed\">Điều khiển</span>\n        </button>\n\n        <!-- 3. GIÁM SÁT & PHÂN TÍCH (MONITORING & ANALYTICS) -->\n        <button class=\"nav-item-btn\" ng-class=\"{'is-active': activeTab === 'monitoring'}\" ng-click=\"switchTab('monitoring')\">\n          <span class=\"nav-item-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg></span>\n          <span class=\"nav-item-label\" ng-if=\"!sidebarCollapsed\">Giám sát & Phân tích</span>\n          <span class=\"nav-badge-pill badge-danger\" ng-if=\"!sidebarCollapsed && unackAlarmsCount > 0\">{{unackAlarmsCount}}</span>\n        </button>\n\n        <!-- 4. HỆ THỐNG (SYSTEM, MAINTENANCE & AUDIT) -->\n        <button class=\"nav-item-btn\" ng-class=\"{'is-active': activeTab === 'system'}\" ng-click=\"switchTab('system')\">\n          <span class=\"nav-item-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg></span>\n          <span class=\"nav-item-label\" ng-if=\"!sidebarCollapsed\">Hệ thống</span>\n        </button>\n      </div>\n\n      <div class=\"sidebar-bottom-controls\">\n        <button class=\"btn-sidebar-toggle\" ng-click=\"sidebarCollapsed = !sidebarCollapsed\">\n          <span ng-if=\"sidebarCollapsed\">▶</span>\n          <span ng-if=\"!sidebarCollapsed\">◀ Thu gọn</span>\n        </button>\n      </div>\n    </nav>\n\n    <!-- VIEWPORT CHÍNH -->\n    <main class=\"scada-viewport\">\n      <!-- ============================================================== -->\n      <!-- TAB 1: OVERVIEW (TỔNG QUAN HỆ THỐNG & DIGITAL TWIN)           -->\n      <!-- ============================================================== -->\n      <div ng-show=\"activeTab === 'overview'\">\n<!-- Hàng 4 KPI Thống nhất (Đã nâng cấp Sparkline, Tooltip, 28px Consolas & Typography) -->\n        <div class=\"kpi-row-grid\">\n          <!-- KPI 1: TỔNG SẢN LƯỢNG Fe -->\n          <div class=\"kpi-stat-card\" data-tooltip=\"Tổng số phôi kim loại Fe đã ghi nhận qua cảm biến LJ12A3 và gạt thành công vào khay.\">\n            <div class=\"kpi-card-top\">\n              <div class=\"kpi-stat-label\">\n                <span class=\"scada-icon\" style=\"color: var(--cyan-primary);\"><svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z\"/><polyline points=\"3.27 6.96 12 12.01 20.73 6.96\"/><line x1=\"12\" y1=\"22.08\" x2=\"12\" y2=\"12\"/></svg></span>\n                <span>TỔNG SẢN LƯỢNG Fe</span>\n                \n              </div>\n              <svg class=\"kpi-sparkline\" viewBox=\"0 0 68 24\">\n                <path d=\"M 0,22 Q 15,18 28,14 T 48,10 T 68,4\" fill=\"none\" stroke=\"#26C6F4\" stroke-width=\"2\"/>\n                <path d=\"M 0,22 Q 15,18 28,14 T 48,10 T 68,4 L 68,24 L 0,24 Z\" fill=\"rgba(38,198,244,0.12)\"/>\n                <circle cx=\"68\" cy=\"4\" r=\"2.5\" fill=\"#26C6F4\"/>\n              </svg>\n            </div>\n            <div class=\"kpi-card-bottom\">\n              <div class=\"kpi-stat-val\">\n                <span class=\"kpi-num\">{{feCount}}</span>\n                <span class=\"kpi-stat-unit\">phôi</span>\n              </div>\n              <div class=\"kpi-stat-sub\">Sản phẩm Fe đã phân loại</div>\n            </div>\n          </div>\n\n          <!-- KPI 2: NĂNG SUẤT VẬN HÀNH -->\n          <div class=\"kpi-stat-card\" data-tooltip=\"Tốc độ phân loại trung bình tính theo số sản phẩm hoàn tất trên mỗi phút.\">\n            <div class=\"kpi-card-top\">\n              <div class=\"kpi-stat-label\">\n                <span class=\"scada-icon\" style=\"color: var(--color-success);\"><svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg></span>\n                <span>NĂNG SUẤT VẬN HÀNH</span>\n                \n              </div>\n              <svg class=\"kpi-sparkline\" viewBox=\"0 0 68 24\">\n                <rect x=\"4\" y=\"14\" width=\"6\" height=\"10\" fill=\"rgba(49,214,160,0.3)\" rx=\"1\"/>\n                <rect x=\"15\" y=\"10\" width=\"6\" height=\"14\" fill=\"rgba(49,214,160,0.4)\" rx=\"1\"/>\n                <rect x=\"26\" y=\"8\" width=\"6\" height=\"16\" fill=\"rgba(49,214,160,0.5)\" rx=\"1\"/>\n                <rect x=\"37\" y=\"11\" width=\"6\" height=\"13\" fill=\"rgba(49,214,160,0.6)\" rx=\"1\"/>\n                <rect x=\"48\" y=\"6\" width=\"6\" height=\"18\" fill=\"rgba(49,214,160,0.8)\" rx=\"1\"/>\n                <rect x=\"59\" y=\"5\" width=\"6\" height=\"19\" fill=\"#31D6A0\" rx=\"1\"/>\n              </svg>\n            </div>\n            <div class=\"kpi-card-bottom\">\n              <div class=\"kpi-stat-val\">\n                <span class=\"kpi-num\">{{conveyorRunning ? (feCount > 0 ? '15.8' : '0.0') : '0.0'}}</span>\n                <span class=\"kpi-stat-unit\">SP/P</span>\n              </div>\n              <div class=\"kpi-stat-sub\">Tốc độ trung bình</div>\n            </div>\n          </div>\n\n          <!-- KPI 3: CHU KỲ TRUNG BÌNH (TÍNH TRÊN CÁC LẦN TEST THỰC TẾ, LOẠI TRỪ 0s) -->\n          <div class=\"kpi-stat-card\" data-tooltip=\"Thời gian hoàn thành một chu trình 3 nhịp. Chỉ tính trên các lần test thực tế, loại trừ các slot mặc định 0s.\">\n            <div class=\"kpi-card-top\">\n              <div class=\"kpi-stat-label\">\n                <span class=\"scada-icon\" style=\"color: #38bdf8;\"><svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg></span>\n                <span>CHU KỲ TRUNG BÌNH</span>\n              </div>\n              <svg class=\"kpi-sparkline\" viewBox=\"0 0 68 24\">\n                <line x1=\"0\" y1=\"12\" x2=\"68\" y2=\"12\" stroke=\"rgba(56,189,248,0.3)\" stroke-dasharray=\"2,2\"/>\n                <polyline points=\"2,14 12,11 22,13 32,12 42,10 52,12 66,12\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"2\"/>\n                <circle cx=\"66\" cy=\"12\" r=\"2.5\" fill=\"#38bdf8\"/>\n              </svg>\n            </div>\n            <div class=\"kpi-card-bottom\">\n              <div class=\"kpi-stat-val\">\n                <span class=\"kpi-num\">{{cycleCountReal > 0 ? (avgCycleTime | number:1) : '---'}}</span>\n                <span class=\"kpi-stat-unit\">giây</span>\n              </div>\n              <div class=\"kpi-stat-sub\">Định mức: 3.8s • {{cycleCountReal > 0 ? ('Độ lệch: ±' + (stdDevCycle | number:2) + 's (' + cycleCountReal + '/10)') : 'Chưa có chu kỳ test'}}</div>\n            </div>\n          </div>\n\n          <!-- KPI 4: NHIỆT ĐỘ SOLENOID -->\n          <div class=\"kpi-stat-card\" data-tooltip=\"Mô hình nhiệt động Joule cuộn hút 12VDC. Cảnh báo khi >45°C, tự động ngắt bảo vệ khi >60°C.\">\n            <div class=\"kpi-card-top\">\n              <div class=\"kpi-stat-label\">\n                <span class=\"scada-icon\" ng-style=\"{'color': solenoidTemp >= 60 ? 'var(--color-danger)' : (solenoidTemp >= 45 ? 'var(--color-warning)' : 'var(--color-success)')}\"><svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z\"/></svg></span>\n                <span>NHIỆT ĐỘ SOLENOID</span>\n              </div>\n              <svg class=\"kpi-sparkline\" viewBox=\"0 0 68 24\">\n                <path d=\"M 0,20 Q 25,18 40,16 T 68,14\" fill=\"none\" ng-attr-stroke=\"{{solenoidTemp >= 60 ? '#FF5B68' : (solenoidTemp >= 45 ? '#f59e0b' : '#31D6A0')}}\" stroke-width=\"2\"/>\n                <circle cx=\"68\" cy=\"14\" r=\"2.5\" ng-attr-fill=\"{{solenoidTemp >= 60 ? '#FF5B68' : (solenoidTemp >= 45 ? '#f59e0b' : '#31D6A0')}}\"/>\n              </svg>\n            </div>\n            <div class=\"kpi-card-bottom\">\n              <div class=\"kpi-stat-val\">\n                <span class=\"kpi-num\" ng-style=\"{'color': solenoidTemp >= 60 ? 'var(--color-danger)' : (solenoidTemp >= 45 ? 'var(--color-warning)' : 'var(--color-success)')}\">{{solenoidTemp | number:1}}</span>\n                <span class=\"kpi-stat-unit\" ng-style=\"{'color': solenoidTemp >= 60 ? 'var(--color-danger)' : (solenoidTemp >= 45 ? 'var(--color-warning)' : 'var(--color-success)')}\">°C</span>\n              </div>\n              <div class=\"kpi-stat-sub\">Bình thường (&lt; 45°C)</div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Bố cục 3 vùng: Băng chuyền trung tâm (68%) + Panel trạng thái & Điều khiển nhanh (32%) -->\n        <div class=\"overview-main-grid\" style=\"display: grid; grid-template-columns: 3fr 2fr; gap: 14px; margin-bottom: 14px; align-items: stretch;\">\n          <!-- Khung Băng chuyền Hero 2D Digital Twin -->\n          <div class=\"card-panel\" style=\"padding: 12px; display: flex; flex-direction: column; justify-content: 