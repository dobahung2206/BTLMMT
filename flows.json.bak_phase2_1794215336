n-items: center; gap: 6px;\">\n                      <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/></svg>\n                      <span>DỪNG MOTOR</span>\n                    </span>\n                  </button>\n                  <button class=\"btn-cmd warning\" ng-click=\"toggleMode()\" style=\"justify-content: center;\">\n                    <span ng-if=\"systemMode === 'AUTO'\" style=\"display: inline-flex; align-items: center; gap: 6px;\">\n                      <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 20V10M12 20V4M6 20v-6\"/></svg>\n                      <span>CHUYỂN THỦ CÔNG</span>\n                    </span>\n                    <span ng-if=\"systemMode !== 'AUTO'\" style=\"display: inline-flex; align-items: center; gap: 6px;\">\n                      <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"3\"/><path d=\"M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z\"/></svg>\n                      <span>SANG TỰ ĐỘNG</span>\n                    </span>\n                  </button>\n                </div>\n                <button class=\"btn-cmd primary\" style=\"width: 100%; justify-content: center; gap: 6px;\" ng-click=\"switchTab('control')\">\n                  <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"6\" y1=\"3\" x2=\"6\" y2=\"15\"/><circle cx=\"18\" cy=\"6\" r=\"3\"/><circle cx=\"6\" cy=\"18\" r=\"3\"/><path d=\"M18 9a9 9 0 0 1-9 9\"/></svg>\n                  <span>MỞ TRUNG TÂM ĐIỀU KHIỂN CHI TIẾT</span>\n                  <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"7\" y1=\"17\" x2=\"17\" y2=\"7\"/><polyline points=\"7 7 17 7 17 17\"/></svg>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Hàng dưới: 3 Panel thông tin rút gọn -->\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px;\">\n          <!-- Biểu đồ nhỏ sản lượng gần đây -->\n          <div class=\"card-panel\" style=\"padding: 10px 14px;\">\n            <div class=\"section-header-row\" style=\"margin-bottom: 6px;\">\n              <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/></svg></span><span>HIỆU SUẤT 10 CHU KỲ</span></div>\n              <span style=\"font-size: 8px; color: var(--cyan-primary); cursor: pointer;\" ng-click=\"switchTab('monitoring', 'analytics')\">Chi tiết ↗</span>\n            </div>\n            <div style=\"height: 60px; display: flex; align-items: flex-end; gap: 4px; padding-top: 6px;\">\n              <div ng-repeat=\"bar in cycleBars track by $index\" style=\"flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center;\">\n                <div style=\"width: 100%; background: linear-gradient(180deg, var(--cyan-primary), #0284c7); border-radius: 2px 2px 0 0;\" ng-style=\"{'height': bar.h + '%'}\"></div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Cảnh báo mới nhất (Đồng bộ nhiệt độ thực tế, KHÔNG phát sinh ALM-THRM-001 khi nhiệt < 45°C) -->\n          <div class=\"card-panel\" style=\"padding: 10px 14px;\">\n            <div class=\"section-header-row\" style=\"margin-bottom: 6px;\">\n              <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg></span><span>LỊCH SỬ 5 SỰ KIỆN GẦN NHẤT</span></div>\n              <a href=\"\" ng-click=\"switchTab('monitoring', 'alarms')\" style=\"font-size: 8px; color: var(--cyan-primary); text-decoration: none;\">Xem Alarms ({{unackAlarmsCount}}) ↗</a>\n            </div>\n            <!-- 5 Sự kiện gần nhất -->\n            <div style=\"display: flex; flex-direction: column; gap: 4px; font-size: 8.5px;\">\n              <div ng-repeat=\"evt in recentEvents | limitTo:5\" style=\"display: flex; justify-content: space-between; align-items: center; padding: 3px 6px; background: var(--panel-secondary); border-radius: 4px; border-left: 3px solid;\" ng-style=\"{'border-left-color': evt.type === 'danger' ? 'var(--color-danger)' : (evt.type === 'warn' ? 'var(--color-warning)' : 'var(--cyan-primary)')}\">\n                <div style=\"display: flex; align-items: center; gap: 6px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;\">\n                  <span style=\"font-family: var(--font-mono); color: var(--text-muted); font-size: 7.5px;\">{{evt.time}}</span>\n                  <span class=\"status-pill\" ng-class=\"evt.type === 'danger' ? 'danger' : (evt.type === 'warn' ? 'warning' : 'online')\" style=\"font-size: 7px; padding: 1px 4px;\">{{evt.cat}}</span>\n                  <span style=\"color: var(--text-primary); font-size: 8px;\">{{evt.text}}</span>\n                </div>\n                <span style=\"font-size: 7px; color: var(--text-muted); font-family: var(--font-mono);\">OK</span>\n              </div>\n            </div>\n          </div>\n\n                    <!-- Card 3: CẢNH BÁO ĐANG HOẠT ĐỘNG (ACTIVE ALARMS) -->\n          <div class=\"card-panel\" style=\"padding: 10px 14px;\">\n            <div class=\"section-header-row\" style=\"margin-bottom: 6px;\">\n              <div class=\"section-title\" style=\"display: flex; align-items: center; gap: 6px;\">\n                <span class=\"scada-icon\" style=\"color: var(--color-danger);\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/></svg></span>\n                <span>CẢNH BÁO ĐANG HOẠT ĐỘNG (ACTIVE ALARMS)</span>\n                <span class=\"nav-badge-pill badge-danger\" ng-if=\"unackAlarmsCount > 0\" style=\"margin-left: 4px; font-size: 7.5px;\">{{unackAlarmsCount}} CẦN XỬ LÝ</span>\n              </div>\n              <a href=\"javascript:void(0)\" ng-click=\"switchTab('monitoring', 'alarms')\" style=\"font-size: 8px; color: var(--cyan-primary); text-decoration: none; font-weight: 700;\">Xem tất cả ↗</a>\n            </div>\n\n            <!-- Khi không có cảnh báo nghiêm trọng -->\n            <div ng-if=\"unackAlarmsCount === 0\" style=\"display: flex; flex-direction: column; align-items: center; justify-content: center; height: 78px; gap: 4px; background: rgba(49, 214, 160, 0.03); border: 1px dashed rgba(49, 214, 160, 0.25); border-radius: 6px;\">\n              <div style=\"display: flex; align-items: center; gap: 6px; color: var(--color-success); font-weight: 800; font-size: 10px;\">\n                <svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg>\n                <span>HỆ THỐNG HOẠT ĐỘNG BÌNH THƯỜNG</span>\n              </div>\n              <div style=\"font-size: 8px; color: var(--text-muted); font-family: var(--font-mono);\">\n                Tất cả thiết bị sẵn sàng • 0 cảnh báo tồn đọng\n              </div>\n            </div>\n\n            <!-- Khi có cảnh báo active -->\n            <div ng-if=\"unackAlarmsCount > 0\" style=\"display: flex; flex-direction: column; gap: 4px; max-height: 85px; overflow-y: auto;\">\n              <div ng-repeat=\"alm in alarmsList | filter:{active: true} | limitTo:3\" style=\"background: rgba(255, 91, 104, 0.08); border-left: 3px solid var(--color-danger); border-radius: 4px; padding: 4px 6px; display: flex; justify-content: space-between; align-items: center;\">\n                <div>\n                  <div style=\"display: flex; align-items: center; gap: 5px;\">\n                    <span class=\"cmd-badge cmd-stop\" style=\"font-size: 7px; padding: 1px 4px;\">{{alm.code}}</span>\n                    <span style=\"font-weight: 700; color: #fff; font-size: 8.5px;\">{{alm.desc}}</span>\n                  </div>\n                  <div style=\"font-size: 7.5px; color: var(--text-muted); margin-top: 1px;\">Khắc phục: {{alm.remedy}}</div>\n                </div>\n                <button class=\"btn-cmd warning\" style=\"padding: 2px 6px; font-size: 7.5px;\" ng-click=\"ackAlarm(alm)\">Xác nhận</button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- ============================================================== -->\n      <!-- TAB 2: DEVICE CONTROL (TRUNG TÂM ĐIỀU KHIỂN THIẾT BỊ)          -->\n      <!-- ============================================================== -->\n      <div ng-show=\"activeTab === 'control'\">\n<div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;\">\n\n          <!-- Card 1: Điều khiển Motor 24VDC -->\n          <div class=\"card-panel\">\n            <div class=\"section-header-row\">\n              <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\"/><line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\"/><line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\"/><line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\"/><line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\"/><line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\"/><line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\"/></svg></span><span>ĐIỀU KHIỂN ĐỘNG CƠ BĂNG TẢI (MOTOR 24V)</span></div>\n              <span class=\"status-pill\" ng-class=\"conveyorRunning ? 'online' : 'offline'\">{{conveyorRunning ? 'RUNNING' : 'STOPPED'}}</span>\n            </div>\n            <div style=\"font-size: 9.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">\n              Động cơ giảm tốc 24VDC kéo băng tải qua rulo chủ động. Đã tích hợp khóa liên động: chặn lệnh chạy khi đang kích hoạt E-STOP.\n            </div>\n\n                        <div ng-if=\"isEstopTripped\" style=\"padding: 6px 12px; background: rgba(255,91,104,0.15); border: 1.5px solid var(--color-danger); border-radius: 6px; font-size: 9px; color: var(--color-danger); margin-bottom: 10px; display: flex; align-items: center; gap: 8px;\">\n              <span style=\"font-size: 13px;\">⚠️</span>\n              <span><b>KHÓA LIÊN ĐỘNG AN TOÀN:</b> Không cho phép khởi động do đang kích hoạt E-STOP. Hãy mở khóa E-STOP trên thanh Topbar trước khi cấp điện cho động cơ.</span>\n            </div>\n            <div style=\"display: flex; gap: 10px; margin-bottom: 12px;\">\n              <button class=\"btn-cmd success\" style=\"flex: 1; justify-content: center; padding: 12px;\" ng-click=\"setMotor(true)\" ng-disabled=\"conveyorRunning || isEstopTripped\" ng-class=\"{'disabled': conveyorRunning || isEstopTripped}\">\n                <span>▶ KHỞI ĐỘNG (START)</span>\n              </button>\n              <button class=\"btn-cmd danger\" style=\"flex: 1; justify-content: center; padding: 12px;\" ng-click=\"setMotor(false)\" ng-disabled=\"!conveyorRunning\" ng-class=\"{'disabled': !conveyorRunning}\">\n                <span>⏹ DỪNG LẠI (STOP)</span>\n              </button>\n            </div>\n\n            <!-- Chuẩn hóa 4 tầng trạng thái công nghiệp: Command, Feedback, Actual, Interlock -->\n            <table class=\"four-tier-table\">\n              <tr>\n                <td class=\"four-tier-label\">1. COMMAND STATE:</td>\n                <td class=\"four-tier-val\"><span style=\"color: var(--cyan-primary);\">COIL 0x0000 = {{conveyorRunning ? '1 (START)' : '0 (STOP)'}}</span></td>\n              </tr>\n              <tr>\n                <td class=\"four-tier-label\">2. FEEDBACK STATE:</td>\n                <td class=\"four-tier-val\"><span ng-style=\"{'color': !modbusOnline ? 'var(--color-warning)' : (conveyorRunning ? 'var(--color-success)' : 'var(--text-muted)')}\">{{!modbusOnline ? '⚠️ MẤT TÍN HIỆU MODBUS (Dữ liệu cache không xác thực)' : (conveyorRunning ? 'RUNNING (Quay 180 RPM)' : 'STOPPED (Đã ngắt)')}}</span></td>\n              </tr>\n              <tr>\n                <td class=\"four-tier-label\">3. ACTUAL STATE:</td>\n                <td class=\"four-tier-val\">Động cơ 24VDC tiếp điểm Relay Ch.1 {{conveyorRunning ? 'ĐÓNG (ENERGIZED)' : 'MỞ (DE-ENERGIZED)'}}</td>\n              </tr>\n              <tr>\n                <td class=\"four-tier-label\">4. INTERLOCK STATE:</td>\n                <td class=\"four-tier-val\">\n                  <span ng-if=\"!isEstopTripped\" style=\"color: var(--color-success);\">✓ E-STOP PERMISSIVE (CHO PHÉP CHẠY)</span>\n                  <span ng-if=\"isEstopTripped\" style=\"color: var(--color-danger);\">▲ KHÓA LIÊN ĐỘNG: E-STOP TRIPPED</span>\n                </td>\n              </tr>\n            </table>\n          </div>\n\n          <!-- Card 2: Chế độ vận hành (Operation Mode) -->\n          <div class=\"card-panel\">\n            <div class=\"section-header-row\">\n              <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 14.5L12 19l8-4.5\"/><path d=\"M4 9.5L12 14l8-4.5\"/><path d=\"M12 2L4 6.5l8 4.5 8-4.5L12 2z\"/></svg></span><span>CHẾ ĐỘ VẬN HÀNH (OPERATION MODE)</span></div>\n              <span class=\"mode-badge\" ng-class=\"systemMode === 'AUTO' ? 'auto' : 'manual'\">{{systemMode}}</span>\n            </div>\n            <div style=\"font-size: 9.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">\n              - <b>TỰ ĐỘNG (AUTO):</b> Cảm biến LJ12A3 tự động phát hiện phôi và kích hoạt chu kỳ gạt.<br>\n              - <b>THỦ CÔNG (MANUAL):</b> Cho phép kỹ sư kiểm tra thiết bị qua nút nhấn giữ Solenoid.\n            </div>\n\n            <div style=\"display: flex; gap: 10px; margin-bottom: 12px;\">\n              <button class=\"btn-cmd primary\" style=\"flex: 1; justify-content: center; padding: 12px;\" ng-click=\"setMode('AUTO')\" ng-class=\"{'disabled': systemMode === 'AUTO'}\">\n                <span>⚙ CHẾ ĐỘ TỰ ĐỘNG</span>\n              </button>\n              <button class=\"btn-cmd warning\" style=\"flex: 1; justify-content: center; padding: 12px;\" ng-click=\"setMode('MANUAL')\" ng-class=\"{'disabled': systemMode === 'MANUAL'}\">\n                <span>🖐 CHẾ ĐỘ THỦ CÔNG</span>\n              </button>\n            </div>\n\n            <div style=\"background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px; font-size: 8.5px; color: var(--color-warning);\">\n              <span>⚠ Chú ý: Ở chế độ TỰ ĐỘNG, các nút kích thử nghiệm Solenoid sẽ bị khóa để bảo đảm an toàn.</span>\n            </div>\n          </div>\n\n          <!-- Card 3: Điều khiển Solenoid (Momentary Dead-man Switch) -->\n          <div class=\"card-panel\">\n            <div class=\"section-header-row\">\n              <div class=\"section-title\"><span class=\"section-title-icon\">⚡</span><span>ĐIỀU KHIỂN CƠ CẤU GẠT SOLENOID (DEAD-MAN SWITCH)</span></div>\n              <span class=\"status-pill\" ng-class=\"solenoidActive ? 'online' : 'offline'\">{{solenoidActive ? 'ACTIVE (42°)' : 'STANDBY (0°)'}}</span>\n            </div>\n            <div style=\"font-size: 9.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">\n              Nút momentary dead-man: <b>Nhấn giữ để thụt Solenoid, nhả chuột/tay để thu hồi</b>. Tích hợp watchdog 2.0s tự động ngắt an toàn chống cháy cuộn dây.\n            </div>\n\n            <!-- Nút Dead-man Switch chính -->\n            <button class=\"btn-cmd\"\n                    id=\"btn-control-deadman\"\n                    style=\"width: 100%; justify-content: center; padding: 14px; font-size: 11px; margin-bottom: 10px;\"\n                    ng-style=\"systemMode === 'MANUAL' ? (solenoidHeld ? {'background': 'var(--color-danger)', 'color': '#ffffff', 'border-color': '#f87171', 'box-shadow': '0 0 16px rgba(255,91,104,0.7)'} : {'background': 'rgba(38,198,244,0.2)', 'color': 'var(--cyan-primary)', 'border-color': 'var(--cyan-primary)', 'cursor': 'pointer'}) : {'opacity': '0.35', 'cursor': 'not-allowed', 'background': 'var(--panel-secondary)', 'border-color': 'var(--border-neutral)', 'color': 'var(--text-muted)'}\"\n                    ng-disabled=\"systemMode !== 'MANUAL'\"\n                    ng-mousedown=\"onSolenoidPressDown($event)\"\n                    ng-mouseup=\"onSolenoidPressUp($event)\"\n                    ng-mouseleave=\"onSolenoidPressUp($event)\">\n              <span ng-if=\"!solenoidHeld\">🖐 NHẤN & GIỮ ĐỂ THỤT SOLENOID (NHẢ RA ĐỂ NHẢ)</span>\n              <span ng-if=\"solenoidHeld\">🔴 ĐANG GIỮ: SOLENOID ĐANG THỤT (ON)</span>\n            </button>\n\n            <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px;\">\n              <button class=\"btn-cmd warning\" style=\"justify-content: center; padding: 8px;\" ng-click=\"testKickSolenoid()\" ng-disabled=\"systemMode !== 'MANUAL'\" ng-class=\"{'disabled': systemMode !== 'MANUAL'}\">\n                <span>⚡ TEST KÍCH XUNG 0.8S</span>\n              </button>\n              <button class=\"btn-cmd primary\" style=\"justify-content: center; padding: 8px;\" ng-click=\"emergencyCooling()\">\n                <span>🛡 LÀM NGUỘI VỀ 30°C</span>\n              </button>\n            </div>\n\n            <!-- Chuẩn hóa 4 tầng trạng thái Solenoid -->\n            <table class=\"four-tier-table\">\n              <tr>\n                <td class=\"four-tier-label\">1. COMMAND STATE:</td>\n                <td class=\"four-tier-val\"><span style=\"color: var(--cyan-primary);\">COIL 0x0001 = {{solenoidActive ? '1 (ENERGIZED)' : '0 (DE-ENERGIZED)'}}</span></td>\n              </tr>\n              <tr>\n                <td class=\"four-tier-label\">2. FEEDBACK STATE:</td>\n                <td class=\"four-tier-val\"><span ng-style=\"{'color': solenoidActive ? 'var(--color-danger)' : 'var(--text-muted)'}\">{{solenoidActive ? 'ACTUATING (Gạt phôi 42°)' : 'STANDBY (Chờ 0°)'}}</span></td>\n              </tr>\n              <tr>\n                <td class=\"four-tier-label\">3. ACTUAL STATE:</td>\n                <td class=\"four-tier-val\">JF-0826B 12V {{solenoidActive ? 'Cuộn hút ON • Hành trình 10mm' : 'Lò xo thu hồi • Nghỉ'}} (Nhiệt độ {{solenoidTemp | number:1}}°C)</td>\n              </tr>\n              <tr>\n                <td class=\"four-tier-label\">4. INTERLOCK STATE:</td>\n                <td class=\"four-tier-val\">\n                  <span ng-if=\"systemMode === 'MANUAL' && solenoidTemp < 60\" style=\"color: var(--color-success);\">✓ PERMISSIVE: THỦ CÔNG (WATCHDOG 2.0s HOẠT ĐỘNG)</span>\n                  <span ng-if=\"systemMode === 'AUTO'\" style=\"color: var(--color-warning);\">⚠ AUTO LOCKOUT: KHÓA NÚT THỦ CÔNG KHI TỰ ĐỘNG</span>\n                  <span ng-if=\"solenoidTemp >= 60\" style=\"color: var(--color-danger);\">▲ THERMAL TRIP: QUÁ NHIỆT KHÓA KÍCH</span>\n                </td>\n              </tr>\n            </table>\n          </div>\n\n          <!-- Card 4: Quản lý Reset & Xóa số liệu -->\n          <div class=\"card-panel\">\n            <div class=\"section-header-row\">\n              <div class=\"section-title\"><span class=\"section-title-icon\">🗑</span><span>RESET SỐ LIỆU CHỌN LỌC & FACTORY CLEAR</span></div>\n            </div>\n            <div style=\"font-size: 9.5px; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.4;\">\n              Các thao tác reset được phân tách rõ ràng để tránh xóa nhầm dữ liệu trong ca sản xuất:\n            </div>\n\n            <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px;\">\n              <button class=\"btn-cmd primary\" style=\"justify-content: center; padding: 8px;\" ng-click=\"resetSelective('metal')\">\n                <span>Fe</span><span>XÓA ĐẾM PHÔI (VỀ 0)</span>\n              </button>\n              <button class=\"btn-cmd primary\" style=\"justify-content: center; padding: 8px;\" ng-click=\"resetSelective('stats')\">\n                <span>⏱</span><span>XÓA CHU KỲ TB</span>\n              </button>\n              <button class=\"btn-cmd warning\" style=\"justify-content: center; padding: 8px;\" ng-click=\"resetSelective('thermal')\">\n                <span>🛡</span><span>XÓA BÁO NHIỆT (30°C)</span>\n              </button>\n              <button class=\"btn-cmd primary\" style=\"justify-content: center; padding: 8px;\" ng-click=\"resetSelective('chart')\">\n                <span>📊</span><span>XÓA BIỂU ĐỒ</span>\n              </button>\n            </div>\n\n            <button class=\"btn-cmd danger\" style=\"width: 100%; justify-content: center; padding: 10px;\" ng-click=\"triggerFactoryClear()\">\n              <span>▲ RESET TOÀN BỘ SỐ LIỆU (FACTORY CLEAR)</span>\n            </button>\n          </div>\n\n        </div>\n      </div>\n\n      <!-- ============================================================== -->\n      <!-- TAB 3: MONITORING & ANALYTICS (GIÁM SÁT & PHÂN TÍCH TỔNG HỢP)    -->\n      <!-- ============================================================== -->\n      <div ng-show=\"activeTab === 'monitoring'\">\n        <!-- Secondary Subtab Navigation Bar -->\n        <div class=\"secondary-subtab-bar\">\n          <button class=\"subtab-pill\" ng-class=\"{'is-active': monitoringSubTab === 'analytics'}\" ng-click=\"monitoringSubTab = 'analytics'\">\n            <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/></svg>\n            <span>A. PHÂN TÍCH SẢN XUẤT (ANALYTICS)</span>\n          </button>\n          <button class=\"subtab-pill\" ng-class=\"{'is-active': monitoringSubTab === 'modbus'}\" ng-click=\"monitoringSubTab = 'modbus'\">\n            <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg>\n            <span>B. TRUYỀN THÔNG MODBUS RTU (SNIFFER)</span>\n          </button>\n          <button class=\"subtab-pill\" ng-class=\"{'is-active': monitoringSubTab === 'alarms'}\" ng-click=\"monitoringSubTab = 'alarms'\">\n            <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/></svg>\n            <span>C. QUẢN LÝ CẢNH BÁO & SỰ KIỆN (ALARMS)</span>\n            <span class=\"nav-badge-pill badge-danger\" ng-if=\"unackAlarmsCount > 0\" style=\"margin-left: 4px;\">{{unackAlarmsCount}}</span>\n          </button>\n        </div>\n\n        <!-- KHU VỰC A: PHÂN TÍCH SẢN XUẤT -->\n        <div ng-show=\"monitoringSubTab === 'analytics'\">\n<div class=\"card-panel\" style=\"margin-bottom: 14px;\">\n          <div class=\"section-header-row\">\n            <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"18\" y1=\"20\" x2=\"18\" y2=\"10\"/><line x1=\"12\" y1=\"20\" x2=\"12\" y2=\"4\"/><line x1=\"6\" y1=\"20\" x2=\"6\" y2=\"14\"/></svg></span><span>PHÂN TÍCH HIỆU SUẤT VẬN HÀNH & NĂNG SUẤT CHU KỲ</span></div>\n            <div style=\"display: flex; gap: 10px;\">\n              <button class=\"btn-cmd success\" ng-click=\"exportAnalyticsCSV()\">\n                <span>📥 XUẤT BÁO CÁO HIỆU SUẤT CA SẢN XUẤT (CSV)</span>\n              </button>\n            </div>\n          </div>\n\n          <!-- BỘ LỌC THỐNG KÊ (SHIFT & DATE RANGE FILTER) -->\n          <div class=\"filter-pill-row\" style=\"background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-neutral); margin-bottom: 12px;\">\n            <span style=\"font-size: 8.5px; color: var(--text-muted); font-weight: 700;\">CA SẢN XUẤT:</span>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': analyticsShiftFilter === 'ALL'}\" ng-click=\"analyticsShiftFilter = 'ALL'\">TẤT CẢ CÁC CA</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': analyticsShiftFilter === 'SHIFT1'}\" ng-click=\"analyticsShiftFilter = 'SHIFT1'\">CA 1 (06:00 - 14:00)</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': analyticsShiftFilter === 'SHIFT2'}\" ng-click=\"analyticsShiftFilter = 'SHIFT2'\">CA 2 (14:00 - 22:00)</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': analyticsShiftFilter === 'SHIFT3'}\" ng-click=\"analyticsShiftFilter = 'SHIFT3'\">CA 3 (22:00 - 06:00)</button>\n\n            <span style=\"font-size: 8.5px; color: var(--text-muted); font-weight: 700; margin-left: 10px;\">THỜI GIAN:</span>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': analyticsDateFilter === 'TODAY'}\" ng-click=\"analyticsDateFilter = 'TODAY'\">HÔM NAY</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': analyticsDateFilter === '24H'}\" ng-click=\"analyticsDateFilter = '24H'\">24 GIỜ QUA</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': analyticsDateFilter === '7D'}\" ng-click=\"analyticsDateFilter = '7D'\">7 NGÀY QUA</button>\n          </div>\n\n          <!-- 4 THẺ TÓM TẮT CHỈ SỐ SẢN XUẤT & KHẢ DỤNG OEE -->\n          <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 14px;\">\n            <div style=\"background: var(--panel-secondary); border: 1px solid var(--border-neutral); border-radius: 6px; padding: 10px;\">\n              <div style=\"font-size: 8px; color: var(--text-muted); font-weight: 700;\">TỶ LỆ PHÂN LOẠI Fe / NON-Fe</div>\n              <div style=\"font-size: 16px; font-weight: 900; color: var(--cyan-primary); font-family: var(--font-mono); margin: 3px 0;\">\n                85.7% <span style=\"font-size: 9px; color: var(--text-secondary);\">Fe</span>\n              </div>\n              <div style=\"font-size: 7.5px; color: var(--text-secondary);\">Fe: 24 phôi • Non-Fe: 4 phôi</div>\n            </div>\n            <div style=\"background: var(--panel-secondary); border: 1px solid var(--border-neutral); border-radius: 6px; padding: 10px;\">\n              <div style=\"font-size: 8px; color: var(--text-muted); font-weight: 700;\">TÍNH KHẢ DỤNG OEE (AVAILABILITY)</div>\n              <div style=\"font-size: 16px; font-weight: 900; color: var(--color-success); font-family: var(--font-mono); margin: 3px 0;\">\n                94.2% <span style=\"font-size: 9px; color: var(--color-success);\">ĐẠT</span>\n              </div>\n              <div style=\"font-size: 7.5px; color: var(--text-secondary);\">Chạy: 142.5h • Dừng: 8.8h</div>\n            </div>\n            <div style=\"background: var(--panel-secondary); border: 1px solid var(--border-neutral); border-radius: 6px; padding: 10px;\">\n              <div style=\"font-size: 8px; color: var(--text-muted); font-weight: 700;\">CHU KỲ TB & ĐỘ LỆCH CHUẨN</div>\n              <div style=\"font-size: 16px; font-weight: 900; color: #ffffff; font-family: var(--font-mono); margin: 3px 0;\">\n                3.82s <span style=\"font-size: 9px; color: var(--color-warning);\">±0.15s</span>\n              </div>\n              <div style=\"font-size: 7.5px; color: var(--text-secondary);\">Min: 3.50s • Max: 4.20s</div>\n            </div>\n            <div style=\"background: var(--panel-secondary); border: 1px solid var(--border-neutral); border-radius: 6px; padding: 10px;\">\n              <div style=\"font-size: 8px; color: var(--text-muted); font-weight: 700;\">SỐ LẦN DẬP SOLENOID</div>\n              <div style=\"font-size: 16px; font-weight: 900; color: var(--color-warning); font-family: var(--font-mono); margin: 3px 0;\">\n                1,280 <span style=\"font-size: 9px; color: var(--text-secondary);\">lần</span>\n              </div>\n              <div style=\"font-size: 7.5px; color: var(--text-secondary);\">Tần suất: 15.2 lần/giờ • Quá tải: 0</div>\n            </div>\n          </div>\n\n          <!-- Biểu đồ cột 10 chu kỳ -->\n          <div style=\"background: var(--panel-secondary); border: 1px solid var(--border-neutral); border-radius: 8px; padding: 16px; margin-bottom: 14px;\">\n            <div style=\"display: flex; justify-content: space-between; font-size: 10px; color: var(--text-secondary); margin-bottom: 10px;\">\n              <span>BIỂU ĐỒ THỜI GIAN 10 CHU KỲ GẦN NHẤT (GIÂY)</span>\n              <span style=\"color: var(--color-warning);\">--- Đường chuẩn tối ưu: 3.8s</span>\n            </div>\n\n            <div style=\"height: 120px; display: flex; align-items: flex-end; gap: 8px; position: relative;\">\n              <div style=\"position: absolute; left: 0; right: 0; bottom: 50%; border-top: 1.5px dashed var(--color-warning); pointer-events: none;\"></div>\n              <div ng-repeat=\"bar in cycleBars track by $index\" style=\"flex: 1; height: 100%; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 4px;\">\n                <span style=\"font-size: 8px; color: var(--text-primary); font-family: var(--font-mono);\">{{bar.val}}s</span>\n                <div style=\"width: 100%; background: linear-gradient(180deg, var(--cyan-primary), #0284c7); border-radius: 3px 3px 0 0;\" ng-style=\"{'height': bar.h + '%'}\"></div>\n                <span style=\"font-size: 7.5px; color: var(--text-muted);\">#{{$index + 1}}</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Bảng số liệu chi tiết các chu kỳ -->\n          <div class=\"scada-table-wrap\">\n            <table class=\"scada-table\">\n              <thead>\n                <tr>\n                  <th>LẦN THỨ</th>\n                  <th>THỜI GIAN GẠT (S)</th>\n                  <th>CHỈ TIÊU (S)</th>\n                  <th>ĐỘ LỆCH (S)</th>\n                  <th>ĐÁNH GIÁ CHẤT LƯỢNG</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr ng-repeat=\"bar in cycleBars track by $index\">\n                  <td>#{{$index + 1}}</td>\n                  <td style=\"font-family: var(--font-mono); font-weight: 700; color: var(--cyan-primary);\">{{bar.val}}s</td>\n                  <td style=\"font-family: var(--font-mono);\">3.8s</td>\n                  <td style=\"font-family: var(--font-mono);\" ng-style=\"{'color': bar.val > 3.8 ? 'var(--color-warning)' : 'var(--color-success)'}\">\n                    {{bar.val > 3.8 ? '+' + (bar.val - 3.8 | number:1) : (bar.val - 3.8 | number:1)}}s\n                  </td>\n                  <td><span class=\"status-pill online\" style=\"font-size: 8px; padding: 1px 6px;\">ĐẠT CHUẨN</span></td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n        </div>\n\n        <!-- KHU VỰC B: MODBUS MONITOR -->\n        <div ng-show=\"monitoringSubTab === 'modbus'\">\n<div class=\"card-panel\">\n          <div class=\"section-header-row\">\n            <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"22 12 18 12 15 21 9 3 6 12 2 12\"/></svg></span><span>MODBUS RTU PACKET SNIFFER & TRAFFIC MONITOR (COM4)</span></div>\n            <div style=\"display: flex; gap: 8px;\">\n              <button class=\"btn-cmd primary\" style=\"padding: 4px 10px; font-size: 9px;\" ng-click=\"toggleModbusPause()\">\n                <span ng-if=\"!isModbusPaused\">⏸ Tạm dừng feed</span>\n                <span ng-if=\"isModbusPaused\">▶ Tiếp tục feed</span>\n              </button>\n              <button class=\"btn-cmd warning\" style=\"padding: 4px 10px; font-size: 9px;\" ng-click=\"clearModbusLogs()\">\n                <span>🗑 Xóa log</span>\n              </button>\n              <button class=\"btn-cmd success\" style=\"padding: 4px 10px; font-size: 9px;\" ng-click=\"exportModbusCSV()\">\n                <span>📥 Xuất CSV</span>\n              </button>\n            </div>\n          </div>\n\n          <!-- BẢNG GIÁM SÁT THANH GHI THỜI GIAN THỰC (LIVE REGISTER WATCH) -->\n          <div style=\"margin-bottom: 12px;\">\n            <div style=\"font-size: 9px; font-weight: 700; color: var(--text-secondary); margin-bottom: 6px; display: flex; justify-content: space-between;\">\n              <span>LIVE REGISTER WATCH (BẢNG THANH GHI THỜI GIAN THỰC ĐÃ XÁC THỰC)</span>\n              <span style=\"font-family: var(--font-mono); color: var(--cyan-primary);\">POLL RATE: 150ms • SLAVE: 0xFF / 0x01</span>\n            </div>\n            <div class=\"reg-watch-grid\">\n              <div class=\"reg-watch-card\">\n                <div class=\"reg-watch-addr\">COIL 0x0000 [R/W]</div>\n                <div class=\"reg-watch-label\">Động cơ băng chuyền 24V</div>\n                <div class=\"reg-watch-val\" ng-style=\"{'color': conveyorRunning ? 'var(--color-success)' : 'var(--text-muted)'}\">\n                  {{conveyorRunning ? '1 [RUN]' : '0 [STOP]'}}\n                </div>\n              </div>\n              <div class=\"reg-watch-card\">\n                <div class=\"reg-watch-addr\">COIL 0x0001 [R/W]</div>\n                <div class=\"reg-watch-label\">Cơ cấu Solenoid Fe</div>\n                <div class=\"reg-watch-val\" ng-style=\"{'color': solenoidActive ? 'var(--color-danger)' : 'var(--text-muted)'}\">\n                  {{solenoidActive ? '1 [ACT]' : '0 [OFF]'}}\n                </div>\n              </div>\n              <div class=\"reg-watch-card\">\n                <div class=\"reg-watch-addr\">DI 0x0000 [R]</div>\n                <div class=\"reg-watch-label\">Cảm biến từ LJ12A3 (IN1)</div>\n                <div class=\"reg-watch-val\" ng-style=\"{'color': sensorActive ? 'var(--color-warning)' : 'var(--text-muted)'}\">\n                  {{sensorActive ? '1 [DETECTED]' : '0 [IDLE]'}}\n                </div>\n              </div>\n              <div class=\"reg-watch-card\">\n                <div class=\"reg-watch-addr\">DI 0x0001 [R]</div>\n                <div class=\"reg-watch-label\">Cảm biến quang (IN2)</div>\n                <div class=\"reg-watch-val\" style=\"color: var(--text-muted);\">\n                  0 [CLEAR]\n                </div>\n              </div>\n              <div class=\"reg-watch-card\">\n                <div class=\"reg-watch-addr\">HR 0x0000 [R/W]</div>\n                <div class=\"reg-watch-label\">Bộ đếm phôi Fe</div>\n                <div class=\"reg-watch-val\" style=\"color: var(--cyan-primary);\">\n                  {{feCount}} phôi\n                </div>\n              </div>\n              <div class=\"reg-watch-card\">\n                <div class=\"reg-watch-addr\">HR 0x0001 [R]</div>\n                <div class=\"reg-watch-label\">Nhiệt độ Solenoid</div>\n                <div class=\"reg-watch-val\" ng-style=\"{'color': solenoidTemp >= 60 ? 'var(--color-danger)' : (solenoidTemp >= 45 ? 'var(--color-warning)' : 'var(--color-success)')}\">\n                  {{solenoidTemp | number:1}} °C\n                </div>\n              </div>\n              <div class=\"reg-watch-card\">\n                <div class=\"reg-watch-addr\">HR 0x0002 [R]</div>\n                <div class=\"reg-watch-label\">Chu kỳ trung bình</div>\n                <div class=\"reg-watch-val\" style=\"color: var(--cyan-primary);\">\n                  3.80 giây\n                </div>\n              </div>\n              <div class=\"reg-watch-card\">\n                <div class=\"reg-watch-addr\">HR 0x0003 [R]</div>\n                <div class=\"reg-watch-label\">Trạng thái máy SCADA</div>\n                <div class=\"reg-watch-val\" style=\"color: var(--color-success);\">\n                  {{isEstopTripped ? '0x02 [TRIPPED]' : (conveyorRunning ? '0x01 [RUNNING]' : '0x00 [STANDBY]')}}\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- BỘ LỌC GÓI TIN MODBUS (DIR & FUNCTION CODE & REGISTER SEARCH) -->\n          <div class=\"filter-pill-row\" style=\"background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <span style=\"font-size: 8.5px; color: var(--text-muted); font-weight: 700;\">HƯỚNG:</span>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': modbusFilterDir === 'ALL'}\" ng-click=\"modbusFilterDir = 'ALL'\">TẤT CẢ</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': modbusFilterDir === 'TX'}\" ng-click=\"modbusFilterDir = 'TX'\">TX (GỬI)</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': modbusFilterDir === 'RX'}\" ng-click=\"modbusFilterDir = 'RX'\">RX (NHẬN)</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': modbusFilterDir === 'ERR'}\" ng-click=\"modbusFilterDir = 'ERR'\">ERROR (LỖI)</button>\n\n            <span style=\"font-size: 8.5px; color: var(--text-muted); font-weight: 700; margin-left: 10px;\">MÃ HÀM:</span>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': modbusFilterFC === 'ALL'}\" ng-click=\"modbusFilterFC = 'ALL'\">TẤT CẢ FC</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': modbusFilterFC === 'FC02'}\" ng-click=\"modbusFilterFC = 'FC02'\">FC02 (Read DI)</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': modbusFilterFC === 'FC05'}\" ng-click=\"modbusFilterFC = 'FC05'\">FC05 (Write Coil)</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': modbusFilterFC === 'FC03'}\" ng-click=\"modbusFilterFC = 'FC03'\">FC03 (Read HR)</button>\n\n            <div style=\"margin-left: auto; display: flex; align-items: center; gap: 4px;\">\n              <span style=\"font-size: 8px; color: var(--text-muted);\">TÌM KIẾM:</span>\n              <input type=\"text\" ng-model=\"modbusSearchText\" placeholder=\"Thanh ghi / Hex / Mô tả...\" style=\"background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 8.5px; width: 140px;\">\n            </div>\n          </div>\n\n          <div style=\"display: flex; justify-content: space-between; align-items: center; font-size: 9px; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 10px; background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px;\">\n            <span>PORT: <b>COM4 (9600-8N1)</b></span>\n            <span>SLAVE ID: <b>01 (Relay) / 02 (ESP8266)</b></span>\n            <span>TỔNG TX: <b>{{txCount}}</b></span>\n            <span>TỔNG RX: <b>{{rxCount}}</b></span>\n            <span>TRẠNG THÁI: <b style=\"color: var(--color-success);\">CRC VALID (100%)</b></span>\n          </div>\n\n          <!-- Bảng gói tin Modbus chi tiết -->\n          <div class=\"scada-table-wrap\" style=\"max-height: 400px; overflow-y: auto;\">\n            <table class=\"scada-table\">\n              <thead>\n                <tr>\n                  <th>THỜI GIAN</th>\n                  <th>HƯỚNG</th>\n                  <th>SLAVE</th>\n                  <th>MÃ HÀM</th>\n                  <th>ĐỊA CHỈ</th>\n                  <th>DỮ LIỆU FRAME</th>\n                  <th>KẾT QUẢ / CRC</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr ng-repeat=\"log in modbusLogs track by $index\">\n                  <td style=\"font-family: var(--font-mono);\">{{log.time}}</td>\n                  <td style=\"font-family: var(--font-mono); font-weight: 800;\" ng-style=\"{'color': log.dir === 'TX' ? 'var(--color-warning)' : 'var(--color-success)'}\">{{log.dir}}</td>\n                  <td style=\"font-family: var(--font-mono);\">{{log.slaveId}}</td>\n                  <td style=\"font-family: var(--font-mono);\">{{log.fc}}</td>\n                  <td style=\"font-family: var(--font-mono); color: var(--cyan-primary);\">{{log.addr}}</td>\n                  <td style=\"font-family: var(--font-mono);\">{{log.data}}</td>\n                  <td><span class=\"status-pill online\" style=\"font-size: 8px; padding: 1px 6px;\">{{log.status}}</span></td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n        </div>\n\n        <!-- KHU VỰC C: CẢNH BÁO & SỰ KIỆN -->\n        <div ng-show=\"monitoringSubTab === 'alarms'\">\n<div class=\"card-panel\">\n          <div class=\"section-header-row\">\n            <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9\"/><path d=\"M13.73 21a2 2 0 0 1-3.46 0\"/></svg></span><span>TRUNG TÂM CẢNH BÁO & SỰ KIỆN CÔNG NGHIỆP</span></div>\n            <div style=\"display: flex; gap: 8px;\">\n              <button class=\"btn-cmd warning\" style=\"padding: 4px 10px; font-size: 9px;\" ng-click=\"ackAllAlarms()\">\n                <svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg> <span>XÁC NHẬN TẤT CẢ (ACK ALL)</span>\n              </button>\n            </div>\n          </div>\n\n          <!-- THANH GIÁM SÁT TRUYỀN THÔNG & LỖI MẠNG (COMMUNICATION METRICS) -->\n          <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 12px; font-size: 9px;\">\n            <div style=\"background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n              <div style=\"color: var(--text-muted); font-size: 8px;\">THỜI GIAN MẤT KẾT NỐI:</div>\n              <div style=\"font-family: var(--font-mono); font-weight: 800; color: var(--color-success); margin-top: 2px;\">\n                {{modbusOnline ? '0s (Kết nối ổn định)' : formatHMS(disconnectSeconds)}}\n              </div>\n            </div>\n            <div style=\"background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n              <div style=\"color: var(--text-muted); font-size: 8px;\">SỐ LẦN RECONNECT:</div>\n              <div style=\"font-family: var(--font-mono); font-weight: 800; color: #ffffff; margin-top: 2px;\">{{reconnectCount}} lần</div>\n            </div>\n            <div style=\"background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n              <div style=\"color: var(--text-muted); font-size: 8px;\">SỐ LỖI COMM FAILURE:</div>\n              <div style=\"font-family: var(--font-mono); font-weight: 800; color: var(--color-success); margin-top: 2px;\">{{commFailureCount}} lỗi</div>\n            </div>\n            <div style=\"background: var(--panel-secondary); padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n              <div style=\"color: var(--text-muted); font-size: 8px;\">GIAO DỊCH THÀNH CÔNG CUỐI:</div>\n              <div style=\"font-family: var(--font-mono); font-weight: 800; color: var(--cyan-primary); margin-top: 2px;\">{{lastUpdateTime}}</div>\n            </div>\n          </div>\n\n          <!-- BỘ LỌC THEO NHÓM CẢNH BÁO (6 NHÓM: COMM, MOTOR, SENSOR, SOLENOID, TEMP, SAFETY) -->\n          <div class=\"filter-pill-row\">\n            <span style=\"font-size: 8.5px; color: var(--text-muted); font-weight: 700;\">NHÓM:</span>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': alarmFilterGroup === 'ALL'}\" ng-click=\"alarmFilterGroup = 'ALL'\">TẤT CẢ ({{alarmsList.length}})</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': alarmFilterGroup === 'COMM'}\" ng-click=\"alarmFilterGroup = 'COMM'\">COMMUNICATION</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': alarmFilterGroup === 'SAFETY'}\" ng-click=\"alarmFilterGroup = 'SAFETY'\">SAFETY (E-STOP)</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': alarmFilterGroup === 'THERMAL'}\" ng-click=\"alarmFilterGroup = 'THERMAL'\">TEMPERATURE</button>\n            <button class=\"filter-pill-btn\" ng-class=\"{'active': alarmFilterGroup === 'ACTUATOR'}\" ng-click=\"alarmFilterGroup = 'ACTUATOR'\">MOTOR & SOLENOID</button>\n          </div>\n\n          <div class=\"scada-table-wrap\">\n            <table class=\"scada-table\">\n              <thead>\n                <tr>\n                  <th>MÃ LỖI</th>\n                  <th>MỨC ĐỘ</th>\n                  <th>THỜI GIAN</th>\n                  <th>MÔ TẢ CẢNH BÁO</th>\n                  <th>TRẠNG THÁI</th>\n                  <th>XÁC NHẬN</th>\n                  <th>HƯỚNG DẪN XỬ LÝ (REMEDY)</th>\n                </tr>\n              </thead>\n              <tbody>\n                <tr ng-repeat=\"alm in alarmsList track by $index\">\n                  <td style=\"font-family: var(--font-mono); font-weight: 700; color: var(--cyan-primary);\">{{alm.code}}</td>\n                  <td>\n                    <span class=\"nav-badge-pill\" ng-class=\"alm.level === 'CRITICAL' ? 'badge-danger' : 'status-pill-offline'\" style=\"font-size: 8px;\">{{alm.level}}</span>\n                  </td>\n                  <td style=\"font-family: var(--font-mono);\">{{alm.time}}</td>\n                  <td>{{alm.desc}}</td>\n                  <td><b ng-style=\"{'color': alm.active ? 'var(--color-danger)' : 'var(--color-success)'}\">{{alm.active ? 'ACTIVE' : 'CLEARED'}}</b></td>\n                  <td>\n                    <button class=\"btn-cmd primary\" style=\"padding: 2px 6px; font-size: 8px;\" ng-if=\"!alm.ack\" ng-click=\"ackAlarm(alm)\">ACK</button>\n                    <span ng-if=\"alm.ack\" style=\"color: var(--text-muted); font-size: 8px;\">ĐÃ ACK</span>\n                  </td>\n                  <td style=\"color: var(--text-secondary); font-size: 9px;\">{{alm.remedy}}</td>\n                </tr>\n              </tbody>\n            </table>\n          </div>\n        </div>\n        </div>\n      </div>\n\n      <!-- ============================================================== -->\n      <!-- TAB 4: SYSTEM (HỆ THỐNG, BẢO TRÌ & AUDIT LOG)                  -->\n      <!-- ============================================================== -->\n      <div ng-show=\"activeTab === 'system'\">\n        <!-- Secondary Subtab Navigation Bar -->\n        <div class=\"secondary-subtab-bar\">\n          <button class=\"subtab-pill\" ng-class=\"{'is-active': systemSubTab === 'settings'}\" ng-click=\"systemSubTab = 'settings'\">\n            <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\"/><line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\"/><line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\"/><line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\"/><line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\"/><line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\"/><line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\"/></svg>\n            <span>A. CẤU HÌNH THÔNG SỐ (SETTINGS)</span>\n          </button>\n          <button class=\"subtab-pill\" ng-class=\"{'is-active': systemSubTab === 'maintenance'}\" ng-click=\"systemSubTab = 'maintenance'\">\n            <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg>\n            <span>B. BẢO TRÌ & SỨC KHỎE THIẾT BỊ (MAINTENANCE)</span>\n          </button>\n          <button class=\"subtab-pill\" ng-class=\"{'is-active': systemSubTab === 'audit'}\" ng-click=\"systemSubTab = 'audit'\">\n            <svg class=\"scada-icon\" width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><polyline points=\"14 2 14 8 20 8\"/><line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"/><line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"/><polyline points=\"10 9 9 9 8 9\"/></svg>\n            <span>C. NHẬT KÝ THAO TÁC (AUDIT TRAIL LOG)</span>\n          </button>\n        </div>\n\n        <!-- KHU VỰC A: CẤU HÌNH THÔNG SỐ -->\n        <div ng-show=\"systemSubTab === 'settings'\">\n<div class=\"card-panel\" style=\"max-width: 800px; margin: 0 auto;\">\n          <div class=\"section-header-row\">\n            <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\"/><line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\"/><line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\"/><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\"/><line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\"/><line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\"/><line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\"/><line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\"/><line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\"/></svg></span><span>CẤU HÌNH THÔNG SỐ TRUYỀN THÔNG & GIỚI HẠN AN TOÀN</span></div>\n            <div style=\"display: flex; align-items: center; gap: 8px;\">\n              <span class=\"status-pill online\" style=\"font-size: 8px; padding: 3px 8px;\">✓ ĐÃ ĐỒNG BỘ VỚI FIRMWARE</span>\n              <button class=\"btn-cmd primary\" style=\"padding: 4px 10px; font-size: 9px;\" ng-click=\"testComPing()\" ng-disabled=\"comPingStatus === 'TESTING'\">\n                <span>📡 KIỂM TRA TÍN HIỆU COM4</span>\n                <span ng-if=\"comPingLatency\" style=\"color: #fff; margin-left: 4px;\">({{comPingLatency}}ms)</span>\n              </button>\n              <button class=\"btn-cmd success\" style=\"padding: 4px 10px; font-size: 9px;\" ng-click=\"saveSettings()\">💾 LƯU CẤU HÌNH</button>\n            </div>\n          </div>\n\n                    <div style=\"padding: 8px 12px; background: rgba(245,158,11,0.12); border: 1px solid var(--color-warning); border-radius: 6px; font-size: 9px; color: var(--color-warning); margin-bottom: 12px; display: flex; align-items: center; gap: 8px;\">\n            <span>🛡</span>\n            <span><b>LƯU Ý AN TOÀN:</b> Các giới hạn nhiệt độ Solenoid và chu kỳ Watchdog được cài đặt để chống cháy nổ thiết bị JF-0826B 12VDC. Không thay đổi vượt quá ngưỡng kiểm định an toàn (Max 60°C).</span>\n          </div>\n          <div style=\"display: flex; flex-direction: column; gap: 14px; font-size: 10px;\">\n            <div style=\"background: var(--panel-secondary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-neutral);\">\n              <div style=\"font-weight: 700; color: var(--cyan-primary); margin-bottom: 8px;\">1. THÔNG SỐ CỔNG SERIAL / MODBUS RTU</div>\n              <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\">\n                <div><span>Cổng COM:</span> <input type=\"text\" value=\"COM4\" style=\"width: 100%; background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 4px 8px; border-radius: 4px; margin-top: 2px;\" readonly></div>\n                <div><span>Baudrate:</span> <input type=\"text\" value=\"9600\" style=\"width: 100%; background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 4px 8px; border-radius: 4px; margin-top: 2px;\" readonly></div>\n                <div><span>Data / Parity / Stop:</span> <input type=\"text\" value=\"8 - None - 1\" style=\"width: 100%; background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 4px 8px; border-radius: 4px; margin-top: 2px;\" readonly></div>\n                <div><span>Slave ID Relay:</span> <input type=\"text\" value=\"1\" style=\"width: 100%; background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 4px 8px; border-radius: 4px; margin-top: 2px;\" readonly></div>\n              </div>\n            </div>\n\n            <div style=\"background: var(--panel-secondary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-neutral);\">\n              <div style=\"font-weight: 700; color: var(--cyan-primary); margin-bottom: 8px;\">2. CHU KỲ QUÉT & NGƯỠNG AN TOÀN SOLENOID</div>\n              <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 10px;\">\n                <div><span>Chu kỳ Polling:</span> <input type=\"text\" value=\"150 ms\" style=\"width: 100%; background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 4px 8px; border-radius: 4px; margin-top: 2px;\" readonly></div>\n                <div><span>Watchdog Ngắt Solenoid:</span> <input type=\"text\" value=\"2.0 giây\" style=\"width: 100%; background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 4px 8px; border-radius: 4px; margin-top: 2px;\" readonly></div>\n                <div><span>Ngưỡng cảnh báo nhiệt:</span> <input type=\"text\" value=\"45.0 °C\" style=\"width: 100%; background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 4px 8px; border-radius: 4px; margin-top: 2px;\" readonly></div>\n                <div><span>Ngưỡng Trip ngắt bảo vệ:</span> <input type=\"text\" value=\"60.0 °C\" style=\"width: 100%; background: var(--panel-main); border: 1px solid var(--border-neutral); color: #fff; padding: 4px 8px; border-radius: 4px; margin-top: 2px;\" readonly></div>\n              </div>\n            </div>\n          </div>\n        </div>\n        </div>\n\n        <!-- KHU VỰC B: BẢO TRÌ & SỨC KHỎE THIẾT BỊ -->\n        <div ng-show=\"systemSubTab === 'maintenance'\">\n<div class=\"card-panel\" style=\"margin-bottom: 14px;\">\n          <div class=\"section-header-row\">\n            <div class=\"section-title\"><span class=\"section-title-icon\"><svg class=\"scada-icon\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"/></svg></span><span>CHỈ SỐ SỨC KHỎE THIẾT BỊ & LỊCH BẢO TRÌ (MACHINE HEALTH)</span></div>\n            <button class=\"btn-cmd success\" style=\"padding: 4px 10px; font-size: 9px;\" ng-click=\"exportAuditCSV()\">📥 XUẤT AUDIT LOG (CSV)</button>\n          </div>\n\n          <div style=\"display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 14px;\">\n            <div style=\"background: var(--panel-secondary); padding: 12px; border-radius: 8px; border: 1px solid var(--border-neutral); text-align: center;\">\n              <div style=\"font