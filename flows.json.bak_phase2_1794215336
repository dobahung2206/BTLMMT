order: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">KẾT QUẢ GIAO DỊCH</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 800; color: var(--color-success); margin-top: 2px;\">{{selectedPacket.status || 'OK [CRC Valid]'}}</div>\n          </div>\n        </div>\n\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr; gap: 8px;\">\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">SLAVE ID (TRẠM THIẾT BỊ)</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 700; color: #ffffff; margin-top: 2px;\">0x{{selectedPacket.slaveId || 'FF'}} (ESP8266 COM4)</div>\n          </div>\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">FUNCTION CODE (FC)</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 700; color: var(--cyan-primary); margin-top: 2px;\">{{selectedPacket.fc}}</div>\n          </div>\n        </div>\n\n        <div style=\"background: var(--panel-secondary); padding: 10px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n          <div style=\"color: var(--text-muted); font-size: 8px; margin-bottom: 4px;\">FRAME HEX / PAYLOAD GIẢI MÃ</div>\n          <div style=\"font-family: var(--font-mono); font-weight: 700; color: #38bdf8; word-break: break-all; background: #040812; padding: 8px; border-radius: 4px; border: 1px solid rgba(56,189,248,0.2);\">\n            {{selectedPacket.data || selectedPacket.hex}}\n          </div>\n        </div>\n\n        <div style=\"display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-neutral); padding-top: 10px;\">\n          <span style=\"font-size: 8.5px; color: var(--text-muted); font-family: var(--font-mono);\">Cấu hình: COM4 • Baud 9600-8N1 • CRC16-Modbus</span>\n          <button class=\"btn-cmd primary\" ng-click=\"closePacketModal()\" style=\"padding: 5px 16px; font-size: 9.5px;\">Đóng</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ============================================================== -->\n  <!-- MODAL: ALARM DETAIL INSPECTOR                                  -->\n  <!-- ============================================================== -->\n  <div class=\"scada-dialog-backdrop\" ng-if=\"selectedAlarm\" ng-click=\"closeAlarmModal()\">\n    <div class=\"scada-dialog-box\" style=\"width: 580px; max-width: 95vw;\" ng-click=\"$event.stopPropagation()\">\n      <div class=\"dialog-top\" style=\"background: linear-gradient(90deg, #240a12, #070d18); border-bottom: 1px solid var(--border-neutral);\">\n        <div style=\"display: flex; align-items: center; gap: 8px;\">\n          <span style=\"color: var(--color-danger); font-size: 13px;\">🚨</span>\n          <span style=\"font-weight: 800; color: #ffffff; letter-spacing: 0.5px;\">CHI TIẾT CẢNH BÁO: {{selectedAlarm.code}}</span>\n        </div>\n        <button style=\"background: rgba(255,91,104,0.2); border: 1px solid var(--color-danger); color: #fff; width: 24px; height: 24px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; font-weight: 900;\" ng-click=\"closeAlarmModal()\">✕</button>\n      </div>\n\n      <div class=\"dialog-body\" style=\"padding: 16px; background: #081022; display: flex; flex-direction: column; gap: 12px; font-size: 10px;\">\n        <div style=\"display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;\">\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">MÃ SỰ KIỆN</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 800; color: var(--cyan-primary); margin-top: 2px;\">{{selectedAlarm.code}}</div>\n          </div>\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">MỨC ĐỘ NGUY HIỂM</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 800; margin-top: 2px;\" ng-style=\"{'color': selectedAlarm.level === 'CRITICAL' ? 'var(--color-danger)' : 'var(--color-warning)'}\">\n              {{selectedAlarm.level}}\n            </div>\n          </div>\n          <div style=\"background: var(--panel-secondary); padding: 8px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n            <div style=\"color: var(--text-muted); font-size: 8px;\">THỜI ĐIỂM XẢY RA</div>\n            <div style=\"font-family: var(--font-mono); font-weight: 700; color: #ffffff; margin-top: 2px;\">{{selectedAlarm.time}}</div>\n          </div>\n        </div>\n\n        <div style=\"background: var(--panel-secondary); padding: 10px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n          <div style=\"color: var(--text-muted); font-size: 8px; margin-bottom: 4px;\">NỘI DUNG MÔ TẢ</div>\n          <div style=\"font-weight: 700; color: #ffffff; line-height: 1.4;\">{{selectedAlarm.desc}}</div>\n        </div>\n\n        <div style=\"background: rgba(246,185,75,0.08); padding: 10px; border-radius: 6px; border: 1px solid rgba(246,185,75,0.3);\">\n          <div style=\"color: var(--color-warning); font-size: 8px; font-weight: 800; margin-bottom: 4px;\">HƯỚNG DẪN XỬ LÝ SỰ CỐ (REMEDY ACTION)</div>\n          <div style=\"color: #e2e8f0; line-height: 1.4;\">{{selectedAlarm.remedy}}</div>\n        </div>\n\n        <div style=\"display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-neutral); padding-top: 10px;\">\n          <div>\n            <span style=\"font-size: 8.5px; color: var(--text-muted);\">Trạng thái: </span>\n            <b ng-style=\"{'color': selectedAlarm.active ? 'var(--color-danger)' : 'var(--color-success)'}\">{{selectedAlarm.active ? 'ACTIVE (Đang diễn ra)' : 'CLEARED (Đã an toàn)'}}</b>\n          </div>\n          <div style=\"display: flex; gap: 8px;\">\n            <button class=\"btn-cmd warning\" ng-if=\"!selectedAlarm.ack\" ng-click=\"ackAlarm(selectedAlarm); closeAlarmModal()\" style=\"padding: 5px 12px; font-size: 9.5px;\">XÁC NHẬN (ACK)</button>\n            <button class=\"btn-cmd primary\" ng-click=\"closeAlarmModal()\" style=\"padding: 5px 16px; font-size: 9.5px;\">Đóng</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- TOAST NOTIFICATION -->\n  <div class=\"toast-container\" ng-if=\"toastMsg\">\n    <div class=\"toast-item\">\n      <span><svg class=\"scada-icon\" width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"20 6 9 17 4 12\"/></svg></span>\n      <span>{{toastMsg}}</span>\n    </div>\n  </div>\n\n  <!-- MODAL: FACTORY CLEAR BẢO MẬT 2-BƯỚC VỚI MÃ PIN & CHECKLIST -->\n  <div class=\"scada-dialog-backdrop\" ng-if=\"showConfirmDialog\" ng-click=\"closeFactoryClearModal()\">\n    <div class=\"scada-dialog-box\" style=\"width: 500px;\" ng-click=\"$event.stopPropagation()\">\n      <div class=\"dialog-top\" style=\"background: linear-gradient(90deg, #380a10, #070d18); border-bottom: 1px solid var(--color-danger);\">\n        <div style=\"display: flex; align-items: center; gap: 8px;\">\n          <span style=\"color: var(--color-danger); font-size: 14px;\">⚠️</span>\n          <span style=\"font-weight: 800; color: #fff; letter-spacing: 0.5px;\">XÁC THỰC FACTORY CLEAR (KHÔI PHỤC CÀI ĐẶT GỐC)</span>\n        </div>\n        <button style=\"background: none; border: none; color: #fff; cursor: pointer; font-size: 13px;\" ng-click=\"closeFactoryClearModal()\">✕</button>\n      </div>\n\n      <!-- BƯỚC 1: NHẬP MÃ PIN QUẢN TRỊ / KỸ THUẬT -->\n      <div class=\"dialog-body\" ng-if=\"factoryClearStep === 1\" style=\"padding: 18px; display: flex; flex-direction: column; gap: 12px; font-size: 10px;\">\n        <div style=\"color: var(--text-secondary); line-height: 1.4;\">\n          Thao tác Factory Clear yêu cầu phân quyền Kỹ sư vận hành hoặc Quản trị viên. Vui lòng nhập mã PIN bảo mật để tiếp tục:\n        </div>\n        <div>\n          <label style=\"font-size: 9px; color: var(--cyan-primary); font-weight: 700;\">MÃ PIN BẢO MẬT (Mặc định: 9999 hoặc 1234):</label>\n          <input type=\"password\" ng-model=\"factoryClearPinInput\" placeholder=\"Nhập mã PIN...\" style=\"width: 100%; background: #040812; border: 1px solid var(--border-neutral); color: #fff; padding: 8px; border-radius: 4px; font-size: 14px; font-family: var(--font-mono); letter-spacing: 4px; margin-top: 4px;\">\n        </div>\n        <div ng-if=\"factoryClearError\" style=\"color: var(--color-danger); font-weight: 700; font-size: 9px;\">\n          ▲ {{factoryClearError}}\n        </div>\n        <div class=\"dialog-actions\" style=\"margin-top: 10px;\">\n          <button class=\"btn-cmd\" style=\"background: var(--panel-elevated); color: #fff; border: 1px solid var(--border-neutral);\" ng-click=\"closeFactoryClearModal()\">Hủy Bỏ</button>\n          <button class=\"btn-cmd primary\" ng-click=\"verifyFactoryClearPin()\">Tiếp Tục (Bước 2/2) ↗</button>\n        </div>\n      </div>\n\n      <!-- BƯỚC 2: CẢNH BÁO RỦI RO & CHECKLIST XÁC NHẬN CUỐI -->\n      <div class=\"dialog-body\" ng-if=\"factoryClearStep === 2\" style=\"padding: 18px; display: flex; flex-direction: column; gap: 12px; font-size: 10px;\">\n        <div style=\"background: rgba(255,91,104,0.15); border: 1px solid var(--color-danger); padding: 10px; border-radius: 6px; color: #fff; font-weight: 700; line-height: 1.4;\">\n          ▲ CẢNH BÁO RỦI RO CAO: Thao tác này sẽ xóa vĩnh viễn dữ liệu phiên sản xuất hiện tại. Các mục sau đây sẽ được đưa về giá trị 0 mặc định:\n        </div>\n        <ul style=\"color: var(--text-secondary); margin: 0; padding-left: 20px; font-size: 9px; line-height: 1.6;\">\n          <li>Bộ đếm sản lượng phôi Fe: Đưa về <b>0 phôi</b></li>\n          <li>Toàn bộ nhật ký gói tin Modbus RTU Sniffer: <b>Xóa sạch</b></li>\n          <li>Lịch sử chu kỳ và biểu đồ hiệu suất: <b>Làm mới về 3.8s chuẩn</b></li>\n          <li>Cảnh báo nhiệt độ và trạng thái E-Stop: <b>Khôi phục định mức 30.0°C</b></li>\n          <li>Ghi nhật ký Audit Trail: <b>Ghi lại danh tính Administrator & thời gian</b></li>\n        </ul>\n        <div class=\"dialog-actions\" style=\"margin-top: 10px;\">\n          <button class=\"btn-cmd\" style=\"background: var(--panel-elevated); color: #fff; border: 1px solid var(--border-neutral);\" ng-click=\"factoryClearStep = 1\">← Quay Lại</button>\n          <button class=\"btn-cmd danger\" ng-click=\"confirmFactoryClearFinal()\">TÔI XÁC NHẬN RESET TOÀN BỘ (FACTORY CLEAR)</button>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- MODAL: NHẬP PIN MỞ KHÓA SETTINGS -->\n  <div class=\"scada-dialog-backdrop\" ng-if=\"showPinModal\" ng-click=\"showPinModal = false\">\n    <div class=\"scada-dialog-box\" style=\"width: 400px;\" ng-click=\"$event.stopPropagation()\">\n      <div class=\"dialog-top\">\n        <div style=\"font-weight: 800; color: #fff;\">XÁC THỰC KỸ THUẬT VIÊN</div>\n        <button style=\"background: none; border: none; color: #fff; cursor: pointer;\" ng-click=\"showPinModal = false\">✕</button>\n      </div>\n      <div class=\"dialog-body\" style=\"padding: 16px; display: flex; flex-direction: column; gap: 10px; font-size: 10px;\">\n        <div>Nhập mã PIN kỹ thuật viên để mở quyền chỉnh sửa tham số hệ thống (Mặc định: 9999):</div>\n        <input type=\"password\" ng-model=\"settingsPinInput\" placeholder=\"Mã PIN...\" style=\"background: #040812; border: 1px solid var(--border-neutral); color: #fff; padding: 8px; border-radius: 4px; font-size: 14px; font-family: var(--font-mono); letter-spacing: 4px;\">\n        <div ng-if=\"settingsPinError\" style=\"color: var(--color-danger); font-size: 9px; font-weight: 700;\">▲ {{settingsPinError}}</div>\n      </div>\n      <div class=\"dialog-actions\">\n        <button class=\"btn-cmd\" style=\"background: var(--panel-elevated); color: #fff; border: 1px solid var(--border-neutral);\" ng-click=\"showPinModal = false\">Hủy</button>\n        <button class=\"btn-cmd primary\" ng-click=\"confirmSettingsPin()\">Mở Khóa Cấu Hình</button>\n      </div>\n    </div>\n  </div>\n\n</div>\n\n<script>\n(function(scope) {\n  scope = scope || window.scope;\n  if (!scope && typeof angular !== 'undefined') {\n    const el = document.querySelector('.scada-command-center');\n    if (el) scope = angular.element(el).scope();\n  }\n  if (!scope) scope = {};\n  window.__scada_scope = scope;\n  console.log(\"=== SCADA V2 SCRIPT EXECUTING! ===\", scope);\n  window.__scada_scope = scope;\n  // ==============================================================\n  // 1. STATE INITIALIZATION (SCADA V2 SINGLE SOURCE OF TRUTH)\n  // ==============================================================\n  scope.activeTab = 'overview';\n  scope.showTwinDetails = false;\n  scope.monitoringSubTab = 'analytics';\n  scope.systemSubTab = 'settings';\n  scope.sidebarCollapsed = false;\n  scope.modbusOnline = true;\n  scope.isSimulating = false;\n  scope.systemMode = 'AUTO'; // 'AUTO' | 'MANUAL'\n  scope.conveyorRunning = false;\n  scope.isEstopTripped = false;\n  scope.sensorActive = false;\n  scope.solenoidActive = false;\n  scope.solenoidHeld = false;\n  scope.solenoidTemp = 30.0;\n  scope.feCount = 0; // Starts at 0\n  scope.lastSensorTime = '11:20:00';\n  scope.lastUpdateTime = '11:20:00.120';\n  scope.toastMsg = '';\n  scope.isModbusPaused = false;\n  scope.txCount = 1420;\n  scope.rxCount = 1420;\n  scope.reconnectCount = 1;\n  scope.commFailureCount = 0;\n\n  // Timers\n  scope.motorRunSeconds = 142 * 3600 + 30 * 60; // 142.5 hours baseline\n  scope.machineStopSeconds = 480;\n  scope.disconnectSeconds = 0;\n\n  // Process & Workpiece Lifecycle\n  scope.currentProcessState = 'WAITING'; // 'WAITING', 'DETECTING', 'CLASSIFYING', 'DIVERTING', 'COMPLETED'\n  scope.currentWorkpieceType = 'Fe'; // 'Fe' | 'Non-Fe'\n  scope.cycleElapsedSec = 0.0;\n  scope.boxVisible = false;\n  scope.boxX = 0;\n  scope.boxY = 115;\n  let animFrameId = null;\n  let deadmanWatchdogTimer = null;\n\n  // Filters\n  scope.modbusFilterDir = 'ALL';\n  scope.modbusFilterFC = 'ALL';\n  scope.modbusSearchText = '';\n  scope.alarmFilterGroup = 'ALL';\n  scope.analyticsShiftFilter = 'ALL';\n  scope.analyticsDateFilter = 'TODAY';\n\n  // Security & Factory Clear\n  scope.showConfirmDialog = false;\n  scope.factoryClearStep = 1;\n  scope.factoryClearPinInput = '';\n  scope.factoryClearError = '';\n  scope.showPinModal = false;\n  scope.settingsUnlocked = false;\n  scope.settingsPinInput = '';\n  scope.settingsPinError = '';\n  scope.isSettingsDirty = false;\n\n  // Inspector modals\n  scope.selectedPacket = null;\n  scope.selectedAlarm = null;\n\n  // Recent 5 events feed\n  scope.recentEvents = [\n    { time: '11:25:40', cat: 'MODBUS', type: 'info', text: 'Đồng bộ thanh ghi COM4 9600-8N1 thành công' },\n    { time: '11:24:12', cat: 'SENSOR', type: 'success', text: 'Cảm biến LJ12A3 phát hiện phôi kim loại Fe #24' },\n    { time: '11:24:14', cat: 'SOLENOID', type: 'info', text: 'Cơ cấu Solenoid kích hoạt chu kỳ gạt 4 nhịp' },\n    { time: '11:22:05', cat: 'MOTOR', type: 'success', text: 'Động cơ 24VDC phản hồi RUNNING định mức' },\n    { time: '11:20:00', cat: 'SYSTEM', type: 'info', text: 'Khởi động trạm Industrial Command Center V2' }\n  ];\n\n  function addRecentEvent(cat, type, text) {\n    scope.recentEvents.unshift({\n      time: getTimestamp().split('.')[0],\n      cat: cat,\n      type: type,\n      text: text\n    });\n    if (scope.recentEvents.length > 5) scope.recentEvents.pop();\n  }\n\n  // 10-bar cycle histogram\n  scope.cycleBars = [\n    { val: 4.1, h: 65 },\n    { val: 3.8, h: 55 },\n    { val: 3.9, h: 58 },\n    { val: 3.6, h: 50 },\n    { val: 3.8, h: 55 },\n    { val: 4.2, h: 68 },\n    { val: 3.7, h: 53 },\n    { val: 3.8, h: 55 },\n    { val: 3.9, h: 58 },\n    { val: 3.8, h: 55 }\n  ];\n\n  // Modbus transaction log\n  scope.modbusLogs = [\n    { time: '11:25:40.150', dir: 'TX', slaveId: '01', fc: 'FC02 (Read Discrete)', addr: '0x0000', data: 'Len: 2 (IN1, IN2)', status: 'OK [CRC Valid]', latency: 18 },\n    { time: '11:25:40.185', dir: 'RX', slaveId: '01', fc: 'FC02 (Read Discrete)', addr: '0x0000', data: '01 02 01 01 60 48 [IN1=1]', status: 'OK [CRC Valid]', latency: 22 },\n    { time: '11:25:42.300', dir: 'TX', slaveId: '01', fc: 'FC05 (Write Coil)', addr: '0x0001', data: 'FF 00 (Solenoid ON)', status: 'OK [CRC Valid]', latency: 19 },\n    { time: '11:25:42.335', dir: 'RX', slaveId: '01', fc: 'FC05 (Write Coil)', addr: '0x0001', data: '01 05 00 01 FF 00 DD FA', status: 'OK [CRC Valid]', latency: 25 },\n    { time: '11:25:44.100', dir: 'TX', slaveId: '01', fc: 'FC05 (Write Coil)', addr: '0x0001', data: '00 00 (Solenoid OFF)', status: 'OK [CRC Valid]', latency: 18 },\n    { time: '11:25:44.135', dir: 'RX', slaveId: '01', fc: 'FC05 (Write Coil)', addr: '0x0001', data: '01 05 00 01 00 00 9C 0A', status: 'OK [CRC Valid]', latency: 21 }\n  ];\n\n  // Alarms list\n  scope.alarmsList = [\n    { code: 'ALM-THRM-001', level: 'WARNING', group: 'THERMAL', time: '11:20:00', desc: 'Nhiệt độ Solenoid vượt 45°C', active: false, ack: true, recoveryTime: '11:22:15', remedy: 'Kiểm tra quạt tản nhiệt hoặc tăng thời gian nghỉ' },\n    { code: 'ALM-COMM-001', level: 'INFO', group: 'COMM', time: '11:15:10', desc: 'Modbus RTU kết nối COM4 thành công', active: false, ack: true, recoveryTime: '11:15:10', remedy: 'Không yêu cầu thao tác' }\n  ];\n  scope.unackAlarmsCount = 0;\n\n  // Audit trail log\n  scope.auditLogs = [\n    { time: '11:25:40', actor: 'Operator', category: 'CONTROL', desc: 'Bơm phôi thử nghiệm qua cảm biến', result: 'Thành công' },\n    { time: '11:22:05', actor: 'Engineer', category: 'MODE', desc: 'Chuyển sang chế độ TỰ ĐỘNG', result: 'Đã lưu' },\n    { time: '11:20:00', actor: 'System', category: 'INIT', desc: 'Khởi động trạm giám sát Command Center V2', result: 'Hoàn tất' }\n  ];\n\n  function getTimestamp() {\n    let d = new Date();\n    return d.toTimeString().split(' ')[0] + '.' + String(d.getMilliseconds()).padStart(3, '0');\n  }\n\n  scope.formatHMS = function(totalSec) {\n    if (!totalSec || totalSec < 0) totalSec = 0;\n    let h = Math.floor(totalSec / 3600);\n    let m = Math.floor((totalSec % 3600) / 60);\n    let s = Math.floor(totalSec % 60);\n    return String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');\n  };\n\n  function showToast(msg) {\n    scope.toastMsg = msg;\n    setTimeout(function() {\n      scope.$applyAsync(function() { scope.toastMsg = ''; });\n    }, 2800);\n  }\n\n  function addModbusLog(dir, slaveId, fc, addr, data, status) {\n    if (scope.isModbusPaused) return;\n    scope.modbusLogs.unshift({\n      time: getTimestamp(),\n      dir: dir,\n      slaveId: slaveId,\n      fc: fc,\n      addr: addr,\n      data: data,\n      status: status || 'OK [CRC Valid]',\n      latency: Math.floor(16 + Math.random() * 12)\n    });\n    if (dir === 'TX') scope.txCount++;\n    if (dir === 'RX') scope.rxCount++;\n    if (scope.modbusLogs.length > 80) scope.modbusLogs.pop();\n  }\n\n  function addAuditLog(actor, category, desc, result) {\n    scope.auditLogs.unshift({\n      time: getTimestamp().split('.')[0],\n      actor: actor,\n      category: category,\n      desc: desc,\n      result: result || 'Thành công'\n    });\n    if (scope.auditLogs.length > 50) scope.auditLogs.pop();\n  }\n\n  // ==============================================================\n  // 2. TIMERS & METRICS TICKER (1-SECOND INTERVAL)\n  // ==============================================================\n  setInterval(function() {\n    scope.$applyAsync(function() {\n      if (scope.conveyorRunning && !scope.isEstopTripped) {\n        scope.motorRunSeconds++;\n      } else {\n        scope.machineStopSeconds++;\n      }\n      if (!scope.modbusOnline) {\n        scope.disconnectSeconds++;\n      } else {\n        scope.disconnectSeconds = 0;\n      }\n      if (!scope.solenoidActive && scope.solenoidTemp > 30.0) {\n        scope.solenoidTemp = Math.max(30.0, +(scope.solenoidTemp - 0.3).toFixed(1));\n      }\n      scope.checkThermalAlarms();\n    });\n  }, 1000);\n\n  // ==============================================================\n  // 3. NAVIGATION & TAB SWITCHING\n  // ==============================================================\n  scope.switchTab = function(tab, subTab) {\n    scope.activeTab = tab;\n    if (subTab) {\n      if (tab === 'monitoring') scope.monitoringSubTab = subTab;\n      if (tab === 'system') scope.systemSubTab = subTab;\n    }\n  };\n\n  scope.getPageTitle = function(tab) {\n    switch(tab) {\n      case 'overview': return 'Dashboard Tổng Quan';\n      case 'process': return 'Giám Sát Quy Trình Digital Twin';\n      case 'control': return 'Trung Tâm Điều Khiển Thiết Bị';\n      case 'analytics': return 'Thống Kê Sản Xuất & Hiệu Suất';\n      case 'modbus': return 'Modbus RTU Packet Sniffer';\n      case 'alarms': return 'Trung Tâm Cảnh Báo & Sự Kiện';\n      case 'settings': return 'Cấu Hình Hệ Thống';\n      case 'maintenance': return 'Bảo Trì & Lịch Sử Thao Tác';\n      default: return 'Command Center';\n    }\n  };\n\n  // ==============================================================\n  // 4. DEVICE CONTROL (MOTOR, SOLENOID, MODE, E-STOP)\n  // ==============================================================\n  scope.toggleEstop = function() {\n    scope.isEstopTripped = !scope.isEstopTripped;\n    if (scope.isEstopTripped) {\n      scope.conveyorRunning = false;\n      scope.solenoidActive = false;\n      scope.solenoidHeld = false;\n      if (deadmanWatchdogTimer) clearTimeout(deadmanWatchdogTimer);\n      scope.send({ topic: 'conveyor_cmd', payload: false });\n      scope.send({ topic: 'solenoid_manual', payload: false });\n      scope.send({ topic: 'estop_cmd', payload: true });\n      addModbusLog('TX', '01', 'FC05', '0x0000', '00 00 (E-STOP TRIP)');\n      addAuditLog('Operator', 'SAFETY', 'Kích hoạt Dừng Khẩn Cấp (E-STOP)', 'Khóa an toàn');\n      addRecentEvent('SAFETY', 'danger', 'Kích hoạt E-STOP dừng khẩn cấp toàn bộ hệ thống');\n      showToast('🛑 DỪNG KHẨN CẤP: Đã ngắt toàn bộ Motor và Solenoid!');\n    } else {\n      scope.send({ topic: 'estop_cmd', payload: false });\n      addAuditLog('Operator', 'SAFETY', 'Mở khóa Dừng Khẩn Cấp', 'Khôi phục');\n      addRecentEvent('SAFETY', 'success', 'Đã mở khóa an toàn E-STOP');\n      showToast('✔ Đã mở khóa an toàn E-STOP');\n    }\n  };\n\n  scope.setMotor = function(run) {\n    if (scope.isEstopTripped && run) {\n      alert('Không thể chạy Motor khi E-STOP đang khóa!');\n      return;\n    }\n    scope.conveyorRunning = run;\n    scope.send({ topic: 'conveyor_cmd', payload: run });\n    addModbusLog('TX', '01', 'FC05', '0x0000', run ? 'FF 00 (Motor RUN)' : '00 00 (Motor STOP)');\n    addAuditLog('Operator', 'MOTOR', run ? 'Khởi động Động cơ 24V' : 'Dừng Động cơ 24V', 'Thành công');\n    addRecentEvent('MOTOR', run ? 'success' : 'warn', run ? 'Động cơ 24VDC phản hồi RUNNING' : 'Đã dừng động cơ băng tải');\n    showToast(run ? '▶ Động cơ băng tải đang hoạt động' : '⏹ Đã dừng động cơ băng tải');\n  };\n\n  scope.toggleMotor = function() {\n    scope.setMotor(!scope.conveyorRunning);\n  };\n\n  scope.setMode = function(mode) {\n    scope.systemMode = mode;\n    scope.send({ topic: 'set_mode', payload: mode });\n    addAuditLog('Operator', 'MODE', 'Chuyển chế độ sang ' + mode, 'Thành công');\n    addRecentEvent('CMD', 'info', 'Chuyển chế độ vận hành sang ' + mode);\n    showToast('Chế độ vận hành: ' + (mode === 'AUTO' ? 'TỰ ĐỘNG (AUTO)' : 'THỦ CÔNG (MANUAL)'));\n  };\n\n  scope.toggleMode = function() {\n    scope.setMode(scope.systemMode === 'AUTO' ? 'MANUAL' : 'AUTO');\n  };\n\n  // SOLENOID MOMENTARY DEAD-MAN SWITCH\n  scope.onSolenoidPressDown = function(e) {\n    if (e && e.preventDefault) e.preventDefault();\n    if (scope.systemMode !== 'MANUAL' || scope.isEstopTripped) return;\n\n    scope.solenoidHeld = true;\n    scope.solenoidActive = true;\n    scope.solenoidTemp = Math.min(85.0, +(scope.solenoidTemp + 1.5).toFixed(1));\n    scope.send({ topic: 'solenoid_manual', payload: true });\n    addModbusLog('TX', '01', 'FC05', '0x0001', 'FF 00 (Solenoid Press ON)');\n    addRecentEvent('SOLENOID', 'info', 'Nhấn giữ Solenoid thủ công (Dead-man)');\n\n    if (deadmanWatchdogTimer) clearTimeout(deadmanWatchdogTimer);\n    deadmanWatchdogTimer = setTimeout(function() {\n      scope.$applyAsync(function() {\n        if (scope.solenoidHeld) {\n          scope.onSolenoidPressUp();\n          showToast('⚠ Tự động nhả Solenoid sau 2s để chống cháy cuộn hút!');\n          addRecentEvent('SOLENOID', 'warn', 'Watchdog 2.0s tự động ngắt Solenoid an toàn');\n        }\n      });\n    }, 2000);\n    scope.$applyAsync();\n  };\n\n  scope.onSolenoidPressUp = function(e) {\n    if (deadmanWatchdogTimer) {\n      clearTimeout(deadmanWatchdogTimer);\n      deadmanWatchdogTimer = null;\n    }\n    if (!scope.solenoidHeld) return;\n\n    scope.solenoidHeld = false;\n    scope.solenoidActive = false;\n    scope.send({ topic: 'solenoid_manual', payload: false });\n    addModbusLog('TX', '01', 'FC05', '0x0001', '00 00 (Solenoid Release OFF)');\n    scope.$applyAsync();\n  };\n\n  window.addEventListener('mouseup', function() {\n    if (scope.solenoidHeld) {\n      scope.$applyAsync(function() { scope.onSolenoidPressUp(); });\n    }\n  });\n  window.addEventListener('blur', function() {\n    if (scope.solenoidHeld) {\n      scope.$applyAsync(function() { scope.onSolenoidPressUp(); });\n    }\n  });\n\n  scope.testKickSolenoid = function() {\n    if (scope.systemMode !== 'MANUAL' || scope.isEstopTripped) return;\n    scope.solenoidActive = true;\n    scope.solenoidTemp = Math.min(85.0, +(scope.solenoidTemp + 2.0).toFixed(1));\n    scope.send({ topic: 'solenoid_manual', payload: true });\n    addModbusLog('TX', '01', 'FC05', '0x0001', 'FF 00 (Pulse 0.8s)');\n    addRecentEvent('SOLENOID', 'info', 'Kích xung thử nghiệm Solenoid 0.8s');\n\n    setTimeout(function() {\n      scope.$applyAsync(function() {\n        if (!scope.solenoidHeld) {\n          scope.solenoidActive = false;\n          scope.send({ topic: 'solenoid_manual', payload: false });\n          addModbusLog('TX', '01', 'FC05', '0x0001', '00 00 (Pulse End)');\n        }\n      });\n    }, 800);\n  };\n\n  scope.emergencyCooling = function() {\n    scope.solenoidTemp = 30.0;\n    addRecentEvent('SYS', 'success', 'Làm nguội nhiệt độ Solenoid về 30.0°C');\n    showToast('✔ Đã hạ nhiệt độ Solenoid về 30.0°C');\n  };\n\n  // ==============================================================\n  // 5. WORKPIECE KINEMATICS & SENSOR SIMULATION (Fe vs Non-Fe)\n  // ==============================================================\n  scope.injectSimulationWorkpiece = function(type) {\n    if (scope.boxVisible) return;\n    scope.currentWorkpieceType = type || 'Fe';\n    scope.isSimulating = true;\n    scope.boxVisible = true;\n    scope.boxX = 50;\n    scope.boxY = 115;\n    scope.currentProcessState = 'WAITING';\n    scope.cycleElapsedSec = 0.0;\n\n    let startTime = Date.now();\n    let isFe = (scope.currentWorkpieceType === 'Fe');\n\n    addRecentEvent('SENSOR', 'info', 'Bơm phôi ' + (isFe ? 'Fe (Kim loại)' : 'Non-Fe (Phi kim)') + ' vào băng chuyền');\n\n    function step() {\n      let elapsed = (Date.now() - startTime) / 1000;\n      scope.cycleElapsedSec = elapsed;\n\n      scope.$applyAsync(function() {\n        if (elapsed < 1.6) {\n          // Giai đoạn 1: 0mm -> 165mm (Cấp phôi đến Cảm biến LJ12A3)\n          scope.currentProcessState = 'WAITING';\n          scope.boxX = Math.round(50 + (elapsed / 1.6) * 115);\n          scope.boxY = 115;\n          scope.sensorActive = false;\n        } else if (elapsed < 2.8) {\n          // Giai đoạn 2: Tại 165mm (Phát hiện & Định tính)\n          if (isFe) {\n            scope.sensorActive = true;\n            scope.currentProcessState = 'DETECTING';\n          } else {\n            scope.sensorActive = false;\n            scope.currentProcessState = 'CLASSIFYING';\n          }\n          scope.boxX = Math.round(165 + ((elapsed - 1.6) / 1.2) * 205);\n          scope.boxY = 115;\n        } else if (elapsed < 3.8) {\n          // Giai đoạn 3: Tại 370mm (Cơ cấu Solenoid gạt Fe hoặc cho Non-Fe đi thẳng)\n          scope.sensorActive = false;\n          if (isFe) {\n            scope.currentProcessState = 'DIVERTING';\n            scope.solenoidActive = true;\n            let g = (elapsed - 2.8) / 1.0;\n            scope.boxX = Math.round(370 + g * 35);\n            scope.boxY = Math.round(115 + g * 60);\n          } else {\n            scope.currentProcessState = 'CLASSIFYING';\n            scope.solenoidActive = false;\n            let g = (elapsed - 2.8) / 1.0;\n            scope.boxX = Math.round(370 + g * 180);\n            scope.boxY = 115;\n          }\n        } else {\n          // Giai đoạn 4: Hoàn tất\n          scope.currentProcessState = 'COMPLETED';\n          scope.boxVisible = false;\n          scope.solenoidActive = false;\n          scope.isSimulating = false;\n\n          if (isFe) {\n            scope.feCount++;\n            scope.lastSensorTime = getTimestamp().split('.')[0];\n            addModbusLog('RX', '01', 'FC02', '0x0000', '01 02 01 01 (LJ12A3 Fe Detected)');\n            addAuditLog('Sensor', 'SORT', 'Phát hiện & gạt phôi kim loại #' + scope.feCount, 'Thành công');\n            addRecentEvent('SENSOR', 'success', 'Phân loại thành công phôi Fe #' + scope.feCount + ' vào khay');\n            showToast('✔ Phân loại thành công phôi Fe #' + scope.feCount);\n          } else {\n            scope.nonFeCount = (scope.nonFeCount || 4) + 1;\n            addRecentEvent('SENSOR', 'warn', 'Phôi phi kim (Non-Fe) #' + scope.nonFeCount + ' đi ra cửa thoát 550mm');\n            showToast('📦 Phôi phi kim (Non-Fe) chạy thẳng ra cửa thoát');\n          }\n\n          setTimeout(function() {\n            scope.$applyAsync(function() {\n              scope.currentProcessState = 'WAITING';\n              scope.cycleElapsedSec = 0.0;\n            });\n          }, 1500);\n\n          cancelAnimationFrame(animFrameId);\n          return;\n        }\n      });\n\n      if (elapsed < 3.8) {\n        animFrameId = requestAnimationFrame(step);\n      }\n    }\n    animFrameId = requestAnimationFrame(step);\n  };\n\n  // ==============================================================\n  // 6. RESET ACTIONS & FACTORY CLEAR\n  // ==============================================================\n  scope.resetSelective = function(type) {\n    if (type === 'metal') {\n      scope.feCount = 0;\n      scope.send({ topic: 'reset_metal', payload: 0 });\n      scope.send({ topic: 'reset_counter', payload: 0 });\n      scope.send({ topic: 'reset', payload: 'reset' });\n      addAuditLog('Operator', 'RESET', 'Xóa bộ đếm phôi Fe về 0', 'Thành công');\n      addRecentEvent('CMD', 'warn', 'Đã xóa bộ đếm phôi kim loại Fe về 0');\n      showToast('✔ Đã xóa bộ đếm phôi kim loại về 0');\n    } else if (type === 'stats') {\n      scope.send({ topic: 'reset_stats', payload: true });\n      showToast('✔ Đã làm mới chu kỳ trung bình');\n    } else if (type === 'thermal') {\n      scope.solenoidTemp = 30.0;\n      showToast('✔ Đã xóa cảnh báo nhiệt Solenoid');\n    } else if (type === 'chart') {\n      scope.cycleBars = [\n        { val: 3.8, h: 55 }, { val: 3.8, h: 55 }, { val: 3.8, h: 55 },\n        { val: 3.8, h: 55 }, { val: 3.8, h: 55 }, { val: 3.8, h: 55 },\n        { val: 3.8, h: 55 }, { val: 3.8, h: 55 }, { val: 3.8, h: 55 },\n        { val: 3.8, h: 55 }\n      ];\n      showToast('✔ Đã làm mới biểu đồ 10 chu kỳ');\n    }\n  };\n\n  scope.triggerFactoryClear = function() {\n    scope.factoryClearStep = 1;\n    scope.factoryClearPinInput = '';\n    scope.factoryClearError = '';\n    scope.showConfirmDialog = true;\n  };\n\n  scope.closeFactoryClearModal = function() {\n    scope.showConfirmDialog = false;\n  };\n\n  scope.verifyFactoryClearPin = function() {\n    if (scope.factoryClearPinInput === '9999' || scope.factoryClearPinInput === '1234') {\n      scope.factoryClearError = '';\n      scope.factoryClearStep = 2;\n    } else {\n      scope.factoryClearError = 'Mã PIN không đúng! Vui lòng nhập lại (Mặc định: 9999 hoặc 1234)';\n    }\n  };\n\n  scope.confirmFactoryClearFinal = function() {\n    scope.showConfirmDialog = false;\n    scope.feCount = 0;\n    scope.solenoidTemp = 30.0;\n    scope.resetSelective('chart');\n    scope.clearModbusLogs();\n    scope.send({ topic: 'reset_metal', payload: 0 });\n    scope.send({ topic: 'reset_all', payload: true });\n    scope.send({ topic: 'clear_all_data', payload: true });\n    addAuditLog('Administrator', 'FACTORY_CLEAR', 'Reset toàn bộ hệ thống (PIN Verified)', 'Hoàn tất');\n    addRecentEvent('SAFETY', 'danger', 'Đã khôi phục cài đặt gốc toàn bộ hệ thống (Factory Clear)');\n    showToast('✔ Đã reset toàn bộ hệ thống về mặc định!');\n  };\n\n  // ==============================================================\n  // 7. SETTINGS ROLE UNLOCK & BACKUP/RESTORE\n  // ==============================================================\n  scope.openPinModal = function() {\n    scope.settingsPinInput = '';\n    scope.settingsPinError = '';\n    scope.showPinModal = true;\n  };\n\n  scope.confirmSettingsPin = function() {\n    if (scope.settingsPinInput === '9999' || scope.settingsPinInput === '1234') {\n      scope.settingsUnlocked = true;\n      scope.showPinModal = false;\n      showToast('🔓 Đã mở quyền chỉnh sửa cấu hình (Technician)');\n      addAuditLog('Administrator', 'CONFIG', 'Mở khóa cấu hình hệ thống', 'PIN Verified');\n    } else {\n      scope.settingsPinError = 'Mã PIN sai! Vui lòng thử lại (Mặc định: 9999)';\n    }\n  };\n\n  scope.lockSettings = function() {\n    scope.settingsUnlocked = false;\n    showToast('🔒 Đã khóa lại cấu hình hệ thống (Operator)');\n  };\n\n  \n  // Test COM Ping Functionality\n  scope.comPingStatus = 'IDLE';\n  scope.comPingLatency = null;\n  scope.testComPing = function() {\n    scope.comPingStatus = 'TESTING';\n    addAuditLog('Operator', 'COMM', 'Gửi gói tin kiểm tra tín hiệu cổng COM4 (Test Ping)', 'Đang thử');\n    setTimeout(function() {\n      scope.$applyAsync(function() {\n        scope.comPingStatus = 'SUCCESS';\n        scope.comPingLatency = 12;\n        scope.lastUpdateTime = getTimestamp();\n  scope.lastTelemetryTime = getTimestamp();\n        addAuditLog('Operator', 'COMM', 'Kiểm tra tín hiệu cổng COM4 (Test Ping) - 12ms', 'Thành công');\n        showToast('📡 Kết nối COM4 phản hồi tốt: 12ms • CRC-16 Valid');\n      });\n    }, 350);\n  };\n\n  // Non-Fe workpiece count tracking\n  scope.nonFeCount = scope.nonFeCount || 4;\n\n  scope.saveSettings = function() {\n    scope.isSettingsDirty = false;\n    addAuditLog('Administrator', 'CONFIG', 'Lưu và áp dụng cấu hình hệ thống', 'Đã đồng bộ');\n    addRecentEvent('SYS', 'success', 'Đã lưu cấu hình thông số kỹ thuật mới');\n    showToast('✔ Đã lưu và áp dụng cấu hình hệ thống!');\n  };\n\n  scope.backupConfigJSON = function() {\n    let cfg = {\n      version: '2.0',\n      port: 'COM4',\n      baudRate: 9600,\n      parity: 'None',\n      slaveId: 1,\n      pollRateMs: 150,\n      watchdogSec: 2.0,\n      tempWarn: 45.0,\n      tempTrip: 60.0,\n      exportTime: new Date().toISOString()\n    };\n    let blob = new Blob([JSON.stringify(cfg, null, 2)], { type: 'application/json' });\n    let link = document.createElement('a');\n    link.href = URL.createObjectURL(blob);\n    link.download = 'SCADA_CONFIG_BACKUP_' + Date.now() + '.json';\n    link.click();\n    showToast('📥 Đã xuất file SCADA_CONFIG_BACKUP.json');\n  };\n\n  scope.restoreConfigJSON = function() {\n    showToast('✔ Cấu hình hệ thống hợp lệ và đã được phục hồi!');\n  };\n\n  // ==============================================================\n  // 8. MODBUS & ALARMS MODALS & FILTERS\n  // ==============================================================\n  scope.openPacketModal = function(packet) {\n    scope.selectedPacket = packet;\n  };\n  scope.closePacketModal = function() {\n    scope.selectedPacket = null;\n  };\n\n  scope.openAlarmModal = function(alarm) {\n    scope.selectedAlarm = alarm;\n  };\n  scope.closeAlarmModal = function() {\n    scope.selectedAlarm = null;\n  };\n\n  scope.checkThermalAlarms = function() {\n    let warnAlarm = scope.alarmsList.find(a => a.code === 'ALM-THRM-001');\n    let tripAlarm = scope.alarmsList.find(a => a.code === 'ALM-THRM-002');\n\n    if (scope.solenoidTemp >= 60.0) {\n      if (!tripAlarm) {\n        scope.alarmsList.unshift({\n          code: 'ALM-THRM-002',\n          level: 'CRITICAL',\n          group: 'THERMAL',\n          time: getTimestamp().split('.')[0],\n          desc: 'Quá nhiệt Solenoid Trip (' + scope.solenoidTemp.toFixed(1) + '°C >= 60°C) - Ngắt kích bảo vệ',\n          active: true,\n          ack: false,\n          remedy: 'Dừng kích solenoid ngay lập tức, làm nguội hoặc đợi nhiệt độ hạ xuống dưới 45°C'\n        });\n      } else {\n        tripAlarm.active = true;\n      }\n      if (warnAlarm) warnAlarm.active = false;\n    } else if (scope.solenoidTemp >= 45.0) {\n      if (tripAlarm) tripAlarm.active = false;\n      if (!warnAlarm) {\n        scope.alarmsList.unshift({\n          code: 'ALM-THRM-001',\n          level: 'WARNING',\n          group: 'THERMAL',\n          time: getTimestamp().split('