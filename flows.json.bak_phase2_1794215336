        "template": "<!DOCTYPE html>\n<html lang=\"vi\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Mô Hình 3D Chuẩn Cơ Khí: Cơ Cấu Thanh Gạt & Solenoid</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <!-- Three.js + OrbitControls -->\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js\"></script>\n  <script src=\"https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js\"></script>\n  <style>\n    body { font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; overflow: hidden; }\n    #canvas-container { width: 100vw; height: 100vh; position: absolute; top: 0; left: 0; z-index: 1; }\n    .glass-panel {\n      background: rgba(15, 23, 42, 0.88);\n      backdrop-filter: blur(14px);\n      border: 1px solid rgba(51, 65, 85, 0.8);\n    }\n  </style>\n</head>\n<body class=\"bg-slate-950 text-slate-100 select-none\">\n\n  <!-- 3D WEBGL CANVAS CONTAINER -->\n  <div id=\"canvas-container\"></div>\n\n  <!-- FLOATING UI: TOP HEADER -->\n  <div class=\"fixed top-4 left-4 right-4 z-10 flex flex-wrap justify-between items-center gap-3 pointer-events-none\">\n    <div id=\"topHeaderPanel\" class=\"glass-panel p-4 rounded-2xl shadow-2xl pointer-events-auto max-w-xl transition-all duration-300\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"text-2xl\">🔧</span>\n        <div>\n          <h1 class=\"text-base font-bold text-sky-400 tracking-wide\">\n            MÔ HÌNH 3D: BĂNG TẢI 11 x 40 CM & THANH GẠT CHUẨN KÍCH THƯỚC\n          </h1>\n          <p class=\"text-xs text-emerald-400 font-medium\">\n            ✔ Băng chuyền 110x400mm • Nhánh trên 12mm • Lưỡi gạt 85mm • Cầu gá 124mm • Ty Solenoid 10mm\n          </p>\n        </div>\n      </div>\n    </div>\n\n    <!-- PRESET CAMERA VIEWS & OPACITY TOGGLE -->\n    <div class=\"glass-panel p-2 rounded-xl shadow-xl flex flex-wrap gap-1.5 pointer-events-auto\">\n      <button onclick=\"setCameraView('mech')\" class=\"px-3 py-1.5 rounded-lg bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold text-xs shadow transition\">\n        🔍 Cận Cảnh Cơ Cấu Gạt\n      </button>\n      <button onclick=\"setCameraView('sensor')\" class=\"px-2.5 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-xs font-semibold transition\">\n        📡 Xem Khung Cảm Biến M12\n      </button>\n      <button onclick=\"setCameraView('top')\" class=\"px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 transition\">\n        🔝 Nhìn Từ Trên\n      </button>\n      <button onclick=\"setCameraView('iso')\" class=\"px-2.5 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-semibold text-slate-200 transition\">\n        🌐 Toàn Cảnh 3D\n      </button>\n      <button id=\"btnToggleXRay\" class=\"px-2.5 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/40 text-xs font-semibold transition\">\n        👁️ Nhìn Xuyên Thấu (X-Ray)\n      </button>\n      <button id=\"btnToggleLabels\" class=\"px-2.5 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 text-xs font-semibold transition flex items-center gap-1\" title=\"Bấm hoặc nhấn phím 'L' để Ẩn / Hiện các nhãn chữ 3D\">\n        🏷️ Ẩn Chữ 3D\n      </button>\n      <button id=\"btnToggleUI\" class=\"px-2.5 py-1.5 rounded-lg bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-300 border border-indigo-500/40 text-xs font-semibold transition flex items-center gap-1\" title=\"Bấm hoặc nhấn phím 'U' để Ẩn / Hiện các khung chữ thông tin trên màn hình\">\n        🔲 Ẩn Khung Chữ (UI)\n      </button>\n    </div>\n  </div>\n\n  <!-- FLOATING UI: BOTTOM INTERACTIVE CONTROLS -->\n  <div class=\"fixed bottom-4 left-4 right-4 z-10 flex flex-wrap justify-between items-end gap-3 pointer-events-none\">\n    \n    <!-- INTERACTIVE ACTION BUTTONS -->\n    <div class=\"glass-panel p-4 rounded-2xl shadow-2xl pointer-events-auto flex flex-wrap gap-2.5 max-w-2xl items-center\">\n      <button id=\"btnToggleSolenoid\" class=\"px-4 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-bold text-xs tracking-wide shadow-lg shadow-amber-500/20 transition flex items-center gap-2\">\n        <span id=\"solenoidIcon\">⚡</span> <span id=\"solenoidText\">BẬT SOLENOID (ĐẨY RA 40°)</span>\n      </button>\n\n      <button id=\"btnSpawnMetal\" class=\"px-3.5 py-2.5 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 font-semibold text-xs active:scale-95 transition flex items-center gap-1.5\">\n        <span>⚙️</span> Thả Phôi Kim Loại [Fe]\n      </button>\n\n      <button id=\"btnSpawnPlastic\" class=\"px-3.5 py-2.5 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 text-sky-300 border border-sky-500/40 font-semibold text-xs active:scale-95 transition flex items-center gap-1.5\">\n        <span>⚪</span> Thả Phôi Phi Kim [Nhựa]\n      </button>\n\n      <div class=\"h-6 w-[1px] bg-slate-700 hidden sm:block\"></div>\n\n      <div class=\"text-xs font-mono text-slate-300 flex items-center gap-2\">\n        <span>Góc gạt:</span>\n        <span id=\"badgeAngle\" class=\"text-amber-400 font-bold bg-slate-900 px-2 py-0.5 rounded border border-slate-700\">0.0°</span>\n      </div>\n    </div>\n\n    <!-- MECHANICAL DETAILS BREAKDOWN CARD -->\n    <div id=\"mechDetailsPanel\" class=\"glass-panel p-3.5 rounded-2xl shadow-2xl pointer-events-auto max-w-md text-xs space-y-1.5 hidden md:block transition-all duration-300\">\n      <div class=\"font-bold text-sky-400 flex items-center justify-between\">\n        <span>📐 Băng tải 110 x 400 mm:</span>\n        <span class=\"text-[10px] text-amber-400 font-mono\">Chuẩn ốc M3</span>\n      </div>\n      <div class=\"text-[11px] text-slate-300 space-y-1 leading-relaxed\">\n        <div>• <b>Khung cảm biến 3 miếng:</b> 2 miếng đứng $55\\text{mm}$, miếng trên $120\\text{mm}$ khoét lỗ $\\varnothing 12.5\\text{mm}$.</div>\n        <div>• <b>Chu kỳ gạt 4 nhịp:</b> $t=2.0\\text{s}$ (duỗi 2.0s) $\\rightarrow$ nghỉ 1.7s $\\rightarrow t=5.7\\text{s}$ (0.5s) $\\rightarrow$ nghỉ 1.7s $\\rightarrow t=7.9\\text{s}$ (0.5s) $\\rightarrow$ nghỉ 1.7s $\\rightarrow t=10.1\\text{s}$ (0.5s) $\\rightarrow t=10.6\\text{s}$ xong.</div>\n        <div>• <b>Lưỡi gạt dưới:</b> Dài $85\\text{mm}$, cao $18\\text{mm}$, dày $3\\text{mm}$ (quét ngang $58\\text{mm}$).</div>\n      </div>\n    </div>\n\n  </div>\n\n  <!-- THREE.JS SCRIPT -->\n  <script>\n    const container = document.getElementById('canvas-container');\n    const scene = new THREE.Scene();\n    scene.background = new THREE.Color(0x020617);\n    scene.fog = new THREE.FogExp2(0x020617, 0.0035);\n\n    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 1000);\n    camera.position.set(28, 16, 12);\n\n    const renderer = new THREE.WebGLRenderer({ antialias: true });\n    renderer.setSize(window.innerWidth, window.innerHeight);\n    renderer.setPixelRatio(window.devicePixelRatio);\n    renderer.shadowMap.enabled = true;\n    renderer.shadowMap.type = THREE.PCFSoftShadowMap;\n    container.appendChild(renderer.domElement);\n\n    const controls = new THREE.OrbitControls(camera, renderer.domElement);\n    controls.enableDamping = true;\n    controls.dampingFactor = 0.06;\n    controls.maxPolarAngle = Math.PI / 2 + 0.05;\n    controls.target.set(16, 4, 0);\n\n    const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);\n    scene.add(ambientLight);\n\n    const mainLight = new THREE.DirectionalLight(0xffffff, 0.9);\n    mainLight.position.set(25, 35, 20);\n    mainLight.castShadow = true;\n    mainLight.shadow.mapSize.width = 2048;\n    mainLight.shadow.mapSize.height = 2048;\n    mainLight.shadow.bias = -0.0003;\n    scene.add(mainLight);\n\n    const fillBlue = new THREE.PointLight(0x38bdf8, 0.8, 45);\n    fillBlue.position.set(10, 8, -12);\n    scene.add(fillBlue);\n\n    const fillAmber = new THREE.PointLight(0xf59e0b, 0.9, 45);\n    fillAmber.position.set(20, 10, 10);\n    scene.add(fillAmber);\n\n    const grid = new THREE.GridHelper(80, 40, 0x1e293b, 0x0f172a);\n    grid.position.y = -0.05;\n    scene.add(grid);\n\n    const matPrintedBlue = new THREE.MeshStandardMaterial({ color: 0x436186, roughness: 0.5, metalness: 0.1 });\n    const matBedSurface = new THREE.MeshStandardMaterial({ color: 0x334155, roughness: 0.7 });\n    const matBelt = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.85 });\n    const matSteel = new THREE.MeshStandardMaterial({ color: 0xd1d5db, metalness: 0.85, roughness: 0.2 });\n    const matCopper = new THREE.MeshStandardMaterial({ color: 0xb45309, metalness: 0.7, roughness: 0.35 });\n    const matMotorBody = new THREE.MeshStandardMaterial({ color: 0x64748b, metalness: 0.7, roughness: 0.3 });\n    const matFlipperBlade = new THREE.MeshStandardMaterial({ color: 0x38bdf8, metalness: 0.2, roughness: 0.3 });\n    const matUpperLever = new THREE.MeshStandardMaterial({ color: 0x0284c7, metalness: 0.4, roughness: 0.3 });\n    const matBridge = new THREE.MeshStandardMaterial({ color: 0x10b981, roughness: 0.35, metalness: 0.15, transparent: true, opacity: 0.95 });\n    const matBinFe = new THREE.MeshStandardMaterial({ color: 0xf59e0b, transparent: true, opacity: 0.45, roughness: 0.2 });\n    const matBinNonFe = new THREE.MeshStandardMaterial({ color: 0x0284c7, transparent: true, opacity: 0.45, roughness: 0.2 });\n\n    const conveyorGroup = new THREE.Group();\n    scene.add(conveyorGroup);\n\n    const CONVEYOR_LEN = 32;\n    const CONVEYOR_WIDTH = 10;\n    const RAIL_HEIGHT = 3.2;\n    const RAIL_THICK = 0.9;\n    const BED_HEIGHT = 1.0;\n\n    const bedGeo = new THREE.BoxGeometry(CONVEYOR_LEN, BED_HEIGHT, CONVEYOR_WIDTH);\n    const bedMesh = new THREE.Mesh(bedGeo, matBedSurface);\n    bedMesh.position.set(0, BED_HEIGHT / 2, 0);\n    bedMesh.receiveShadow = true;\n    conveyorGroup.add(bedMesh);\n\n    const beltGeo = new THREE.BoxGeometry(CONVEYOR_LEN + 0.5, 0.1, CONVEYOR_WIDTH - 0.2);\n    const beltMesh = new THREE.Mesh(beltGeo, matBelt);\n    beltMesh.position.set(0, BED_HEIGHT + 0.05, 0);\n    beltMesh.receiveShadow = true;\n    conveyorGroup.add(beltMesh);\n\n    const railFrontGeo = new THREE.BoxGeometry(CONVEYOR_LEN + 2, RAIL_HEIGHT, RAIL_THICK);\n    const railFront = new THREE.Mesh(railFrontGeo, matPrintedBlue);\n    railFront.position.set(0, RAIL_HEIGHT / 2, - (CONVEYOR_WIDTH / 2 + RAIL_THICK / 2));\n    railFront.castShadow = true;\n    railFront.receiveShadow = true;\n    conveyorGroup.add(railFront);\n\n    const railBack = railFront.clone();\n    railBack.position.z = CONVEYOR_WIDTH / 2 + RAIL_THICK / 2;\n    conveyorGroup.add(railBack);\n\n    for (let sign of [-1, 1]) {\n      const earGeo = new THREE.BoxGeometry(1.6, 1.4, 0.5);\n      const earMesh = new THREE.Mesh(earGeo, matPrintedBlue);\n      earMesh.position.set(0, RAIL_HEIGHT + 0.6, sign * (CONVEYOR_WIDTH / 2 + RAIL_THICK / 2));\n      conveyorGroup.add(earMesh);\n\n      const boltGeo = new THREE.CylinderGeometry(0.2, 0.2, 1.2, 8);\n      const boltMesh = new THREE.Mesh(boltGeo, matSteel);\n      boltMesh.rotation.x = Math.PI / 2;\n      boltMesh.position.copy(earMesh.position);\n      conveyorGroup.add(boltMesh);\n    }\n\n    const rollerGeo = new THREE.CylinderGeometry(1.4, 1.4, CONVEYOR_WIDTH, 24);\n    const leftRoller = new THREE.Mesh(rollerGeo, matSteel);\n    leftRoller.rotation.x = Math.PI / 2;\n    leftRoller.position.set(-CONVEYOR_LEN / 2, BED_HEIGHT / 2, 0);\n    conveyorGroup.add(leftRoller);\n\n    const motorGeo = new THREE.CylinderGeometry(1.8, 1.8, 5.5, 24);\n    const motorMesh = new THREE.Mesh(motorGeo, matMotorBody);\n    motorMesh.rotation.x = Math.PI / 2;\n    motorMesh.position.set(-CONVEYOR_LEN / 2, BED_HEIGHT / 2, - (CONVEYOR_WIDTH / 2 + 3.5));\n    conveyorGroup.add(motorMesh);\n\n    const rightRoller = leftRoller.clone();\n    rightRoller.position.x = CONVEYOR_LEN / 2;\n    conveyorGroup.add(rightRoller);\n\n    // ==========================================\n    // KHUNG GÁ CẢM BIẾN M12 (CỔNG VÒM 3 MIẾNG GHÉP LẠI)\n    // ==========================================\n    const sensorGantry = new THREE.Group();\n    sensorGantry.position.set(2.0, 0, 0);\n    conveyorGroup.add(sensorGantry);\n\n    const GANTRY_HEIGHT = 5.5;\n    const GANTRY_PILLAR_W = 3.5;\n    const GANTRY_THICK = 0.45;\n\n    for (let sign of [-1, 1]) {\n      const pillarGeo = new THREE.BoxGeometry(GANTRY_PILLAR_W, GANTRY_HEIGHT, GANTRY_THICK);\n      const pillarMesh = new THREE.Mesh(pillarGeo, matPrintedBlue);\n      pillarMesh.position.set(0, GANTRY_HEIGHT / 2 + 0.5, sign * (CONVEYOR_WIDTH / 2 + RAIL_THICK + GANTRY_THICK / 2));\n      pillarMesh.castShadow = true;\n      sensorGantry.add(pillarMesh);\n\n      const scrGeo = new THREE.CylinderGeometry(0.18, 0.18, 1.2, 8);\n      const scrMesh = new THREE.Mesh(scrGeo, matSteel);\n      scrMesh.rotation.x = Math.PI / 2;\n      scrMesh.position.set(0, 2.0, sign * (CONVEYOR_WIDTH / 2 + RAIL_THICK));\n      sensorGantry.add(scrMesh);\n    }\n\n    const topBeamGeo = new THREE.BoxGeometry(GANTRY_PILLAR_W, 0.45, CONVEYOR_WIDTH + RAIL_THICK * 2 + 1.8);\n    const topBeam = new THREE.Mesh(topBeamGeo, matBridge);\n    topBeam.position.set(0, GANTRY_HEIGHT + 0.5, 0);\n    topBeam.castShadow = true;\n    sensorGantry.add(topBeam);\n\n    const sensorBodyGeo = new THREE.CylinderGeometry(0.6, 0.6, 4.5, 20);\n    const sensorBody = new THREE.Mesh(sensorBodyGeo, matSteel);\n    sensorBody.position.set(0, GANTRY_HEIGHT - 0.8, 0);\n    sensorGantry.add(sensorBody);\n\n    const nutM12Geo = new THREE.CylinderGeometry(0.9, 0.9, 0.35, 6);\n    const nutTop = new THREE.Mesh(nutM12Geo, matCopper);\n    nutTop.position.set(0, GANTRY_HEIGHT + 0.8, 0);\n    sensorGantry.add(nutTop);\n\n    const nutBottom = new THREE.Mesh(nutM12Geo, matCopper);\n    nutBottom.position.set(0, GANTRY_HEIGHT + 0.2, 0);\n    sensorGantry.add(nutBottom);\n\n    const blueTipGeo = new THREE.CylinderGeometry(0.58, 0.58, 0.6, 20);\n    const blueTipMat = new THREE.MeshStandardMaterial({ color: 0x0284c7, roughness: 0.3 });\n    const blueTipMesh = new THREE.Mesh(blueTipGeo, blueTipMat);\n    blueTipMesh.position.set(0, GANTRY_HEIGHT - 3.2, 0);\n    sensorGantry.add(blueTipMesh);\n\n    const ledGeo = new THREE.SphereGeometry(0.2, 10, 10);\n    const ledMat = new THREE.MeshBasicMaterial({ color: 0x334155 });\n    const ledMesh = new THREE.Mesh(ledGeo, ledMat);\n    ledMesh.position.set(0, GANTRY_HEIGHT + 1.6, 0);\n    sensorGantry.add(ledMesh);\n\n    const cableGeo = new THREE.CylinderGeometry(0.12, 0.12, 1.5, 8);\n    const cableMesh = new THREE.Mesh(cableGeo, matMotorBody);\n    cableMesh.position.set(0, GANTRY_HEIGHT + 2.4, 0);\n    sensorGantry.add(cableMesh);\n\n    const allTextSprites = [];\n    function makeTextSprite(text, color, bgColor) {\n      const canvas = document.createElement('canvas');\n      canvas.width = 280;\n      canvas.height = 70;\n      const ctx = canvas.getContext('2d');\n      ctx.fillStyle = bgColor || 'rgba(15, 23, 42, 0.88)';\n      ctx.roundRect(0, 0, 280, 70, 16);\n      ctx.fill();\n      ctx.strokeStyle = color || '#38bdf8';\n      ctx.lineWidth = 4;\n      ctx.stroke();\n\n      ctx.fillStyle = color || '#ffffff';\n      ctx.font = 'bold 25px system-ui, sans-serif';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText(text, 140, 35);\n\n      const texture = new THREE.CanvasTexture(canvas);\n      const spriteMaterial = new THREE.SpriteMaterial({ map: texture, depthTest: false });\n      const sprite = new THREE.Sprite(spriteMaterial);\n      sprite.scale.set(6.5, 1.7, 1);\n      allTextSprites.push(sprite);\n      return sprite;\n    }\n\n    const labelSensor = makeTextSprite('Cảm Biến LJ12A3 (M12)', '#fbbf24');\n    labelSensor.position.set(2.0, GANTRY_HEIGHT + 3.8, 0);\n    conveyorGroup.add(labelSensor);\n\n    // =========================================================================\n    // BỘ 2 THANH NẮN LÀN ĐỊNH TÂM PHÔI (V-GUIDE CENTERING RAILS)\n    // =========================================================================\n    const guideRailsGroup = new THREE.Group();\n    conveyorGroup.add(guideRailsGroup);\n\n    const matGuideRail = new THREE.MeshStandardMaterial({\n      color: 0x00d2ff,\n      roughness: 0.35,\n      metalness: 0.2\n    });\n\n    for (let sign of [-1, 1]) {\n      // Slanted Funnel Blade (Lùi ra xa cảm biến: từ X = -10.5 đến X = -3.5, cách Sensor gantry 3.5 đơn vị ~35mm!)\n      const funnelShape = new THREE.Shape();\n      funnelShape.moveTo(-10.5, sign * 4.6);\n      funnelShape.lineTo(-4.5, sign * 2.4);\n      funnelShape.lineTo(-3.2, sign * 2.4);\n      funnelShape.lineTo(-3.2, sign * 2.7);\n      funnelShape.lineTo(-4.5, sign * 2.7);\n      funnelShape.lineTo(-10.5, sign * 4.9);\n      funnelShape.closePath();\n\n      const funnelExtrude = new THREE.ExtrudeGeometry(funnelShape, { depth: 1.6, bevelEnabled: false });\n      funnelExtrude.rotateX(-Math.PI / 2);\n      const funnelMesh = new THREE.Mesh(funnelExtrude, matGuideRail);\n      funnelMesh.position.y = 0.8;\n      funnelMesh.castShadow = true;\n      guideRailsGroup.add(funnelMesh);\n\n      // Clamp bracket onto side rail (ở vị trí X = -7.5)\n      const clampArmGeo = new THREE.BoxGeometry(1.6, 0.35, 2.4);\n      const clampArm = new THREE.Mesh(clampArmGeo, matGuideRail);\n      clampArm.position.set(-7.5, 2.0, sign * 3.9);\n      guideRailsGroup.add(clampArm);\n\n      const clampTopGeo = new THREE.BoxGeometry(1.6, 0.35, 1.4);\n      const clampTop = new THREE.Mesh(clampTopGeo, matGuideRail);\n      clampTop.position.set(-7.5, 2.0, sign * (CONVEYOR_WIDTH / 2 + RAIL_THICK / 2));\n      guideRailsGroup.add(clampTop);\n\n      const clampOuterLipGeo = new THREE.BoxGeometry(1.6, 0.9, 0.35);\n      const clampOuterLip = new THREE.Mesh(clampOuterLipGeo, matGuideRail);\n      clampOuterLip.position.set(-7.5, 1.6, sign * (CONVEYOR_WIDTH / 2 + RAIL_THICK + 0.18));\n      guideRailsGroup.add(clampOuterLip);\n\n      const clampBoltGeo = new THREE.CylinderGeometry(0.12, 0.12, 0.6, 8);\n      const clampBolt = new THREE.Mesh(clampBoltGeo, matSteel);\n      clampBolt.rotation.x = Math.PI / 2;\n      clampBolt.position.set(-7.5, 1.6, sign * (CONVEYOR_WIDTH / 2 + RAIL_THICK + 0.35));\n      guideRailsGroup.add(clampBolt);\n    }\n\n    const labelGuide = makeTextSprite('Thanh Nắn Làn (V-Guide)', '#38bdf8');\n    labelGuide.position.set(-7.0, 3.8, 0);\n    conveyorGroup.add(labelGuide);\n\n    // CƠ CẤU GẠT Ở ĐUÔI\n    const DISCHARGE_X = CONVEYOR_LEN / 2;\n    const PIVOT_X = DISCHARGE_X + 1.2;\n    const PIVOT_Z = 0;\n\n    const bridgeAssembly = new THREE.Group();\n    conveyorGroup.add(bridgeAssembly);\n\n    const BRIDGE_Y = RAIL_HEIGHT;\n    const BRIDGE_THICK = 0.6;\n\n    const bridgePlateGeo = new THREE.BoxGeometry(5.0, BRIDGE_THICK, CONVEYOR_WIDTH + RAIL_THICK * 2 + 0.8);\n    const bridgePlate = new THREE.Mesh(bridgePlateGeo, matBridge);\n    bridgePlate.position.set(PIVOT_X, BRIDGE_Y + BRIDGE_THICK / 2, 0);\n    bridgePlate.castShadow = true;\n    bridgePlate.receiveShadow = true;\n    bridgeAssembly.add(bridgePlate);\n\n    for (let sign of [-1, 1]) {\n      const clampGeo = new THREE.BoxGeometry(4.0, 1.6, 0.6);\n      const clampMesh = new THREE.Mesh(clampGeo, matBridge);\n      clampMesh.position.set(PIVOT_X, BRIDGE_Y - 0.5, sign * (CONVEYOR_WIDTH / 2 + RAIL_THICK + 0.2));\n      bridgeAssembly.add(clampMesh);\n\n      const clampBoltGeo = new THREE.CylinderGeometry(0.2, 0.2, 1.2, 8);\n      const clampBolt = new THREE.Mesh(clampBoltGeo, matSteel);\n      clampBolt.rotation.x = Math.PI / 2;\n      clampBolt.position.set(PIVOT_X, BRIDGE_Y - 0.5, sign * (CONVEYOR_WIDTH / 2 + RAIL_THICK + 0.2));\n      bridgeAssembly.add(clampBolt);\n    }\n\n    const flipperGroup = new THREE.Group();\n    flipperGroup.position.set(PIVOT_X, 0, PIVOT_