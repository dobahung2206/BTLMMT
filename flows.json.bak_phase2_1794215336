thái thực tế.</span>\n                </div>\n              </div>\n\n              <!-- 3 Đồng hồ đếm thời gian công nghiệp (Motor Run, Machine Stop, Disconnect) -->\n              <div style=\"margin-top: 10px; padding-top: 8px; border-top: 1px solid var(--border-neutral); display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px; font-family: var(--font-mono); text-align: center;\">\n                <div style=\"background: var(--panel-secondary); padding: 5px 4px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                  <div style=\"font-size: 7.5px; color: var(--text-muted); font-family: var(--font-sans); font-weight: 600;\">CHẠY MOTOR</div>\n                  <div style=\"font-size: 10px; font-weight: 800; color: var(--color-success); margin-top: 2px;\">{{formatHMS(motorRunSeconds)}}</div>\n                </div>\n                <div style=\"background: var(--panel-secondary); padding: 5px 4px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                  <div style=\"font-size: 7.5px; color: var(--text-muted); font-family: var(--font-sans); font-weight: 600;\">DỪNG MÁY</div>\n                  <div style=\"font-size: 10px; font-weight: 800; color: var(--text-secondary); margin-top: 2px;\">{{formatHMS(machineStopSeconds)}}</div>\n                </div>\n                <div style=\"background: var(--panel-secondary); padding: 5px 4px; border-radius: 6px; border: 1px solid var(--border-neutral);\">\n                  <div style=\"font-size: 7.5px; color: var(--text-muted); font-family: var(--font-sans); font-weight: 600;\">MẤT KẾT NỐI</div>\n                  <div style=\"font-size: 10px; font-weight: 800; margin-top: 2px;\" ng-style=\"{'color': modbusOnline ? 'var(--text-muted)' : 'var(--color-danger)'}\">\n                    {{modbusOnline ? '00:00:00' : formatHMS(disconnectSeconds)}}\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- Panel Điều khi