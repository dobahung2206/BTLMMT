===== */\n  md-toolbar,\n  md-toolbar#toolbar,\n  .md-toolbar-tools,\n  #nr-dashboard-toolbar,\n  header.nr-dashboard-toolbar {\n    display: none !important;\n    height: 0px !important;\n    min-height: 0px !important;\n    max-height: 0px !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    border: none !important;\n    overflow: hidden !important;\n    visibility: hidden !important;\n    pointer-events: none !important;\n  }\n\n  html, body, #nr-dashboard, md-content, section.layout-row {\n    height: 100vh !important;\n    max-height: 100vh !important;\n    min-height: 100vh !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    overflow: hidden !important;\n    background: var(--bg-app) !important;\n  }\n\n  .masonry-container,\n  .nr-dashboard-cardpanel,\n  .nr-dashboard-cardcontainer,\n  md-card.nr-dashboard-template,\n  ui-card-panel {\n    height: 100vh !important;\n    max-height: 100vh !important;\n    min-height: 100vh !important;\n    margin: 0 !important;\n    padding: 0 !important;\n    border: none !important;\n    top: 0 !important;\n    left: 0 !important;\n    background: var(--bg-app) !important;\n    box-shadow: none !important;\n  }\n\n  .scada-command-center {\n    width: 100% !important;\n    max-width: 100% !important;\n    height: 100vh !important;\n    max-height: 100vh !important;\n    min-height: 100vh !important;\n    display: flex;\n    flex-direction: column;\n    background: var(--bg-app);\n    overflow: hidden;\n    position: relative;\n    user-select: none;\n    top: 0 !important;\n  }\n\n  /* ============================================================== */\n  /* TOP BAR                                                        */\n  /* ============================================================== */\n  .top-bar {\n    height: 48px;\n    min-height: 48px;\n    max-height: 48px;\n    background: var(--panel-main);\n    border-bottom: 1.5px solid var(--border-neutral);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 16px;\n    flex-shrink: 0;\n    z-index: 50;\n    box-shadow: none; border-bottom: 1px solid var(--border-neutral);\n  }\n\n  .top-bar-left {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .system-logo-badge {\n    width: 28px;\n    height: 28px;\n    border-radius: 6px;\n    background: var(--cyan-primary); color: #0B1422;\n    color: #ffffff;\n    font-weight: 800;\n    font-size: 13px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    box-shadow: none;\n  }\n  .system-title-text {\n    font-size: 13px;\n    font-weight: 800;\n    letter-spacing: 0.5px;\n    color: var(--text-primary);\n    text-transform: uppercase;\n  }\n  .breadcrumb-sep {\n    color: var(--text-muted);\n    font-size: 12px;\n  }\n  .breadcrumb-page {\n    font-size: 12px;\n    font-weight: 700;\n    color: var(--cyan-primary);\n    text-transform: uppercase;\n  }\n\n  .top-bar-right {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n  }\n  .status-pill {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    padding: 4px 10px;\n    border-radius: 20px;\n    font-size: 9.5px;\n    font-weight: 700;\n    font-family: var(--font-mono);\n    white-space: nowrap;\n    transition: all 0.2s ease;\n  }\n  .status-pill.online {\n    background: rgba(49, 214, 160, 0.12);\n    border: 1px solid var(--color-success);\n    color: var(--color-success);\n  }\n  .status-pill.offline {\n    background: rgba(255, 91, 104, 0.12);\n    border: 1px solid var(--color-danger);\n    color: var(--color-danger);\n  }\n  .status-dot-pulse {\n    width: 7px;\n    height: 7px;\n    border-radius: 50%;\n    animation: statusPulse 1.4s infinite ease-in-out;\n  }\n  @keyframes statusPulse {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.4; transform: scale(0.85); }\n  }\n\n  .mode-badge {\n    padding: 3px 8px;\n    border-radius: 4px;\n    font-size: 9.5px;\n    font-weight: 700;\n    font-family: var(--font-mono);\n  }\n  .mode-badge.auto {\n    background: rgba(38, 198, 244, 0.15);\n    border: 1px solid var(--cyan-primary);\n    color: var(--cyan-primary);\n  }\n  .mode-badge.manual {\n    background: rgba(246, 185, 75, 0.15);\n    border: 1px solid var(--color-warning);\n    color: var(--color-warning);\n  }\n\n  .top-timestamp {\n    font-family: var(--font-mono);\n    font-size: 9px;\n    color: var(--text-muted);\n  }\n\n  .btn-estop-header {\n    padding: 6px 14px;\n    border-radius: 6px;\n    background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%);\n    border: 1.5px solid var(--color-danger);\n    color: #ffffff;\n    font-size: 10px;\n    font-weight: 800;\n    letter-spacing: 0.8px;\n    cursor: pointer;\n    box-shadow: none;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    transition: all 0.15s ease-in-out;\n  }\n  .btn-estop-header:hover {\n    box-shadow: 0 0 18px rgba(255, 91, 104, 0.8);\n    transform: translateY(-1px);\n  }\n  .btn-estop-header.tripped {\n    background: #7f1d1d;\n    border-color: #fca5a5;\n    animation: estopFlash 0.7s infinite alternate;\n  }\n  @keyframes estopFlash {\n    0% { box-shadow: 0 0 4px var(--color-danger); }\n    100% { box-shadow: 0 0 22px var(--color-danger); }\n  }\n\n  /* ============================================================== */\n  /* MAIN BODY LAYOUT: SIDEBAR + VIEWPORT                           */\n  /* ============================================================== */\n  .scada-body-layout {\n    flex: 1 1 auto;\n    display: flex;\n    width: 100%;\n    height: calc(100vh - 48px) !important;\n    max-height: calc(100vh - 48px) !important;\n    overflow: hidden;\n  }\n\n  /* SIDEBAR */\n  .scada-sidebar {\n    width: 220px;\n    min-width: 220px;\n    background: var(--sidebar-bg);\n    border-right: 1px solid var(--border-neutral);\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    transition: width 0.25s cubic-bezier(0.16, 1, 0.3, 1), min-width 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n    flex-shrink: 0;\n    z-index: 40;\n  }\n  .scada-sidebar.is-collapsed {\n    width: 60px;\n    min-width: 60px;\n  }\n\n  .sidebar-nav-list {\n    display: flex;\n    flex-direction: column;\n    padding: 10px 8px;\n    gap: 4px;\n    overflow-y: auto;\n  }\n\n  .nav-item-btn {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 10px 14px;\n    border-radius: 6px;\n    background: transparent;\n    border: 1px solid transparent;\n    border-left: 3px solid transparent;\n    color: var(--text-secondary);\n    font-size: 12px;\n    font-weight: 600;\n    cursor: pointer;\n    transition: all 0.18s ease;\n    text-align: left;\n    white-space: nowrap;\n    position: relative;\n  }\n  .nav-item-btn:hover {\n    background: var(--panel-secondary);\n    color: var(--text-primary);\n    border-color: rgba(38, 198, 244, 0.2);\n  }\n  .nav-item-btn.is-active {\n    background: rgba(40, 184, 232, 0.12);\n    border-left: 3px solid var(--cyan-primary);\n    border-color: transparent transparent transparent var(--cyan-primary);\n    color: var(--cyan-primary);\n    font-weight: 700;\n    border-radius: 6px;\n    box-shadow: none;\n  }\n  .nav-item-icon {\n    font-size: 14px;\n    width: 20px;\n    text-align: center;\n    flex-shrink: 0;\n  }\n  .nav-item-label {\n    flex: 1;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .nav-badge-pill {\n    padding: 1px 6px;\n    border-radius: 10px;\n    font-size: 9px;\n    font-weight: 800;\n    font-family: var(--font-mono);\n  }\n  .badge-danger {\n    background: rgba(255, 91, 104, 0.2);\n    color: var(--color-danger);\n    border: 1px solid var(--color-danger);\n  }\n\n  .sidebar-bottom-controls {\n    padding: 8px;\n    border-top: 1px solid var(--border-neutral);\n  }\n  .btn-sidebar-toggle {\n    width: 100%;\n    padding: 8px;\n    border-radius: 6px;\n    background: var(--panel-secondary);\n    border: 1px solid var(--border-neutral);\n    color: var(--text-muted);\n    font-size: 10px;\n    font-weight: 600;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 6px;\n    cursor: pointer;\n    transition: all 0.2s;\n  }\n  .btn-sidebar-toggle:hover {\n    color: var(--cyan-primary);\n    border-color: var(--cyan-primary);\n  }\n\n  /* VIEWPORT CONTAINER */\n  .scada-viewport {\n    flex: 1 1 auto;\n    height: 100%;\n    overflow-y: auto;\n    overflow-x: hidden;\n    background: var(--bg-app);\n    position: relative;\n    padding: 12px 16px;\n  }\n\n  /* ============================================================== */\n  /* COMMON CARDS & TYPOGRAPHY                                      */\n  /* ============================================================== */\n  .card-panel {\n    background: var(--panel-main);\n    border: 1px solid var(--border-neutral);\n    border-radius: var(--card-radius);\n    padding: 14px 16px;\n    box-shadow: var(--shadow-card);\n    position: relative;\n  }\n  .card-panel.elevated {\n    background: var(--panel-secondary);\n    border-color: rgba(38, 198, 244, 0.25);\n  }\n\n  .section-header-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    margin-bottom: 12px;\n    padding-bottom: 6px;\n    border-bottom: 1px solid rgba(29, 48, 72, 0.8);\n  }\n  .section-title {\n    font-size: 11px;\n    font-weight: 800;\n    color: var(--text-primary);\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n  }\n  .section-title-icon {\n    color: var(--cyan-primary);\n    font-size: 13px;\n  }\n\n  /* KPI Cards Grid (Upgraded 2-Row Layout & Proportions) */\n  .kpi-row-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 12px;\n    margin-bottom: 12px;\n  }\n  .kpi-stat-card {\n    background: var(--panel-main);\n    border: 1px solid var(--border-neutral);\n    border-radius: var(--card-radius);\n    padding: 12px 16px;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n    min-height: 86px;\n    min-width: 0;\n    box-shadow: var(--shadow-card);\n    transition: border-color 0.2s ease, transform 0.2s ease;\n    overflow: hidden;\n  }\n  .kpi-stat-card:hover {\n    border-color: var(--cyan-primary);\n    background: var(--panel-main);\n    transform: translateY(-1px);\n    box-shadow: var(--shadow-elevated);\n  }\n  .kpi-card-top {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 8px;\n    width: 100%;\n    min-width: 0;\n  }\n  .kpi-stat-label {\n    font-size: 9.5px;\n    font-weight: 700;\n    color: var(--text-secondary);\n    text-transform: uppercase;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    min-width: 0;\n    flex: 1 1 auto;\n    letter-spacing: 0.3px;\n  }\n  .kpi-sparkline {\n    width: 64px;\n    height: 22px;\n    flex-shrink: 0;\n  }\n  .kpi-card-bottom {\n    display: flex;\n    align-items: flex-end;\n    justify-content: space-between;\n    gap: 8px;\n    width: 100%;\n    margin-top: 6px;\n    min-width: 0;\n  }\n  .kpi-stat-val {\n    font-family: var(--font-mono);\n    display: flex;\n    align-items: baseline;\n    gap: 5px;\n    line-height: 1;\n    min-width: 0;\n  }\n  .kpi-stat-val .kpi-num {\n    font-size: 24px;\n    font-weight: 800;\n    color: #ffffff;\n    font-family: var(--font-mono);\n  }\n  .kpi-stat-unit {\n    font-size: 10px;\n    font-weight: 700;\n    color: var(--cyan-primary);\n    text-transform: uppercase;\n  }\n  .kpi-stat-sub {\n    font-size: 8px;\n    color: var(--text-muted);\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    text-align: right;\n    flex-shrink: 1;\n    min-width: 0;\n  }\n\n  /* Sleek Scrollbars (Single primary vertical scroll in viewport) */\n  .scada-viewport::-webkit-scrollbar,\n  .sidebar-nav-list::-webkit-scrollbar {\n    width: 6px;\n    height: 6px;\n  }\n  .scada-viewport::-webkit-scrollbar-track,\n  .sidebar-nav-list::-webkit-scrollbar-track {\n    background: var(--bg-app);\n  }\n  .scada-viewport::-webkit-scrollbar-thumb,\n  .sidebar-nav-list::-webkit-scrollbar-thumb {\n    background: rgba(38, 198, 244, 0.25);\n    border-radius: 3px;\n  }\n  .scada-viewport::-webkit-scrollbar-thumb:hover,\n  .sidebar-nav-list::-webkit-scrollbar-thumb:hover {\n    background: var(--cyan-primary);\n  }\n\n  /* Responsive Rules across 1920, 1600, 1440, 1366, 1280 */\n  \n  \n  /* ============================================================== */\n  /* BUTTONS & CONTROLS (MODERN INDUSTRIAL)                          */\n  /* ============================================================== */\n  .btn-cmd {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    padding: 8px 14px;\n    border-radius: 6px;\n    font-size: 11px;\n    font-weight: 700;\n    cursor: pointer;\n    border: 1px solid transparent;\n    transition: all 0.18s ease;\n    user-select: none;\n    white-space: nowrap;\n    text-transform: none;\n  }\n  .btn-cmd.primary {\n    background: rgba(40, 184, 232, 0.14);\n    border-color: var(--cyan-primary);\n    color: var(--cyan-primary);\n  }\n  .btn-cmd.primary:hover {\n    background: var(--cyan-primary);\n    color: #091321;\n  }\n  .btn-cmd.success {\n    background: rgba(39, 197, 139, 0.14);\n    border-color: var(--color-success);\n    color: var(--color-success);\n  }\n  .btn-cmd.success:hover {\n    background: var(--color-success);\n    color: #091321;\n  }\n  .btn-cmd.warning {\n    background: rgba(242, 184, 75, 0.14);\n    border-color: var(--color-warning);\n    color: var(--color-warning);\n  }\n  .btn-cmd.warning:hover {\n    background: var(--color-warning);\n    color: #091321;\n  }\n  .btn-cmd.danger {\n    background: rgba(239, 83, 90, 0.14);\n    border-color: var(--color-danger);\n    color: var(--color-danger);\n  }\n  .btn-cmd.danger:hover {\n    background: var(--color-danger);\n    color: #ffffff;\n  }\n  .btn-cmd.disabled {\n    opacity: 0.35 !important;\n    cursor: not-allowed !important;\n    background: var(--panel-elevated) !important;\n    border-color: var(--border-neutral) !important;\n    color: var(--text-muted) !important;\n    box-shadow: none !important;\n  }\n\n  /* Data Table */\n  .scada-table-wrap {\n    width: 100%;\n    overflow-x: auto;\n    border: 1px solid var(--border-neutral);\n    border-radius: 8px;\n    background: var(--panel-main);\n  }\n  .scada-table {\n    width: 100%;\n    border-collapse: collapse;\n    font-size: 10.5px;\n    font-family: var(--font-sans);\n    text-align: left;\n  }\n  .scada-table th {\n    background: var(--panel-secondary);\n    padding: 9px 12px;\n    color: var(--cyan-primary);\n    font-weight: 700;\n    font-family: var(--font-mono);\n    border-bottom: 1px solid var(--border-neutral);\n    white-space: nowrap;\n  }\n  .scada-table td {\n    padding: 8px 12px;\n    border-bottom: 1px solid rgba(30, 45, 68, 0.6);\n    color: var(--text-primary);\n  }\n  .scada-table tr:hover {\n    background: rgba(40, 184, 232, 0.06);\n  }\n\n  /* Toast Notification */\n  .toast-container {\n    position: fixed;\n    bottom: 20px;\n    right: 20px;\n    z-index: 999;\n    pointer-events: none;\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .toast-item {\n    background: var(--panel-elevated);\n    border: 1px solid var(--cyan-primary);\n    color: var(--text-primary);\n    padding: 10px 16px;\n    border-radius: 8px;\n    box-shadow: var(--shadow-elevated);\n    font-size: 11px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    animation: toastPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  }\n  @keyframes toastPop {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  /* Dialog Modal */\n  .scada-dialog-backdrop {\n    position: fixed;\n    top: 0;\n    left: 0;\n    width: 100vw;\n    height: 100vh;\n    background: rgba(9, 19, 33, 0.85);\n    backdrop-filter: blur(4px);\n    z-index: 500;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    animation: fadeIn 0.2s ease-out;\n  }\n  .scada-dialog-box {\n    width: 500px;\n    max-width: 90vw;\n    background: var(--panel-main);\n    border: 1px solid var(--cyan-primary);\n    border-radius: 12px;\n    box-shadow: var(--shadow-elevated);\n    overflow: hidden;\n  }\n  .dialog-top {\n    height: 42px;\n    background: var(--panel-secondary);\n    border-bottom: 1px solid var(--border-neutral);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 0 16px;\n    font-size: 11.5px;\n    font-weight: 700;\n    color: var(--text-primary);\n  }\n  .dialog-body {\n    padding: 16px;\n    font-size: 11px;\n    color: var(--text-secondary);\n    line-height: 1.5;\n  }\n  .dialog-actions {\n    padding: 10px 16px;\n    background: var(--panel-secondary);\n    border-top: 1px solid var(--border-neutral);\n    display: flex;\n    justify-content: flex-end;\n    gap: 10px;\n  }\n\n  /* SVG CONVEYOR VIEWPORT */\n  .conveyor-svg-box {\n    width: 100%;\n    height: 100%;\n    max-height: 380px;\n    user-select: none;\n  }\n\n  \n  /* Subtabs & Filters Styling */\n  .secondary-subtab-bar {\n    display: flex;\n    gap: 8px;\n    margin-bottom: 14px;\n    background: var(--panel-main);\n    padding: 6px 10px;\n    border-radius: 8px;\n    border: 1px solid var(--border-neutral);\n    align-items: center;\n    flex-wrap: wrap;\n  }\n  .subtab-pill {\n    padding: 6px 14px;\n    font-size: 11px;\n    font-weight: 700;\n    border-radius: 6px;\n    border: 1px solid transparent;\n    background: transparent;\n    color: var(--text-secondary);\n    cursor: pointer;\n    display: inline-flex;\n    align-items