        "func": "// Gate kiểm tra tín hiệu Modbus RTU ESP8266 thực tế\nlet isBlocked = flow.get('heartbeat_blocked') || false;\n\n// Nếu là lệnh giả lập rút / cắm cáp từ giao diện\nif (msg.topic === 'simulate_disconnect') {\n    isBlocked = Boolean(msg.payload);\n    flow.set('heartbeat_blocked', isBlocked);\n    let isOnline = !isBlocked;\n    flow.set('modbusOnline', isOnline);\n    return { payload: isOnline, topic: 'heartbeat_status' };\n}\n\n// Nếu là dữ liệu đọc được từ Modbus Read thực tế (Output 1)\nif (msg.topic !== 'heartbeat_check') {\n    flow.set('lastModbusReadTime', Date.now());\n    flow.set('modbusOnline', true);\n    return null; // Không cần spam ui_template mỗi 150ms\n}\n\n// Nếu là nhịp kiểm tra định kỳ 1s từ inject\nif (msg.topic === 'heartbeat_check') {\n    let lastTime = flow.get('lastModbusReadTime') || 0;\n    let now = Date.now();\n    // Coi là Online nếu nhận được gói tin Modbus trong vòng 2.5 giây vừa qua\n    let isOnline = (!isBlocked && (now - lastTime < 2500));\n    flow.set('modbusOnline', isOnline);\n    return { payload: isOnline, topic: 'heartbeat_status' };\n}\n\nreturn null;\n"
